<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lit le journal de performance et imprime ce que le produit en dit. LECTURE SEULE : aucune
       entree n'est ajoutee, sinon l'outil polluerait l'historique qu'il pretend observer. Hors du
       .sln, comme les autres outils, pour ne rien peser sur le build du produit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DrDxt.Measurement\DrDxt.Measurement.csproj" />
  </ItemGroup>

</Project>
