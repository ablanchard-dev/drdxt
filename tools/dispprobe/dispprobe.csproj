<Project Sdk="Microsoft.NET.Sdk">

  <!-- Live smoke for the display seam (Win32DisplayInfo). Lives OUTSIDE the .sln (like
       tools/netprobe, tools/smoke) so it never affects the product build/test. Read-only:
       it enumerates displays and prints what it read. No elevation, no write, nothing
       installed. Must be run from a real desktop session: EnumDisplayDevices returns
       nothing without a window station. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DrDxt.Detection\DrDxt.Detection.csproj" />
  </ItemGroup>

</Project>
