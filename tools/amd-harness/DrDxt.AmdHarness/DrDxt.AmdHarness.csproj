<!-- Portable AMD test-harness console tool. NOT part of DrDXT.sln. -->
<!-- Runs ONE throwaway session on a friend's AMD machine and leaves nothing behind. -->
<!-- Follows the same out-of-sln pattern as tools/smoke. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Out-of-sln tool: TreatWarningsAsErrors inherited from Directory.Build.props -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests need to implement the internal seam interfaces (IServiceInspector etc.) -->
    <InternalsVisibleTo Include="DrDxt.AmdHarness.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\DrDxt.Core\DrDxt.Core.csproj" />
    <ProjectReference Include="..\..\..\src\DrDxt.Application\DrDxt.Application.csproj" />
    <ProjectReference Include="..\..\..\src\DrDxt.Measurement\DrDxt.Measurement.csproj" />
    <!-- Task 3: real AdlxGpuTuningReader lives in DrDxt.Detection -->
    <ProjectReference Include="..\..\..\src\DrDxt.Detection\DrDxt.Detection.csproj" />
    <!-- La validation complète écrit par les leviers du produit (App) et son canal élevé (ElevatedHelper). -->
    <ProjectReference Include="..\..\..\src\DrDxt.App\DrDxt.App.csproj" />
    <ProjectReference Include="..\..\..\src\DrDxt.ElevatedHelper\DrDxt.ElevatedHelper.csproj" />
  </ItemGroup>
</Project>
