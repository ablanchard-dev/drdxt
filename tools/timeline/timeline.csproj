<!-- PREMIERE TRANCHE VERTICALE ROOT-CAUSE. NE FAIT PAS partie de DrDXT.sln. -->
<!-- Une charge GPU REELLE, la telemetrie echantillonnee PENDANT, les deux fusionnees sur une -->
<!-- base de temps commune (QPC), puis une classification prudente des periodes. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>DrDxt.Tools.Timeline</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DrDxt.Detection\DrDxt.Detection.csproj" />
    <ProjectReference Include="..\..\src\DrDxt.GpuNative\DrDxt.GpuNative.csproj" />
    <ProjectReference Include="..\..\src\DrDxt.Application\DrDxt.Application.csproj" />
  </ItemGroup>
</Project>
