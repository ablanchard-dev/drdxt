<!-- Manual LIVE smoke harness for the R2 LEASE WATCHDOG (dead-man's-switch). -->
<!-- NOT part of DrDXT.sln (like tools/m2smoke, tools/r2smoke, tools/r2probe) so it -->
<!-- never affects the product build/test. -->
<!-- -->
<!-- It talks to the RUNNING elevated helper over the signed, allowlisted typed IPC: -->
<!-- applies a small HELD core-clock offset THROUGH the helper, registers a lease whose -->
<!-- revert restores stock (0 MHz), then EXITS WITHOUT renewing/completing — so the -->
<!-- helper's background watchdog must auto-revert the offset when the lease expires. -->
<!-- See SMOKE.md in this folder for the exact launch + run + verify commands. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyName>r2leasesmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DrDxt.Core\DrDxt.Core.csproj" />
    <ProjectReference Include="..\..\src\DrDxt.ElevatedHelper\DrDxt.ElevatedHelper.csproj" />
    <ProjectReference Include="..\..\src\DrDxt.App\DrDxt.App.csproj" />
  </ItemGroup>
</Project>
