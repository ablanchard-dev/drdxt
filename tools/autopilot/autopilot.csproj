<!-- LE PREMIER AUTOPILOTE REEL. NE FAIT PAS partie de DrDXT.sln. -->
<!-- Boucle complete sur la machine : A/A -> candidat -> apply -> read-back -> stabilite -->
<!-- -> A-B-A-B -> verdict avec resolution -> garde ou annule -> revalidation. -->
<!-- ELEVE : l'ecriture NVAPI de l'offset exige l'elevation ; la mesure, non. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>DrDxt.Tools.Autopilot</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DrDxt.Detection\DrDxt.Detection.csproj" />
    <ProjectReference Include="..\..\src\DrDxt.ElevatedHelper\DrDxt.ElevatedHelper.csproj" />
    <ProjectReference Include="..\..\src\DrDxt.Application\DrDxt.Application.csproj" />
  </ItemGroup>
</Project>
