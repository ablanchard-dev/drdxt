# Normalize line endings: store LF in the repo, check out native per-OS.
# Kills the "LF will be replaced by CRLF" noise and keeps diffs stable.
* text=auto

# Source/text files are explicitly text.
*.cs        text
*.csproj    text
*.sln       text
*.props     text
*.targets   text
*.json      text
*.yml       text
*.yaml      text
*.md        text
*.resx      text
*.xaml      text

# Binary assets — never normalize.
*.png       binary
*.jpg       binary
*.ico       binary
*.snk       binary
*.pfx       binary
*.dll       binary
*.exe       binary

# La page du guide BIOS : sa politique de sécurité autorise son script par son empreinte, calculée sur les fins de ligne LF.
# Un checkout Windows en CRLF changerait l empreinte du fichier lu par les tests.
docs/guide-bios/index.html text eol=lf
