<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- La SEULE source de version : l'App, le helper et l'installeur la lisent ici. -->
    <Version>0.9.2</Version>
  </PropertyGroup>
  <!-- Le build livré portait C:\Users\<développeur> dans la DLL et dans chaque
       pile de plantage (PDB livrés). Déterministe en Release : la racine locale devient « /_/ ». -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <!-- Le runtime .NET EMBARQUÉ dans l'installeur (publication self-contained). Une appli
       self-contained ne suit pas les correctifs de sécurité installés sur la machine (Microsoft Learn, « .NET
       application publishing ») : sans épingle, le runtime livré était celui du SDK de la machine de build (10.0.9,
       trois correctifs de retard). À monter à chaque correctif mensuel de .NET 10, puis reconstruire et livrer.
       Seulement en self-contained : les tests tournent sur le runtime installé. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
  </PropertyGroup>
  <!-- Les tests seulement : des centaines de tests qui bloquent un fil tournent en parallèle, et sur une machine à deux
       cœurs (la CI) le pool n'ajoute ses fils qu'au compte-gouttes. Une tâche du pool y attend alors plus que le délai
       qu'un test lui laisse, et le test juge la vitesse de la machine au lieu du code. Le produit garde le pool par défaut. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.MinThreads" Value="64" />
  </ItemGroup>
</Project>
