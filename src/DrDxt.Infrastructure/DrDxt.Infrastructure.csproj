<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Treat the neutral (no-suffix) resx as English so the SDK emits
         a proper fr satellite assembly instead of falling back to English. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrDxt.Core\DrDxt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Ed25519 (NOT in the .NET BCL) for the signed update-package verifier.
         Same tranched lib + version as DrDxt.Reconciler — verify
         path uses the PUBLIC key only; the dev/test PRIVATE seed (UpdateDevKeys) is
         used solely to sign fixtures in tests. -->
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only access to internal canonical-hashing / version-compare helpers (TDD),
         mirroring the DrDxt.Reconciler convention. -->
    <InternalsVisibleTo Include="DrDxt.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK auto-discovers both resx files; we use Update to set metadata
         without adding duplicates. The neutral resx needs no special metadata —
         the SDK infers the embedded resource name from the file path.
         The fr satellite needs the Culture hint so the SDK emits
         fr/DrDxt.Infrastructure.resources.dll instead of folding it into the
         main assembly. -->
    <EmbeddedResource Update="Resources\Strings.fr.resx">
      <Culture>fr</Culture>
    </EmbeddedResource>
  </ItemGroup>

</Project>
