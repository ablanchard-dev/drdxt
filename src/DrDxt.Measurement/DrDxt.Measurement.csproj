<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrDxt.Core\DrDxt.Core.csproj" />
  </ItemGroup>

  <!-- Expose internal interop seam (IPresentMonApi, enums, PM_QUERY_ELEMENT) to the test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DrDxt.Measurement.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" /> <!-- NSubstitute proxies internal interfaces -->
  </ItemGroup>

  <!-- Vendored PresentMon 2.5.1 SDK (MIT) — copied next to the app for P/Invoke. -->
  <ItemGroup>
    <None Include="..\..\third_party\presentmon\PresentMonAPI2.dll" Link="PresentMonAPI2.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\presentmon\PresentMonAPI2Loader.dll" Link="PresentMonAPI2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
