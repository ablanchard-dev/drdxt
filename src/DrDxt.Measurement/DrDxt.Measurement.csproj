<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrDxt.Core\DrDxt.Core.csproj" />
  </ItemGroup>

  <!-- Expose la couture d'interop interne (IPresentMonApi, enums, PM_QUERY_ELEMENT) au projet de test. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DrDxt.Measurement.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" /> <!-- NSubstitute fait des proxys des interfaces internes -->
  </ItemGroup>

  <!-- SDK PresentMon 2.5.1 embarqué (MIT) : copié à côté de l'app pour le P/Invoke. -->
  <ItemGroup>
    <None Include="..\..\third_party\presentmon\PresentMonAPI2.dll" Link="PresentMonAPI2.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\third_party\presentmon\PresentMonAPI2Loader.dll" Link="PresentMonAPI2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
