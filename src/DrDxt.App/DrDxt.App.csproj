<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\drdxt.ico</ApplicationIcon>
    <!-- Mesure du payload, relevée le 18/09/2026 : 13 dossiers de langue, 8,88 Mo, alors que DrDXT ne
         traduit que le francais (Strings.fr.resx) par-dessus le neutre anglais. Les douze
         autres ne portaient que les satellites du framework WPF : les messages internes de
         WPF en tcheque ou en coreen, pour une interface francaise. Sur une machine tcheque,
         nos chaines tombent de toute facon sur le neutre.
         La liste n'est pas un choix de gout : un test la compare aux .resx du depot, donc
         ajouter Strings.de.resx sans l'ajouter ici fait rougir la suite. -->
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <!-- Aucun code injecte au lancement (DOTNET_STARTUP_HOOKS), voir AucunCrochetDeDemarrageTests. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\drdxt.ico" />
    <!-- La commande de la console de réparation, la même que celle du lanceur natif. -->
    <Compile Include="..\DrDxt.Lanceur\EnvironnementPropre.cs" Link="Platform\EnvironnementPropre.cs" />
    <Resource Include="Assets\logo-marque.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Effets\ChromeLiquide.ps" />
    <Resource Include="Effets\BilleLiquide.ps" />
    <Resource Include="Effets\ChromeSouple.ps" />
    <Resource Include="Assets\studio-chrome.png" />
    <None Include="Effets\BilleLiquide.hlsl" />
    <None Include="Effets\ChromeLiquide.hlsl" />
    <None Include="Assets\Fonts\OFL-Unbounded.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- La GPL-3.0 (§4) accompagne chaque copie livrée. L'installeur copie publish\*. -->
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <!-- « Quoi de neuf » lit le CHANGELOG de la version installée, dans le binaire signé. -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <EmbeddedResource Include="..\..\CHANGELOG.en.md" LogicalName="CHANGELOG.en.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Accès réservé aux tests au signataire et au vérificateur internes, qui refusent au moindre doute (tests de garde des clés). -->
    <InternalsVisibleTo Include="DrDxt.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Le QR du guide BIOS, lu au téléphone pendant que le PC est dans le BIOS. MIT. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- WMI : état de la Restauration du système et vérification des points de restauration (WmiRestorePointService). -->
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrDxt.Application\DrDxt.Application.csproj" />
    <!-- Le conseiller du docteur BIOS (IBiosAdvisor), affiché dans le scan, guidage seul. -->
    <ProjectReference Include="..\DrDxt.Bios\DrDxt.Bios.csproj" />
    <ProjectReference Include="..\DrDxt.Core\DrDxt.Core.csproj" />
    <ProjectReference Include="..\DrDxt.Detection\DrDxt.Detection.csproj" />
    <!-- La frontière native ADLX vérifiée (IAdlxNative/AdlxNative). L'App branche dessus le vrai
         AdlxGpuTuningReader ; référence explicite (et pas seulement transitive via Detection) pour
         que la dépendance soit déclarée là où elle sert. -->
    <ProjectReference Include="..\DrDxt.GpuNative\DrDxt.GpuNative.csproj" />
    <!-- Le vrai IElevatedClient en IPC signé (il parle au helper élevé).
         L'App lance cet exe du helper à la demande (HelperLauncher) : l'apphost du helper et
         ses fichiers d'exécution doivent donc être posés à côté de l'exe de l'App. Le SDK copie
         l'apphost d'un projet Exe référencé dans la sortie du projet qui le référence ; la cible
         CopyHelperHostToOutput ci-dessous en fait une règle imposée (la compilation échoue si
         l'exe du helper manque) plutôt qu'un comportement implicite du SDK. -->
    <ProjectReference Include="..\DrDxt.ElevatedHelper\DrDxt.ElevatedHelper.csproj" />
    <ProjectReference Include="..\DrDxt.Infrastructure\DrDxt.Infrastructure.csproj" />
    <ProjectReference Include="..\DrDxt.Measurement\DrDxt.Measurement.csproj" />
    <!-- Profils d'optimisation par puce (IProfileMatcher et le catalogue sourcé). -->
    <ProjectReference Include="..\DrDxt.Profiles\DrDxt.Profiles.csproj" />
    <!-- Le reconciler (surface d'état et de contrôle) : contrats purs et sondes de prod. -->
    <ProjectReference Include="..\DrDxt.Reconciler\DrDxt.Reconciler.csproj" />
    <ProjectReference Include="..\DrDxt.Reconciler.Adapters\DrDxt.Reconciler.Adapters.csproj" />
  </ItemGroup>

  <!-- Impose que l'apphost du helper élevé soit posé à côté de l'exe de l'App. L'App lance
       « $(OutDir)DrDxt.ElevatedHelper.exe » à l'exécution (ElevatedClientFactory /
       HelperLauncher) ; s'il manque, la compilation échoue bruyamment au lieu de livrer une
       App qui ne peut pas s'élever. -->
  <Target Name="VerifyHelperHostInOutput" AfterTargets="Build;Publish">
    <Error Condition="!Exists('$(OutDir)DrDxt.ElevatedHelper.exe')"
           Text="DrDxt.ElevatedHelper.exe was not copied to the App output ($(OutDir)). The App cannot launch the elevated helper without it." />
  </Target>

</Project>
