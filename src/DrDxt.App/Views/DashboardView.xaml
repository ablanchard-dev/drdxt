<UserControl x:Class="DrDxt.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrDxt.App.ViewModels"
             xmlns:conv="clr-namespace:DrDxt.App.Converters"
             xmlns:effets="clr-namespace:DrDxt.App.Effets"
             Background="{StaticResource ObsidienneBrush}"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1320">

    <UserControl.Resources>
        <!-- Convertisseurs : graphiques faits main, sans bibliothèque. -->
        <conv:KeyToLocalizedStringConverter x:Key="Loc"/>
        <conv:IconKeyToGeometryConverter x:Key="Icon"/>
        <conv:CountToVisibilityConverter x:Key="CountVis"/>
        <conv:FrameSeriesToPointsConverter x:Key="FramePoints"/>
        <conv:ValueToBarHeightConverter x:Key="BarHeight"/>
        <conv:LatencyToBulletWidthConverter x:Key="BulletWidth"/>
        <conv:NumberDisplayConverter x:Key="Num"/>
        <conv:HeadlineKeyToBrushConverter x:Key="HeadlineBrush"/>
        <conv:HeadlineKeyToIconConverter x:Key="HeadlineIcon"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <!-- La flèche avant → après, dessinée, jamais un caractère. -->
        <Style x:Key="FlecheAvantApres" TargetType="Path">
            <Setter Property="Data" Value="M0 5 H14 M10 1 L14 5 L10 9"/>
            <Setter Property="Stroke" Value="{StaticResource TexteDiscretBrush}"/>
            <Setter Property="StrokeThickness" Value="1.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Width" Value="15"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="10,0,10,9"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>

        <Style x:Key="ValeurAvant" TargetType="TextBlock" BasedOn="{StaticResource Mesure}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource TexteDiscretBrush}"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ValeurApres" TargetType="TextBlock" BasedOn="{StaticResource Mesure}">
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource IrisCyanBrush}"/>
        </Style>

        <!-- Même poids, sans le cyan des gains. 23/09/2026 : « GPU occupé » montait en cyan comme
             FPS et latence ; plus de GPU occupé dit où la machine est limitée, pas qu'elle a gagné. -->
        <Style x:Key="ValeurApresNeutre" TargetType="TextBlock" BasedOn="{StaticResource ValeurApres}">
            <Setter Property="Foreground" Value="{StaticResource TexteBrush}"/>
        </Style>

        <Style x:Key="Unite" TargetType="TextBlock" BasedOn="{StaticResource Legende}">
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Height="12" VerticalAlignment="Top" Margin="0,0,14,0" Panel.ZIndex="1"
                   Fill="{StaticResource FonduHautBrush}" IsHitTestVisible="False"/>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ════════════ LE BANDEAU ════════════ -->
                <Grid MinHeight="300">
                    <effets:ChampDeChrome Amplitude="0.28" Frequence="2.6" Irisation="0" Vitesse="0.14"
                                          Luminosite="0.55" EchelleDeRendu="0.6" Decalage="7"/>
                    <Border Background="{StaticResource VoileLectureBrush}"/>
                    <Border Height="140" VerticalAlignment="Bottom" Background="{StaticResource FonduVersObsidienneBrush}"/>

                    <Grid Margin="52,40,52,34">
                        <StackPanel HorizontalAlignment="Left" MaxWidth="760" effets:Revelation.Active="True">
                            <TextBlock Text="{Binding SubtitleKey, Converter={StaticResource Loc}}" Style="{StaticResource Discret}"/>
                            <TextBlock Text="{Binding HeadlineKey, Converter={StaticResource Loc}}" Style="{StaticResource TitreMarque}" Margin="0,14,0,0"/>
                            <TextBlock Text="{Binding VerdictKey, Converter={StaticResource Loc}}" Style="{StaticResource Discret}" FontSize="15" LineHeight="23" Margin="0,12,0,0"/>
                            <!-- 29/09/2026 : un gain annoncé dit quand le 1 % low n'a pas pu conclure. -->
                            <TextBlock Text="{Binding NoteDuGain}" Style="{StaticResource Discret}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding NoteDuGain, Converter={StaticResource StrVis}}"/>
                            <!-- L'écart mesuré ET ce que la session pouvait résoudre : « pas de gain mesurable »
                                 ne veut pas dire que le changement n'a rien fait. -->
                            <TextBlock Text="{Binding ResolutionNote}" Style="{StaticResource Discret}" Margin="0,8,0,0"
                                       Visibility="{Binding ResolutionNote, Converter={StaticResource StrVis}}"/>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Style="{StaticResource BoutonReflet}" Command="{Binding BackToScanCommand}"
                                    Content="{Binding BackToScanActionKey, Converter={StaticResource Loc}}" HorizontalAlignment="Right"/>
                            <!-- Le badge : couleur, icône ET mot. 29/09/2026 : sans capsule ni contour ; sous le bouton
                                 de retour, sa capsule le faisait lire comme un deuxième bouton (critique de l'app). -->
                            <Border HorizontalAlignment="Right" Margin="0,18,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource GlyphIcon}"
                                          Data="{Binding HeadlineKey, Converter={StaticResource HeadlineIcon}, ConverterParameter=icon}"
                                          Stroke="{Binding HeadlineKey, Converter={StaticResource HeadlineBrush}}"
                                          Width="15" Height="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BadgeTextKey, Converter={StaticResource Loc}}"
                                               Foreground="{Binding HeadlineKey, Converter={StaticResource HeadlineBrush}}"
                                               FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel Margin="52,0,52,48">

                    <!-- ───── LES QUATRE MESURES ───── -->
                    <Border Style="{StaticResource Dalle}" Padding="30,22" effets:Revelation.Active="True" effets:Revelation.Retard="80">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 29/09/2026 : chaque case porte sa phrase pour un lecteur d'écran (nom, avant, après). -->
                            <StackPanel Grid.Column="0" AutomationProperties.Name="{Binding LectureFps}">
                                <TextBlock Text="{Binding AvgFpsLabelKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding AvgFpsBefore, Converter={StaticResource Num}}" Style="{StaticResource ValeurAvant}"/>
                                    <Path Style="{StaticResource FlecheAvantApres}"/>
                                    <TextBlock Text="{Binding AvgFpsAfter, Converter={StaticResource Num}}" Style="{StaticResource ValeurApres}"/>
                                </StackPanel>
                                <!-- 23/09/2026 : le chiffre voyage avec sa marge (principe n°2 du produit). -->
                                <TextBlock Text="{Binding MargeFpsTexte}" Style="{StaticResource Legende}" Margin="0,6,0,0"
                                           Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Fill="{StaticResource FiletBrush}"/>

                            <StackPanel Grid.Column="2" Margin="26,0,0,0" AutomationProperties.Name="{Binding LectureLow}">
                                <TextBlock Text="{Binding P1LowLabelKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding P1LowBefore, Converter={StaticResource Num}}" Style="{StaticResource ValeurAvant}"/>
                                    <Path Style="{StaticResource FlecheAvantApres}"/>
                                    <TextBlock Text="{Binding P1LowAfter, Converter={StaticResource Num}}" Style="{StaticResource ValeurApres}"/>
                                </StackPanel>
                                <!-- 27/09/2026 : le 1 % low voyage aussi avec sa marge, la sienne. -->
                                <TextBlock Text="{Binding MargeLowTexte}" Style="{StaticResource Legende}" Margin="0,6,0,0"
                                           Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>

                            <Rectangle Grid.Column="3" Fill="{StaticResource FiletBrush}"/>

                            <StackPanel Grid.Column="4" Margin="26,0,0,0" AutomationProperties.Name="{Binding LectureLatence}">
                                <TextBlock Text="{Binding LatencyLabelKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding EstimatedPcLatencyBeforeMs, Converter={StaticResource Num}, ConverterParameter=0.#}" Style="{StaticResource ValeurAvant}"/>
                                    <Path Style="{StaticResource FlecheAvantApres}"/>
                                    <TextBlock Text="{Binding EstimatedPcLatencyAfterMs, Converter={StaticResource Num}, ConverterParameter=0.#}" Style="{StaticResource ValeurApres}"/>
                                    <TextBlock Text="{Binding Source=dashboard.unit.ms, Converter={StaticResource Loc}}" Style="{StaticResource Unite}"/>
                                </StackPanel>
                            </StackPanel>

                            <Rectangle Grid.Column="5" Fill="{StaticResource FiletBrush}"/>

                            <StackPanel Grid.Column="6" Margin="26,0,0,0" AutomationProperties.Name="{Binding LectureGpu}">
                                <TextBlock Text="{Binding GpuBusyLabelKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}"/>
                                <TextBlock Text="{Binding GpuNonMesureTexte}" Style="{StaticResource Legende}" Margin="0,14,0,0"
                                           Visibility="{Binding GpuNonMesureTexte, Converter={StaticResource StrVis}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                            Visibility="{Binding GpuBusyMesure, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding GpuBusyPercentBefore, Converter={StaticResource Num}, ConverterParameter=0.#}" Style="{StaticResource ValeurAvant}"/>
                                    <Path Style="{StaticResource FlecheAvantApres}"/>
                                    <TextBlock Text="{Binding GpuBusyPercentAfter, Converter={StaticResource Num}, ConverterParameter=0.#}" Style="{StaticResource ValeurApresNeutre}"/>
                                    <TextBlock Text="{Binding Source=dashboard.unit.percent, Converter={StaticResource Loc}}" Style="{StaticResource Unite}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ───── LE TEMPS PAR IMAGE ───── -->
                    <Border Style="{StaticResource Dalle}" Padding="28,22" Margin="0,16,0,0" effets:Revelation.Active="True" effets:Revelation.Retard="170">
                        <StackPanel>
                            <Grid>
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding FrametimeChartTitleKey, Converter={StaticResource Loc}}" Style="{StaticResource TitreSection}"/>
                                    <TextBlock Text="{Binding FrametimeChartCaptionKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- Légende : trait plein (avant) contre pointillé irisé (après), jamais la couleur seule. -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Line X1="0" Y1="7" X2="24" Y2="7" Stroke="{StaticResource TexteDiscretBrush}" StrokeThickness="2.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SeriesBeforeKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}" Margin="8,0,20,0" VerticalAlignment="Center"/>
                                    <Line X1="0" Y1="7" X2="24" Y2="7" Stroke="{StaticResource IrisBrush}" StrokeThickness="2.5" StrokeDashArray="3 2" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SeriesAfterKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}"
                                               Foreground="{StaticResource IrisCyanBrush}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,18,0,0" Height="190" CornerRadius="12" Background="{StaticResource ObsidienneBrush}"
                                    BorderThickness="1" BorderBrush="{StaticResource FiletBrush}" ClipToBounds="True"
                                    AutomationProperties.Name="{Binding LectureGraphique}">
                                <Grid>
                                    <Rectangle Height="1" Fill="{StaticResource FiletBrush}" VerticalAlignment="Center"/>
                                    <Rectangle Height="1" Fill="{StaticResource FiletBrush}" VerticalAlignment="Top" Margin="0,47,0,0"/>
                                    <Rectangle Height="1" Fill="{StaticResource FiletBrush}" VerticalAlignment="Bottom" Margin="0,0,0,47"/>
                                    <!-- 23/09/2026 : l'échelle écrite. Le tracé commence à 14 px du haut et finit à 14 px du bas. -->
                                    <TextBlock Text="{Binding EchelleHautTexte}" Style="{StaticResource Legende}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,10,0"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text="{Binding EchelleBasTexte}" Style="{StaticResource Legende}" FontSize="12"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,2"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <!-- Une seule échelle pour les deux courbes : le plan de 1052 x 136 est agrandi d'un bloc. -->
                                    <Viewbox Stretch="Fill" Margin="16,14">
                                        <!-- 29/09/2026 (B7) : les courbes se tracent à chaque nouvelle mesure. -->
                                        <Canvas Width="1052" Height="136" effets:TraceDesCourbes.Declencheur="{Binding AfterFrameTimes}">
                                            <Polyline Stroke="{StaticResource TexteDiscretBrush}" StrokeThickness="2" StrokeLineJoin="Round">
                                                <Polyline.Points>
                                                    <MultiBinding Converter="{StaticResource FramePoints}" ConverterParameter="1052,136">
                                                        <Binding Path="BeforeFrameTimes"/>
                                                        <Binding Path="BeforeFrameTimes"/>
                                                        <Binding Path="AfterFrameTimes"/>
                                                    </MultiBinding>
                                                </Polyline.Points>
                                            </Polyline>
                                            <Polyline StrokeThickness="2.6" StrokeDashArray="4 2.5" StrokeLineJoin="Round">
                                                <Polyline.Stroke>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="{StaticResource IrisCyanColor}" Offset="0"/>
                                                        <GradientStop Color="{StaticResource CyanGlaceColor}" Offset="0.55"/>
                                                        <GradientStop Color="{StaticResource CyanProfondColor}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Polyline.Stroke>
                                                <Polyline.Points>
                                                    <MultiBinding Converter="{StaticResource FramePoints}" ConverterParameter="1052,136">
                                                        <Binding Path="AfterFrameTimes"/>
                                                        <Binding Path="BeforeFrameTimes"/>
                                                        <Binding Path="AfterFrameTimes"/>
                                                    </MultiBinding>
                                                </Polyline.Points>
                                            </Polyline>
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ───── LES CREUX ET LA LATENCE ───── -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Dalle}" Padding="28,22" effets:Revelation.Active="True" effets:Revelation.Retard="260">
                            <StackPanel>
                                <TextBlock Text="{Binding LowsTitleKey, Converter={StaticResource Loc}}" Style="{StaticResource TitreSection}"/>
                                <Grid Margin="0,22,0,0" Height="190">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding P1LowBefore, Converter={StaticResource Num}}" Style="{StaticResource Legende}"
                                                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <Rectangle Width="38" RadiusX="8" RadiusY="8" Fill="{StaticResource FiletClairBrush}" effets:Croissance.Active="True" effets:Croissance.Retard="420">
                                                    <Rectangle.Height>
                                                        <MultiBinding Converter="{StaticResource BarHeight}" ConverterParameter="120">
                                                            <Binding Path="P1LowBefore"/>
                                                            <Binding Path="P1LowBefore"/>
                                                            <Binding Path="P1LowAfter"/>
                                                            <Binding Path="P01LowBefore"/>
                                                            <Binding Path="P01LowAfter"/>
                                                        </MultiBinding>
                                                    </Rectangle.Height>
                                                </Rectangle>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding P1LowAfter, Converter={StaticResource Num}}" Style="{StaticResource Corps}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource IrisCyanBrush}" Typography.NumeralAlignment="Tabular"
                                                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <Rectangle Width="38" RadiusX="8" RadiusY="8" Fill="{StaticResource IrisBrush}" effets:Croissance.Active="True" effets:Croissance.Retard="500">
                                                    <Rectangle.Height>
                                                        <MultiBinding Converter="{StaticResource BarHeight}" ConverterParameter="120">
                                                            <Binding Path="P1LowAfter"/>
                                                            <Binding Path="P1LowBefore"/>
                                                            <Binding Path="P1LowAfter"/>
                                                            <Binding Path="P01LowBefore"/>
                                                            <Binding Path="P01LowAfter"/>
                                                        </MultiBinding>
                                                    </Rectangle.Height>
                                                </Rectangle>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding P1LowLabelKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}"
                                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <!-- 28/09/2026 : même ligne que sous le 0,1 % low ; sans elle, les deux paires de barres n'avaient plus la même base. -->
                                        <TextBlock Text="{Binding MargeLowTexte}" Style="{StaticResource Legende}" HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                            <StackPanel VerticalAlignment="Bottom" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding P01LowBefore, Converter={StaticResource Num}}" Style="{StaticResource Legende}"
                                                           Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <Rectangle Width="38" RadiusX="8" RadiusY="8" Fill="{StaticResource FiletClairBrush}" effets:Croissance.Active="True" effets:Croissance.Retard="560">
                                                    <Rectangle.Height>
                                                        <MultiBinding Converter="{StaticResource BarHeight}" ConverterParameter="120">
                                                            <Binding Path="P01LowBefore"/>
                                                            <Binding Path="P1LowBefore"/>
                                                            <Binding Path="P1LowAfter"/>
                                                            <Binding Path="P01LowBefore"/>
                                                            <Binding Path="P01LowAfter"/>
                                                        </MultiBinding>
                                                    </Rectangle.Height>
                                                </Rectangle>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Bottom">
                                                <TextBlock Text="{Binding P01LowAfter, Converter={StaticResource Num}}" Style="{StaticResource Corps}" FontWeight="SemiBold"
                                                           Foreground="{StaticResource IrisCyanBrush}" Typography.NumeralAlignment="Tabular"
                                                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                                <Rectangle Width="38" RadiusX="8" RadiusY="8" Fill="{StaticResource IrisBrush}" effets:Croissance.Active="True" effets:Croissance.Retard="640">
                                                    <Rectangle.Height>
                                                        <MultiBinding Converter="{StaticResource BarHeight}" ConverterParameter="120">
                                                            <Binding Path="P01LowAfter"/>
                                                            <Binding Path="P1LowBefore"/>
                                                            <Binding Path="P1LowAfter"/>
                                                            <Binding Path="P01LowBefore"/>
                                                            <Binding Path="P01LowAfter"/>
                                                        </MultiBinding>
                                                    </Rectangle.Height>
                                                </Rectangle>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Source=metric.p01_low, Converter={StaticResource Loc}}" Style="{StaticResource Legende}"
                                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                        <!-- 28/09/2026 : le 0,1 % low voyage avec sa marge, la sienne. -->
                                        <TextBlock Text="{Binding MargeLow01Texte}" Style="{StaticResource Legende}" HorizontalAlignment="Center"
                                                   Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Dalle}" Padding="28,22" effets:Revelation.Active="True" effets:Revelation.Retard="350">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding LatencyTitleKey, Converter={StaticResource Loc}}" Style="{StaticResource TitreSection}" VerticalAlignment="Center"/>
                                    <!-- La latence est estimée : l'étiquette le dit à côté du titre. -->
                                    <Border CornerRadius="10" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center" Background="{StaticResource EtatRegarderDouxBrush}">
                                        <TextBlock Text="{Binding LatencyLabelKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatRegarderBrush}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="{Binding SeriesBeforeKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}" Margin="0,26,0,0"/>
                                <Grid Margin="0,6,0,0">
                                    <Border Height="12" CornerRadius="6" Background="{StaticResource ObsidienneBrush}"/>
                                    <Border Height="12" CornerRadius="6" HorizontalAlignment="Left" Background="{StaticResource FiletClairBrush}" effets:Croissance.Active="True" effets:Croissance.Horizontale="True" effets:Croissance.Retard="560">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource BulletWidth}" ConverterParameter="320">
                                                <Binding Path="EstimatedPcLatencyBeforeMs"/>
                                                <Binding Path="EstimatedPcLatencyBeforeMs"/>
                                                <Binding Path="EstimatedPcLatencyAfterMs"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding EstimatedPcLatencyBeforeMs, Converter={StaticResource Num}, ConverterParameter=0.#}" Style="{StaticResource Mesure}" FontSize="18"
                                               FontWeight="Normal" Foreground="{StaticResource TexteSecondaireBrush}"/>
                                    <TextBlock Text="{Binding Source=dashboard.unit.ms, Converter={StaticResource Loc}}" Style="{StaticResource Unite}" Margin="4,0,0,3"/>
                                </StackPanel>

                                <TextBlock Text="{Binding SeriesAfterKey, Converter={StaticResource Loc}}" Style="{StaticResource Legende}"
                                           Foreground="{StaticResource IrisCyanBrush}" FontWeight="SemiBold" Margin="0,18,0,0"/>
                                <Grid Margin="0,6,0,0">
                                    <Border Height="12" CornerRadius="6" Background="{StaticResource ObsidienneBrush}"/>
                                    <Border Height="12" CornerRadius="6" HorizontalAlignment="Left" Background="{StaticResource IrisBrush}" effets:Croissance.Active="True" effets:Croissance.Horizontale="True" effets:Croissance.Retard="660">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource BulletWidth}" ConverterParameter="320">
                                                <Binding Path="EstimatedPcLatencyAfterMs"/>
                                                <Binding Path="EstimatedPcLatencyBeforeMs"/>
                                                <Binding Path="EstimatedPcLatencyAfterMs"/>
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding EstimatedPcLatencyAfterMs, Converter={StaticResource Num}, ConverterParameter=0.#}" Style="{StaticResource Mesure}" FontSize="18"
                                               Foreground="{StaticResource IrisCyanBrush}"/>
                                    <TextBlock Text="{Binding Source=dashboard.unit.ms, Converter={StaticResource Loc}}" Style="{StaticResource Unite}" Margin="4,0,0,3"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ───── CE QUI A CHANGÉ ───── -->
                    <Grid Margin="0,32,0,0">
                        <TextBlock Text="{Binding ChangesTitleKey, Converter={StaticResource Loc}}" Style="{StaticResource TitreMarque}" FontSize="22" LineHeight="28" VerticalAlignment="Center"/>
                        <!-- ToolTipService.ShowOnDisabled : sans lui, WPF cache l'infobulle
                             exactement quand elle sert — sur le bouton desactive. -->
                        <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Right" Command="{Binding RevertCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="{Binding RevertHintKey, Converter={StaticResource Loc}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Clock, Converter={StaticResource Icon}}"
                                      Stroke="{StaticResource TexteBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RevertAllActionKey, Converter={StaticResource Loc}}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Un retour en arrière qui a échoué se montre, il ne se tait pas. -->
                    <TextBlock Text="{Binding RevertErrorMessage}" Style="{StaticResource Donnee}" Foreground="{StaticResource EtatCorrigerBrush}" Margin="0,10,0,0"
                               Visibility="{Binding RevertErrorMessage, Converter={StaticResource StrVis}}"/>

                    <Border Style="{StaticResource Dalle}" Padding="28,20" Margin="0,16,0,0" effets:Revelation.Active="True" effets:Revelation.Retard="440">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Check, Converter={StaticResource Icon}}"
                                      Stroke="{StaticResource EtatRienBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ChangesAppliedTitleKey, Converter={StaticResource Loc}}" Style="{StaticResource TitreSection}" FontSize="13"
                                           Foreground="{StaticResource EtatRienBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ChangesNoneKey, Converter={StaticResource Loc}}" Style="{StaticResource Discret}" Margin="0,12,0,0"
                                       Visibility="{Binding AppliedChanges.Count, Converter={StaticResource CountVis}, ConverterParameter=invert}"/>

                            <ItemsControl ItemsSource="{Binding AppliedChanges}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource FiletBrush}" Padding="0,14">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TitleKey, Converter={StaticResource Loc}}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SummaryKey, Converter={StaticResource Loc}}" Style="{StaticResource Discret}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,18,0,0" Visibility="{Binding RevertedChanges.Count, Converter={StaticResource CountVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Warning, Converter={StaticResource Icon}}"
                                          Stroke="{StaticResource EtatRegarderBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ChangesRevertedTitleKey, Converter={StaticResource Loc}}" Style="{StaticResource TitreSection}" FontSize="13"
                                               Foreground="{StaticResource EtatRegarderBrush}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding RevertedChanges}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource FiletBrush}" Padding="0,14">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TitleKey, Converter={StaticResource Loc}}" Style="{StaticResource Corps}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TexteSecondaireBrush}"/>
                                                    <TextBlock Text="{Binding SummaryKey, Converter={StaticResource Loc}}" Style="{StaticResource Discret}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════ PIED ════════════ -->
        <Border Grid.Row="1" Background="{StaticResource ObsidienneBrush}" BorderBrush="{StaticResource FiletBrush}"
                BorderThickness="0,1,0,0" Padding="52,10">
            <Grid>
                <TextBlock Text="{Binding LabelFooterVersion}" Style="{StaticResource Legende}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=ShieldCheck, Converter={StaticResource Icon}}"
                          Stroke="{StaticResource EtatRienBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Source=UI.Trust.Local, Converter={StaticResource Loc}}" Style="{StaticResource Legende}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
