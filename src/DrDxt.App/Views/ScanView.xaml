                    <!-- ───── TON PASSAGE DANS LE BIOS ───── -->
                    <StackPanel Margin="0,30,0,0" Visibility="{Binding HasBiosLoopResult, Converter={StaticResource BoolVis}}" effets:Revelation.Active="True" effets:Revelation.Retard="220">
