                                                        </Grid>
                                                        <TextBlock Text="{Binding ErreurPlafondEnvoi}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                                                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding ErreurPlafondEnvoi, Converter={StaticResource StrVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Agir, windows (24/09/2026) : rendre l'écran de récupération. Seulement si l'audit a lu
                                                     l'élément ; le maintien est la confirmation ; l'annulation reste à côté du fait. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
