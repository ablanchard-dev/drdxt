                                                                </Border>
                                                                <TextBlock Text="{Binding ResultatTestMemoire}" Style="{StaticResource Corps}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                                <Button Content="{Binding LabelTestMemoireRelancer}" Style="{StaticResource Lien}" Margin="0,8,0,0"
                                                                        HorizontalAlignment="Left" Command="{Binding LancerTestMemoireCommand}"/>
