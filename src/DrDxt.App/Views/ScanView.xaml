                                                                   Visibility="{Binding IsChecked, ElementName=PourquoiPing, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding LabelPingIndisponible}" Style="{StaticResource Discret}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding PlafondEnvoiIndisponible, Converter={StaticResource BoolVis}}"/>
                                                        <TextBlock Text="{Binding TextePlafondEnvoi}" Style="{StaticResource Discret}" Margin="0,10,0,0" TextWrapping="Wrap"
