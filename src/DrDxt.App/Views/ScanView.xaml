<UserControl x:Class="DrDxt.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrDxt.App.ViewModels"
             xmlns:conv="clr-namespace:DrDxt.App.Converters"
             xmlns:effets="clr-namespace:DrDxt.App.Effets"
             Background="{StaticResource ObsidienneBrush}"
             d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1320">

    <UserControl.Resources>
        <conv:SeverityColorConverter x:Key="SeverityColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
        <conv:ScanStateToVisibilityConverter x:Key="StateVis"/>
        <conv:IconKeyToGeometryConverter x:Key="Icon"/>

        <!-- La pastille d'état d'un domaine : une couleur, toujours doublée de son mot. -->
        <!-- Le chip d'état : fond neutre, liseré teinté, point teinté, libellé sur le texte courant.
             `TextElement.Foreground` ne porte pas le libellé mais le point ; le libellé, lui, fixe
             sa couleur, donc le contraste du mot ne dépend plus de la teinte de l'état. -->
        <!-- L'état est un nœud du réseau : un point lumineux dans son halo, et le mot à côté. Ni capsule, ni contour,
             ni liseré teinté : ce serait le feu tricolore d'un gabarit tout fait. L'étiquette est la même pour tous
             les états ; seul le point porte la couleur. Aucune animation : il reste affiché pendant le jeu. -->
        <Style x:Key="PastilleEtat" TargetType="Border">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource EtatNonLuBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatDomaine.ACorriger}">
                    <Setter Property="TextElement.Foreground" Value="{StaticResource EtatCorrigerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatDomaine.ARegarder}">
                    <Setter Property="TextElement.Foreground" Value="{StaticResource EtatRegarderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatDomaine.RienDeSignale}">
                    <Setter Property="TextElement.Foreground" Value="{StaticResource EtatRienBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Le contenu du chip : le point prend la teinte héritée, le mot garde le contraste du texte. -->
        <!-- Un seul signe pour « pourquoi ? » partout (mesures, constats, lectures
             impossibles, processeur bridé) : un « ? » rond, gris au repos, cyan au survol et ouvert. Son nom complet reste
             pour le lecteur d'écran et l'infobulle. -->
        <Style x:Key="BoutonPourquoi" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusIris}"/>
            <Setter Property="ToolTip" Value="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Rond" Width="20" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource TexteSecondaireBrush}" Background="Transparent">
                            <TextBlock x:Name="Signe" Text="?" FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TexteSecondaireBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rond" Property="BorderBrush" Value="{StaticResource IrisCyanBrush}"/>
                                <Setter TargetName="Signe" Property="Foreground" Value="{StaticResource IrisCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rond" Property="BorderBrush" Value="{StaticResource IrisCyanBrush}"/>
                                <Setter TargetName="Signe" Property="Foreground" Value="{StaticResource IrisCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ContenuEtat">
            <StackPanel Orientation="Horizontal">
                <!-- La perle brillante (reflet blanc, halo flou) faisait daté. Un point plat de la
                     couleur de l'état, cerclé d'un liseré chrome fin : net, et toujours dans la matière. -->
                <Grid Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse x:Name="Perle" Width="8" Height="8"
                             Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                    <Ellipse Width="10" Height="10" Stroke="{StaticResource LisereChromeBrush}" StrokeThickness="0.9"/>
                </Grid>
                <TextBlock Text="{Binding EtatLibelle}" FontFamily="{StaticResource UiFont}" FontSize="12"
                           FontWeight="Medium" Foreground="{StaticResource TexteBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- Une ligne « Pas pu lire ». La température du processeur tenait quatre lignes de prose d'un
             bloc ; comme un constat, la première phrase reste et la suite s'ouvre sous « Pourquoi ? ». -->
        <DataTemplate x:Key="LigneNonLue" DataType="{x:Type vm:EntreeCarte}">
            <StackPanel Margin="0,0,0,12">
                <!-- Le « ? » au bout de la ligne qu'il explique, partout. -->
                <DockPanel LastChildFill="True">
                    <ToggleButton x:Name="PourquoiNonLu" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}" DockPanel.Dock="Right" Margin="10,1,0,0" VerticalAlignment="Top" Visibility="{Binding ADetailSuite, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Titre}" Style="{StaticResource Corps}" Foreground="{StaticResource TexteSecondaireBrush}"/>
                </DockPanel>
                <TextBlock Text="{Binding DetailCourt}" Style="{StaticResource Legende}" Margin="0,3,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource StrVis}}"/>
                <TextBlock Text="{Binding DetailSuite}" Style="{StaticResource Legende}" Margin="0,3,0,0"
                           Visibility="{Binding IsChecked, ElementName=PourquoiNonLu, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Une ligne de la carte : partagée par « Constaté » et « Réglages proposés ». -->
        <DataTemplate x:Key="LigneDeCarte" DataType="{x:Type vm:EntreeCarte}">
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource FiletBrush}" Padding="0,14,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"
                             Fill="{Binding Converter={StaticResource SeverityColor}}"/>

                    <StackPanel Grid.Column="1">
                        <!-- Le « ? » au bout de la ligne qu'il explique, partout. -->
                        <DockPanel LastChildFill="True">
                            <ToggleButton x:Name="Pourquoi" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}" DockPanel.Dock="Right" Margin="10,1,0,0" VerticalAlignment="Top" Visibility="{Binding ADetailSuite, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding Titre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <!-- La première phrase, puis la suite derrière « Pourquoi ? » ; un constat mémoire
                             faisait dix lignes d'un bloc. -->
                        <TextBlock Text="{Binding DetailCourt}" Style="{StaticResource Discret}" Margin="0,5,0,0"
                                   Visibility="{Binding Detail, Converter={StaticResource StrVis}}"/>
                        <!-- Le remède se lit sans clic, liseré cyan, avant « Pourquoi ? ». -->
                        <Border BorderThickness="2,0,0,0" BorderBrush="{StaticResource IrisCyanBrush}" Padding="10,2,0,2" Margin="0,8,0,0"
                                Visibility="{Binding ACommentCorriger, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.LabelCommentCorriger, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           Style="{StaticResource Discret}" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding RemedeLisible}" Style="{StaticResource Corps}" TextWrapping="Wrap"
                                           Visibility="{Binding ARemede, Converter={StaticResource BoolVis}}"/>
                                <!-- Ce que DrDXT fait lui-même de ces étapes : un bouton par geste, « Annuler » une fois fait. -->
                                <ItemsControl ItemsSource="{Binding Gestes}" Margin="0,4,0,0"
                                              Visibility="{Binding AGestes, Converter={StaticResource BoolVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:GesteDuDocteur}">
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="{Binding Titre}" Command="{Binding FaireCommand}" Cursor="Hand"
                                                            Visibility="{Binding PeutFaire, Converter={StaticResource BoolVis}}"
                                                            Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                                            FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{StaticResource IrisCyanDouxBrush}" CornerRadius="9" Padding="10,3"><ContentPresenter/></Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Border CornerRadius="10" Padding="10,3" BorderThickness="1" VerticalAlignment="Center"
                                                            Background="{StaticResource EtatRienDouxBrush}" BorderBrush="{StaticResource EtatRienFiletBrush}"
                                                            Visibility="{Binding Fait, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="{Binding DataContext.LabelGesteFait, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   Style="{StaticResource Legende}" Foreground="{StaticResource EtatRienBrush}"/>
                                                    </Border>
                                                    <Button Content="{Binding DataContext.LabelGesteAnnuler, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Command="{Binding AnnulerCommand}" Cursor="Hand" Margin="12,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding PeutAnnuler, Converter={StaticResource BoolVis}}"
                                                            Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                                            FontFamily="{StaticResource UiFont}" FontSize="12.5">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DataContext.LabelGesteEchec, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Style="{StaticResource Legende}" Foreground="{StaticResource EtatRegarderBrush}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                           Visibility="{Binding AEchoue, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Les commandes en police de code, une par ligne, sélectionnables. -->
                                <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,4" Margin="0,8,0,0"
                                        Background="{StaticResource ObsidienneBrush}" BorderThickness="1" BorderBrush="{StaticResource FiletClairBrush}"
                                        Visibility="{Binding ACommande, Converter={StaticResource BoolVis}}">
                                    <!-- Une commande coupée au milieu ressemblait à deux commandes cassées ;
                                         chacune tient sur sa ligne et défile si elle déborde. -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding CommandeACopier}" Style="{StaticResource Donnee}" TextWrapping="NoWrap"/>
                                    </ScrollViewer>
                                </Border>
                                <!-- La commande se copie, DrDXT ne l'exécute pas. -->
                                <Button Content="{Binding DataContext.LabelCopierCommande, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Command="{Binding DataContext.CopierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding CommandeACopier}" HorizontalAlignment="Left" Margin="0,8,0,0" Cursor="Hand"
                                        Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                        FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                                        Visibility="{Binding ACommande, Converter={StaticResource BoolVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- La commande se lance à la main : DrDXT ne sait pas la défaire. -->
                                <StackPanel Visibility="{Binding ACommande, Converter={StaticResource BoolVis}}">
                                    <DockPanel Margin="0,8,0,0" LastChildFill="True">
                                        <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Warning, Converter={StaticResource Icon}}"
                                              Stroke="{StaticResource EtatRegarderBrush}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding DataContext.LabelCadreALaMain, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Legende}" Margin="7,0,0,0" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding DetailSuite}" Style="{StaticResource Discret}" Margin="0,4,0,0"
                                   Visibility="{Binding IsChecked, ElementName=Pourquoi, Converter={StaticResource BoolVis}}"/>
                        <Border HorizontalAlignment="Left" CornerRadius="9" Padding="8,2" Margin="0,8,0,0"
                                Background="{StaticResource IrisCyanDouxBrush}"
                                Visibility="{Binding ActionAAfficher, Converter={StaticResource StrVis}}">
                            <TextBlock Text="{Binding ActionAAfficher}" Style="{StaticResource Legende}" Foreground="{StaticResource IrisCyanBrush}"/>
                        </Border>
                        <!-- La valeur lue, telle quelle : « non lisible » compris. Sauf si la phrase au-dessus la dit déjà. -->
                        <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,4" Margin="0,8,0,0"
                                Background="{StaticResource ObsidienneBrush}" BorderThickness="1" BorderBrush="{StaticResource FiletClairBrush}"
                                Visibility="{Binding ValeurAAfficher, Converter={StaticResource StrVis}}">
                            <TextBlock Text="{Binding ValeurAAfficher}" Style="{StaticResource Donnee}" FontFamily="{StaticResource UiFont}" FontSize="12.5"/>
                        </Border>
                        <!-- La réserve d'un réglage proposé se lit comme une phrase, pas comme une valeur lue. -->
                        <TextBlock Text="{Binding ReserveDeValidation}" Style="{StaticResource Discret}" FontStyle="Italic" Margin="0,8,0,0"
                                   Visibility="{Binding ReserveDeValidation, Converter={StaticResource StrVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Le rail des domaines : chaque domaine est un pôle du réseau qu'on sélectionne. -->
        <Style x:Key="RailDomaines" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Grid>
                            <!-- Le fil qui relie les pôles. -->
                            <Border Width="1" HorizontalAlignment="Left" Margin="27,24,0,24" Background="{StaticResource FiletClairBrush}"/>
                            <!-- Une seule capsule, qui glisse jusqu'à la ligne choisie (effets:CapsuleGlissante). -->
                            <Border x:Name="Glisseur" CornerRadius="14" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Background="{StaticResource ObsidienneReleveeBrush}" BorderBrush="{StaticResource LisereChromeBrush}"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ItemsPresenter/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusIris}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Case" CornerRadius="14" Padding="12,10" BorderThickness="1"
                                            Background="Transparent" BorderBrush="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Case" Property="Background" Value="{StaticResource ObsidienneHauteBrush}"/>
                                        </Trigger>
                                        <!-- La ligne choisie ne s'allume plus elle-même : la capsule du rail glisse sous elle. -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Case" Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Un choix de scène passe à la ligne plutôt que d'être coupé. -->
        <DataTemplate x:Key="LibelleDeScene">
            <TextBlock Text="{Binding Libelle}" TextWrapping="Wrap" TextAlignment="Center"/>
        </DataTemplate>

        <!-- Le métal s'agite pendant le scan. -->
        <!-- Ce qui est
             facultatif ou de l'ordre du détail se replie derrière un lien, sur place ; rien n'est retiré. -->
        <Style x:Key="Depliant" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource IrisCyanBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusIris}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,2">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                      Margin="8,1,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform x:Name="Rotation" Angle="0"/></Path.RenderTransform>
                                </Path>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Un seul dépliant sur la page : chaque Expander prend le lien cyan et son chevron (Depliant), au lieu du rond
             blanc et du pointillé de Windows ; le lien est le seul arrêt du clavier, son nom est celui de l'Expander. -->
        <Style TargetType="Expander">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource Depliant}" Content="{TemplateBinding Header}"
                                          AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <ContentPresenter x:Name="Contenu" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Contenu" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- « Éteint · surveiller mon ping » était un bouton pilule qui écrivait son état
             dans son texte. Un vrai interrupteur : la piste et son curseur à gauche, le mot d'état, puis ce que ça fait. -->
        <Style x:Key="Bascule" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TexteBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusIris}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="40" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Piste" CornerRadius="11" Background="#1FFFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1"/>
                                <Ellipse x:Name="Curseur" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left" Fill="#FF9A9A9A"/>
                            </Grid>
                            <TextBlock x:Name="Etat" MinWidth="50" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="#FF9A9A9A"
                                       Text="{Binding DataContext.LabelBasculeEteint, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Curseur" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Curseur" Property="Fill" Value="#FF0B0C10"/>
                                <Setter TargetName="Piste" Property="Background" Value="#FFE8E8E8"/>
                                <Setter TargetName="Piste" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="Etat" Property="Foreground" Value="#FFE8E8E8"/>
                                <Setter TargetName="Etat" Property="Text" Value="{Binding DataContext.LabelBasculeAllume, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Piste" Property="BorderBrush" Value="#B3FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChampSelonEtat" TargetType="effets:ChampDeChrome">
            <Setter Property="Vitesse" Value="0.16"/>
            <Setter Property="Luminosite" Value="0.9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="Vitesse" Value="0.55"/>
                    <Setter Property="Luminosite" Value="0.92"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Height="12" VerticalAlignment="Top" Margin="0,0,14,0" Panel.ZIndex="1"
                   Fill="{StaticResource FonduHautBrush}" IsHitTestVisible="False"/>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ════════════ LE CHAMP : chrome liquide, texte à gauche, réseau à droite ════════════ -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <!-- Au repos le champ occupe tout l'écran ; après le scan il laisse monter le résultat. -->
                            <Setter Property="MinHeight" Value="560"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Idle">
                                    <Setter Property="MinHeight" Value="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Scanning">
                                    <Setter Property="MinHeight" Value="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- Le fond reste le chrome liquide de DrDXT. La parallaxe (B6) est retirée : le décor
                         glissait à l'inverse de la souris, par à-coups. Le bouton s'en distingue par sa forme : un cerveau de neurones. -->
                    <!-- Le mouvement fluide d'origine, en noir et argent : plus aucune irisation. -->
                    <!-- Calculé à pleine résolution, plus à 60 % agrandi. -->
                    <effets:ChampDeChrome x:Name="FondChrome" Style="{StaticResource ChampSelonEtat}" Amplitude="0.3" Frequence="3"
                                          Irisation="0" EchelleDeRendu="1" Teinte="#FF40444B"/>
                    <Border Background="{StaticResource VoileLectureBrush}"/>
                    <Border Height="220" VerticalAlignment="Bottom" Background="{StaticResource FonduVersObsidienneBrush}"/>

                    <Grid Margin="52,48,32,36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.92*"/>
                            <ColumnDefinition Width="1.08*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ───── TEXTE ───── -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <!-- Pendant le scan, on ne change plus la scène : elle est lue. -->
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Avant le scan -->
                            <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Idle,Scanning'}">
                                <TextBlock Style="{StaticResource TitreMarque}" FontSize="38" LineHeight="46">
                                    <Run Text="{Binding LabelIdleHeadlineLead, Mode=OneWay}" Foreground="{StaticResource TexteBrush}"/>
                                    <Run Text="{Binding LabelIdleHeadlineAccent, Mode=OneWay}" Foreground="{StaticResource ChromeTexteBrush}"/>
                                </TextBlock>
                                <!-- La promesse du produit, lue avant le premier scan. Elle n'était
                                     affichée nulle part ; l'ancien sous-titre en disait la moitié. -->
                                <TextBlock Text="{Binding LabelProductPromise}" Style="{StaticResource Discret}" FontSize="15" LineHeight="23"
                                           TextWrapping="Wrap" Margin="0,14,0,0"/>

                                <!-- « Lance un scan » restait écrit pendant le scan (vu sur une photo
                                     de scan réel). L'appel à l'action disparaît dès que le scan tourne. -->
                                <TextBlock Text="{Binding LabelIdleHeroBody}" Margin="0,26,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Corps}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- La consigne de scène se lit avant de lancer : la mesure porte sur ce que tu joues. -->
                                <TextBlock Text="{Binding LabelConsigneScene}" Style="{StaticResource Discret}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding LabelSceneQuestion}" Style="{StaticResource Legende}" Margin="0,18,0,8"/>
                                <ListBox Style="{StaticResource SelecteurSegmente}" ItemsSource="{Binding ChoixDeScene}"
                                         SelectedItem="{Binding SceneDeclaree}" ItemTemplate="{StaticResource LibelleDeScene}"/>
                                <!-- La précision est facultative : repliée, elle n'occupe plus l'écran. -->
                                <ToggleButton x:Name="Preciser" Style="{StaticResource Depliant}" Content="{Binding LabelAjouterPrecision}" Margin="0,14,0,0"/>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=Preciser, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding LabelSceneDescription}" Style="{StaticResource Legende}" Margin="0,8,0,6"/>
                                    <TextBox Text="{Binding DescriptionScene, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                             AutomationProperties.Name="{Binding LabelSceneDescription}"/>
                                </StackPanel>

                                <DockPanel Margin="0,18,0,0" LastChildFill="True">
                                    <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=ShieldCheck, Converter={StaticResource Icon}}"
                                          Stroke="{StaticResource IrisCyanBrush}" Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,0,0" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding LabelTrustLocal}" Style="{StaticResource Legende}" Margin="8,0,0,0" TextWrapping="Wrap"/>
                                </DockPanel>
                                <!-- Windows a coupé ses animations, DrDXT est figé ; un clic l'anime quand même. Pas sous la sphère :
                                     là, elle recouvre les étiquettes du bas de l'orbite. -->
                                <Button Style="{StaticResource BoutonDiscret}" Content="{Binding LabelAnimerMalgreWindows}" Command="{Binding AnimerMalgreWindowsCommand}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Visibility="{Binding AnimationsFigeesParWindows, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>

                            <!-- Après le scan -->
                            <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Done,AlreadyOptimal,Degraded,Failed'}"
                                        effets:Revelation.Active="True">

                                <!-- Un seul titre : le nombre, qui répond à « ma machine va bien ? ». Une ligne de verdict
                                     dessous le redirait en mots. -->
                                <TextBlock effets:Compteur.Texte="{Binding ProblemSummary}" FontFamily="{StaticResource UiDisplayFont}" FontSize="38" LineHeight="44" FontWeight="SemiBold"
                                           Foreground="{StaticResource TexteBrush}" TextWrapping="Wrap"
                                           Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource Discret}" FontSize="15" LineHeight="23" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding DateDuScan}" Style="{StaticResource Legende}" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular"/>
                                <!-- Le docteur dit ce qui vient ensuite quand la liste ne le dit pas déjà : un point à faire soi-même
                                     est le premier de la liste, cliquable vers son domaine. -->
                                <Border x:Name="ProchaineEtape" BorderBrush="{StaticResource IrisCyanBrush}" BorderThickness="2,0,0,0" Padding="14,2,0,2"
                                        Margin="0,18,0,0" HorizontalAlignment="Left" MaxWidth="560"
                                        Visibility="{Binding EtapeHorsListe, Converter={StaticResource StrVis}}">
                                    <TextBlock Text="{Binding EtapeHorsListe}" Style="{StaticResource Corps}" Foreground="{StaticResource TexteBrush}" TextWrapping="Wrap"/>
                                </Border>

                                <!-- « 12 points à corriger » sans liste obligeait à ouvrir les huit domaines. Ce qui
                                     est à corriger, le plus grave d'abord, trois au plus ; un clic ouvre le domaine plus bas. -->
                                <StackPanel Margin="0,22,0,0">
                                    <!-- Seule la liste se cache quand elle est vide : Optimiser, « Plus d'options » et « Prêt à jouer ? »
                                         restent sur une machine sans point à corriger. -->
                                    <StackPanel x:Name="ListeDesPointsAFaire">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PointsAFaire.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- La ligne la plus utile sous le titre était la plus petite. -->
                                    <!-- Une étiquette de section, plus un troisième titre. -->
                                    <TextBlock Text="{Binding LabelAFaire}" Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <!-- Les résultats entrent dans l'ordre de lecture, verdict d'abord. -->
                                    <ItemsControl x:Name="ListeAFaire" ItemsSource="{Binding PointsAFaire}" Focusable="False"
                                                  effets:Revelation.Active="True" effets:Revelation.Retard="160">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PointAFaire}">
                                                <Button Style="{StaticResource Lien}" Margin="0,3"
                                                        Command="{Binding DataContext.ChoisirDomaineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Domaine}"
                                                        AutomationProperties.Name="{Binding Entree.Titre}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- La puce d'un constat a la couleur de sa gravité, comme dans son domaine. -->
                                                        <Ellipse Width="6" Height="6" Fill="{Binding Entree.Gravite, Converter={StaticResource SeverityColor}}" VerticalAlignment="Top" Margin="0,7,0,0"/>
                                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" MaxWidth="520">
                                                            <Run Text="{Binding Entree.Titre, Mode=OneWay}" Foreground="{StaticResource TexteBrush}"/>
                                                            <Run Text="{Binding Domaine.Nom, Mode=OneWay, StringFormat='· {0}'}" Foreground="{StaticResource TexteSecondaireBrush}" FontWeight="Normal"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                    <!-- Optimiser n'était qu'au milieu de la page, sous huit
                                         domaines. La même commande, là où la liste vient de dire quoi faire. -->
                                    <!-- Ce qu'Optimiser essaiera, dit avant le clic. Posé sous la
                                         liste, le bouton laissait croire qu'il la corrigeait ; l'aperçu vient d'abord, séparé
                                         de la liste, et dit que ce sont ses propres réglages. -->
                                    <TextBlock x:Name="ApercuOptimiser" Text="{Binding ApercuOptimisation}" Style="{StaticResource Discret}" TextWrapping="Wrap"
                                               effets:Revelation.Active="True" effets:Revelation.Retard="280"
                                               MaxWidth="540" HorizontalAlignment="Left" Margin="0,26,0,0"
                                               Visibility="{Binding ApercuOptimisation, Converter={StaticResource StrVis}}"/>
                                    <!-- Rien que DrDXT puisse poser seul : une phrase vraie à la place du bouton. -->
                                    <TextBlock Text="{Binding LabelRienAPoserSeul}" Style="{StaticResource Discret}" TextWrapping="Wrap" MaxWidth="540"
                                               HorizontalAlignment="Left" Margin="0,12,0,0"
                                               Visibility="{Binding RienAPoserDuTout, Converter={StaticResource BoolVis}}"/>
                                    <!-- Un souci en cours (arrêt brutal...) se lit avant le clic, en « à regarder ». -->
                                    <TextBlock Text="{Binding AvertissementPoint}" Style="{StaticResource Discret}" TextWrapping="Wrap" Foreground="{StaticResource EtatRegarderBrush}"
                                               MaxWidth="540" HorizontalAlignment="Left" Margin="0,12,0,0"
                                               Visibility="{Binding AvertissementPoint, Converter={StaticResource StrVis}}"/>
                                    <Button x:Name="BoutonOptimiser" Style="{StaticResource CapsuleChrome}" Content="{Binding LabelOptimize}"
                                            effets:Revelation.Active="True" effets:Revelation.Retard="360"
                                            Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ApplyHint}"/>
                                    <!-- Point de restauration puis réglages, jusqu'à ~40 s : le dire. -->
                                    <TextBlock Visibility="{Binding ApplyCommand.IsRunning, Converter={StaticResource BoolVis}}"
                                               Text="{Binding LabelOptimisationEnCours}" Style="{StaticResource Discret}" Margin="0,8,0,0"/>
                                    <!-- Le résultat d'Optimiser et ses refus, sous le bouton ;
                                         ils s'écrivaient ~900 lignes plus bas, sous le pli. -->
                                    <StackPanel Margin="0,10,0,0" MaxWidth="540" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LabelAttenteDuJeuSession}" Style="{StaticResource Discret}" Foreground="{StaticResource IrisCyanBrush}"
                                                   Margin="0,0,0,8" TextWrapping="Wrap" Visibility="{Binding AttenteDuJeuSession, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Text="{Binding ApplyBlockedMessage}" Style="{StaticResource Discret}" TextWrapping="Wrap" Foreground="{StaticResource EtatCorrigerBrush}"
                                                   Margin="0,0,0,8" Visibility="{Binding ApplyBlockedMessage, Converter={StaticResource StrVis}}"/>
                                        <TextBlock Text="{Binding MoatUnarmedMessage}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Visibility="{Binding MoatUnarmedMessage, Converter={StaticResource StrVis}}"/>
                                        <TextBlock Text="{Binding ManifesteIllisibleMessage}" Style="{StaticResource Discret}" TextWrapping="Wrap" Foreground="{StaticResource EtatCorrigerBrush}"
                                                   Margin="0,0,0,8" Visibility="{Binding ManifesteIllisibleMessage, Converter={StaticResource StrVis}}"/>
                                        <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelManifestReset}" HorizontalAlignment="Left"
                                                Command="{Binding RepartirDuManifesteCommand}" Margin="0,0,0,8"
                                                Visibility="{Binding PeutRepartirDuManifeste, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Text="{Binding ResultatOptimisation}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Visibility="{Binding ResultatOptimisation, Converter={StaticResource StrVis}}"/>
                                    </StackPanel>
                                    <!-- « Prêt à jouer ? » juste sous Optimiser : c'est la question qu'on se pose ensuite. -->
                                    <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelPretAJouer}" HorizontalAlignment="Left"
                                            Command="{Binding VerifierPretAJouerCommand}" Margin="0,4,0,0"/>
                                    <ItemsControl ItemsSource="{Binding LignesPretAJouer}" Margin="0,8,0,0" MaxWidth="540" HorizontalAlignment="Left">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Corps}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- « Quoi de neuf » : une fois après une mise à jour de DrDXT, jusqu'à « Vu ». -->
                                    <StackPanel Visibility="{Binding AQuoiDeNeuf, Converter={StaticResource BoolVis}}" MaxWidth="540"
                                                HorizontalAlignment="Left" Margin="0,14,0,0">
                                        <TextBlock Text="{Binding LabelQuoiDeNeuf}" Style="{StaticResource Discret}" Foreground="{StaticResource IrisCyanBrush}"/>
                                        <ItemsControl ItemsSource="{Binding LignesQuoiDeNeuf}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Corps}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelQuoiDeNeufVu}" HorizontalAlignment="Left"
                                                Command="{Binding MarquerQuoiDeNeufVuCommand}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                    <!-- Le reste se replie : ce que DrDXT pose lui-même, l'essai en alternance, ce que tu joues. -->
                                    <ToggleButton x:Name="PlusDOptions" Style="{StaticResource Depliant}" Content="{Binding LabelPlusDOptions}" Margin="0,18,0,0"/>
                                    <StackPanel Visibility="{Binding IsChecked, ElementName=PlusDOptions, Converter={StaticResource BoolVis}}" MaxWidth="540"
                                                HorizontalAlignment="Left" Margin="0,8,0,0">
                                        <!-- La légende du registre passe en info-bulle de sa ligne : une ligne de moins, rien de perdu. -->
                                        <TextBlock Text="{Binding RegisterText}" Style="{StaticResource Discret}" TextWrapping="Wrap"
                                                   Typography.NumeralAlignment="Tabular" ToolTip="{Binding LabelRegisterCaption}"/>
                                        <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelEssaiBouton}" HorizontalAlignment="Left"
                                                Command="{Binding EssayerEnAlternanceCommand}" Margin="0,12,0,4"
                                                Visibility="{Binding EssaiProposable, Converter={StaticResource BoolVis}}"/>
                                        <!-- Chaque bouton dit ce qu'il fait en une ligne. -->
                                        <TextBlock Text="{Binding LabelEssaiExplication}" Style="{StaticResource Legende}" TextWrapping="Wrap"
                                                   Visibility="{Binding EssaiProposable, Converter={StaticResource BoolVis}}"/>
                                        <!-- Pourquoi le réglage de la carte est ouvert ou fermé chez ce joueur : une explication, pas une étape. -->
                                        <StackPanel Visibility="{Binding PhraseReglageCarte, Converter={StaticResource StrVis}}" Margin="0,12,0,0">
                                            <ToggleButton x:Name="PourquoiCarte" Style="{StaticResource Depliant}" Content="{Binding LabelReglageCartePourquoi}"/>
                                            <TextBlock Text="{Binding PhraseReglageCarte}" Style="{StaticResource Discret}" TextWrapping="Wrap"
                                                       Margin="0,6,0,0"
                                                       Visibility="{Binding IsChecked, ElementName=PourquoiCarte, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    <!-- Le choix de scène suit Optimiser ; le bloc du bas et son
                                         second Optimiser sont retirés (un seul appel à l'action). -->
                                    <!-- Ce que tu joues pendant la mesure d'Optimiser. -->
                                    <!-- Déjà répondu avant le scan, le choix se dit en une ligne ; le sélecteur
                                         ne revient que sur « Changer » (critique de l'app : sélecteur en double). -->
                                    <StackPanel Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LabelSceneRetenue}" Style="{StaticResource Discret}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="ChangerScene" Content="{Binding LabelSceneChanger}" Margin="12,0,0,0" Cursor="Hand"
                                                          Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                                          FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsChecked, ElementName=ChangerScene, Converter={StaticResource BoolVis}}">
                                            <ListBox Style="{StaticResource SelecteurSegmente}" ItemsSource="{Binding ChoixDeScene}"
                                                     SelectedItem="{Binding SceneDeclaree}" ItemTemplate="{StaticResource LibelleDeScene}" Margin="0,10,0,0"
                                                     AutomationProperties.Name="{Binding LabelSceneQuestion}"/>
                                            <TextBlock Text="{Binding LabelSceneDescription}" Style="{StaticResource Legende}" Margin="0,12,0,6"/>
                                            <TextBox Text="{Binding DescriptionScene, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                                     AutomationProperties.Name="{Binding LabelSceneDescription}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- ───── LE RÉSEAU ───── -->
                        <!-- Le réseau est dessiné sur 660 x 720 et mis à
                             l'échelle d'un bloc ; la boucle de chrome et les billes des composants sont un vrai rendu Cycles
                             (tools/rendus-3d/boucle.py) calé sur ces mêmes pôles. -->
                        <Viewbox Grid.Column="1" MinHeight="480" Stretch="Uniform">
                        <!-- 760 de large pour huit composants sans chevauchement (660 pour cinq). -->
                        <Grid Width="760" Height="720">
                            <effets:BranchesDeChrome Panel.ZIndex="0" Rapide="{Binding IsScanning}" PolesLus="{Binding PolesLus}"/>
                            <!-- L'onde de balayage et les anneaux
                                 de lecture (ReseauNeuronal) faisaient des cercles ; la lecture d'un domaine éclaire maintenant son icône par
                                 en dessous, dans le shader des tentacules. -->
                            

                            <!-- Tes composants, chacun sur son pôle. Les valeurs passent à la ligne, jamais coupées. -->
                            <!-- Chaque tentacule se branche sur l'icône de son composant,
                                 et l'icône fait toujours face à la bille. Celui du haut a donc son icône en bas, posée sur son pôle. -->
                            <!-- Chaque satellite dit l'état de son domaine (point + mot) et l'ouvre au clic.
                                 Avant le scan, ni état ni clic. -->
                            <ItemsControl Panel.ZIndex="4" ItemsSource="{Binding Satellites}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <effets:PanneauOrbital RayonX="0.37" RayonY="0.35" AngleDepart="-90" CentreIcone="24.5" PortVersCentre="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="Carte" Width="194" MinHeight="88" Cursor="Hand" FocusVisualStyle="{StaticResource FocusIris}"
                                                IsEnabled="{Binding ADomaine}" Command="{Binding DataContext.ChoisirDomaineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Domaine}" AutomationProperties.Name="{Binding Composant.Label}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Padding="14,12" Background="{StaticResource HaloDeLectureBrush}"><ContentPresenter/></Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Path x:Name="Icone" Grid.Row="0" Data="{Binding Composant.IconKey, Converter={StaticResource Icon}}" Width="25" Height="25" Stretch="Uniform"
                                                      Stroke="#FFECECEC" StrokeThickness="1.4" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                                <TextBlock x:Name="Nom" Grid.Row="1" Text="{Binding Composant.Label}" Style="{StaticResource Legende}" FontSize="13.5" Foreground="#FFB4B4B4" TextAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <Border x:Name="Etat" Grid.Row="2" Style="{StaticResource PastilleEtat}" DataContext="{Binding Domaine}" HorizontalAlignment="Center" Margin="0,3,0,0"
                                                        Visibility="{Binding DataContext.ADomaine, ElementName=Carte, Converter={StaticResource BoolVis}}">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContenuEtat}"/>
                                                </Border>
                                                <TextBlock x:Name="Valeur" Grid.Row="3" Text="{Binding Composant.Value}" Style="{StaticResource Corps}" FontSize="13" LineHeight="18"
                                                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                <effets:AncrageArgente x:Name="Ancrage" Grid.Row="4" Width="124" Height="8" Margin="0,8,0,0"/>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <!-- Le composant du haut : le trait, le nom, l'état, la valeur, puis l'icône, tournée vers la bille. -->
                                            <DataTrigger Binding="{Binding (effets:PanneauOrbital.EnHaut), ElementName=Carte}" Value="True">
                                                <Setter TargetName="Ancrage" Property="Grid.Row" Value="0"/>
                                                <Setter TargetName="Ancrage" Property="Margin" Value="0,0,0,8"/>
                                                <Setter TargetName="Nom" Property="Grid.Row" Value="1"/>
                                                <Setter TargetName="Etat" Property="Grid.Row" Value="2"/>
                                                <Setter TargetName="Valeur" Property="Grid.Row" Value="3"/>
                                                <Setter TargetName="Icone" Property="Grid.Row" Value="4"/>
                                                <Setter TargetName="Icone" Property="Margin" Value="0,7,0,0"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>


                            <!-- Le noyau -->
                            <!-- Le bouton est au centre exact du réseau et de son anneau de chrome ; le libellé est posé dessous
                                 sans le pousser (il ne compte pas dans la mise en page). -->
                            <Grid Panel.ZIndex="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Après le scan, « Relancer » avait le poids d'Optimiser.
                                     Le noyau reste le cœur du réseau, réduit : l'action principale est à gauche. -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.72" ScaleY="0.72"/></Setter.Value></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="AlreadyOptimal">
                                                    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.72" ScaleY="0.72"/></Setter.Value></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Degraded">
                                                    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.72" ScaleY="0.72"/></Setter.Value></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <effets:NoyauDeMaintien Width="244" Height="244" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}"
                                                            Occupe="{Binding IsScanning}"
                                                            AutomationProperties.Name="{Binding LabelScanButton}">
<effets:NoyauDeMaintien.Template>
<ControlTemplate TargetType="effets:NoyauDeMaintien">
<Grid>
<effets:BilleDeChrome x:Name="Bille" Margin="0" Rapide="{TemplateBinding Occupe}"/>
<Ellipse Fill="#01000000"/>
<effets:ArcDeProgression Margin="-4" Epaisseur="3" Valeur="{TemplateBinding Progression}" Trait="#FFF0F0F0" Fond="#00FFFFFF" IsHitTestVisible="False"/>
<Ellipse x:Name="AnneauFocus" Margin="0" StrokeThickness="1.5" Stroke="#FFF0F0F0" StrokeDashArray="2 3" Visibility="Collapsed"/>
<Ellipse x:Name="Eclair" Margin="-8" Fill="#30FFFFFF" Opacity="0" IsHitTestVisible="False"/>
</Grid>
<ControlTemplate.Triggers>
<!-- L'anneau en pointillés dit le focus clavier, pas le clic ; la bille s'éclaire au survol, plus au maintien. -->
<MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsMouseOver" Value="False"/></MultiTrigger.Conditions><Setter TargetName="AnneauFocus" Property="Visibility" Value="Visible"/></MultiTrigger>
<Trigger Property="IsMouseOver" Value="True">
<Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite" To="1.18" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
<Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
</Trigger>
<Trigger Property="IsMouseCaptured" Value="True">
<Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite" To="1.45" Duration="0:0:0.7"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
<Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite" To="1" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
</Trigger>
<!-- Le scan fini, la bille jette un éclat franc puis se pose ; c'est le moment dont on se souvient. -->
<DataTrigger Binding="{Binding State}" Value="Done"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite"><EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="2.1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
<DataTrigger Binding="{Binding State}" Value="AlreadyOptimal"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite"><EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="2.1"/><EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
<DataTrigger Binding="{Binding State}" Value="Degraded"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite"><EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="2.1"/><EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False"/><Condition Property="Occupe" Value="False"/></MultiTrigger.Conditions><Setter Property="Opacity" Value="0.5"/></MultiTrigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</effets:NoyauDeMaintien.Template>
</effets:NoyauDeMaintien>
                                    <!-- Ce qui tourne est une courte comète blanche, à l'intérieur ; elle dit
                                         « vivant ». La progression, elle, n'est dite que par l'anneau cyan extérieur : collés et de couleurs
                                         voisines, les deux se lisaient comme un seul anneau presque plein dès l'étape 2. -->
                                    <effets:ArcDeProgression Width="232" Height="232" Epaisseur="3" Tourne="True"
                                                             Trait="#CCFFFFFF" IsHitTestVisible="False"
                                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}"/>
                                    <!-- L'analyse dure plus de 10 s ; l'anneau extérieur avance par étape. -->
                                    <effets:ArcDeProgression Width="264" Height="264" Epaisseur="3" Valeur="{Binding ProgressionDuScan}" Plafond="{Binding PlafondDuScan}" Vitesse="{Binding VitesseDuScan}"
                                                             Trait="#FFF0F0F0" Fond="#33FFFFFF" IsHitTestVisible="False"
                                                             Visibility="{Binding JaugeVisible, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                                <Grid VerticalAlignment="Top">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="250"/></Setter.Value></Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="160"/></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="AlreadyOptimal"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="160"/></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Degraded"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="160"/></Setter.Value></Setter></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center"
                                                Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Idle'}">
                                        <!-- Les voiles passent sous le titre ; une ombre ronde le garde lisible. -->
                                        <Border Background="{StaticResource HaloDeLectureBrush}" Padding="16,8" HorizontalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LabelScanButton}" Style="{StaticResource TitreSection}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding LabelMaintenirPourLancer}" Style="{StaticResource Legende}" Foreground="#FFBEBEBE" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                <effets:AncrageArgente Width="100" Height="8" Margin="0,8,0,0"/>

                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <!-- La boîte opaque coupait les tuyaux du bas ; l'étape est posée sur la même ombre
                                         ronde que « Lancer le scan », les tuyaux passent derrière. -->
                                    <Border HorizontalAlignment="Center" Padding="30,14" Background="{StaticResource HaloDeLectureBrush}"
                                            Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding LabelScanning}" Style="{StaticResource TitreSection}" Foreground="#FFF0F0F0"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LabelEtapeDuScan}" Style="{StaticResource Corps}" FontSize="15" Foreground="{StaticResource TexteBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="240" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <!-- Une consigne à suivre, pas une légende : le voile des étiquettes du graphe la
                                             détache du réseau animé. -->
                                        <Border CornerRadius="10" Padding="10,5" Background="{StaticResource VoileBrush}" MaxWidth="340"
                                                Margin="0,6,0,0" HorizontalAlignment="Center"
                                                Visibility="{Binding AttenteDuJeu, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding LabelAttenteDuJeu}" Style="{StaticResource Corps}" FontSize="12.5"
                                                       TextAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center"
                                                Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Done,AlreadyOptimal,Degraded,Failed'}">
                                        <TextBlock Text="{Binding LabelRescan}" Style="{StaticResource TitreSection}" HorizontalAlignment="Center"/>
                                        <!-- Posée à nu sur le chrome clair du fond, la consigne serait illisible ; une capsule
                                             sombre, comme les libellés des pôles. -->
                                        <Border Background="#B306070A" CornerRadius="9" Padding="10,2" Margin="0,4,0,0" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding LabelMaintenirPourLancer}" Style="{StaticResource Legende}" Foreground="#FFBEBEBE" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                        </Viewbox>
                    </Grid>
                </Grid>

                <!-- ════════════ LE CORPS ════════════ -->
                <StackPanel Margin="52,0,52,48">

                    <!-- Ce qui a bougé depuis le lancement, avant tout scan. -->
                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding ReglagesModifies, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding ReglagesModifies}" Style="{StaticResource Discret}"/>
                    </Border>

                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding MessageDemarrage, Converter={StaticResource StrVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding MessageDemarrage}" Style="{StaticResource Corps}" Foreground="{StaticResource EtatRegarderBrush}" TextWrapping="Wrap"/>
                            <Button Content="{Binding LabelRemiseUsine}" Command="{Binding RemettreLaCarteALUsineCommand}" Style="{StaticResource BoutonReflet}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Visibility="{Binding RemiseUsineProposee, Converter={StaticResource BoolVis}}"/>
                            <Button Content="{Binding LabelRendreEssai}" Command="{Binding RendreEssaiInterrompuCommand}" Style="{StaticResource BoutonReflet}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Visibility="{Binding RenduEssaiPropose, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Failed'}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Warning, Converter={StaticResource Icon}}"
                                  Stroke="{StaticResource EtatRegarderBrush}" Width="18" Height="18" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Corps}" Foreground="{StaticResource EtatRegarderBrush}"
                                       Margin="12,0,0,0" MaxWidth="900"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding GatingNote, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding GatingNote}" Style="{StaticResource Discret}"/>
                    </Border>

                    <!-- ════════════ LA CARTE DE LA MACHINE ════════════ -->
                    <StackPanel x:Name="CarteMachine" Margin="0,0,0,30" Visibility="{Binding ADesDomaines, Converter={StaticResource BoolVis}}"
                                effets:Revelation.Active="True" effets:Revelation.Retard="480">
                        <TextBlock Text="{Binding LabelCarteTitre}" Style="{StaticResource TitreMarque}" FontSize="24" LineHeight="30"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Le rail suit la lecture d'un long domaine (effets:RailCollant). -->
                            <ListBox Grid.Column="0" Style="{StaticResource RailDomaines}" VerticalAlignment="Top" effets:RailCollant.Actif="True" effets:CapsuleGlissante.Actif="True"
                                     ItemsSource="{Binding Domaines}" SelectedItem="{Binding DomaineSelectionne}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DomaineMachine}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{StaticResource ObsidienneBrush}"
                                                    BorderThickness="1" BorderBrush="{StaticResource FiletClairBrush}">
                                                <!-- Acier au repos, cyan pour le domaine choisi. -->
                                                <Path Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="15" Height="15"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource GlyphIcon}">
                                                            <Setter Property="Stroke" Value="{StaticResource TexteSecondaireBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Stroke" Value="{StaticResource IrisCyanBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Nom}" Style="{StaticResource Corps}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="12,0,8,0"/>
                                            <Border Grid.Column="2" Style="{StaticResource PastilleEtat}" VerticalAlignment="Center">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContenuEtat}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Column="2" Style="{StaticResource Dalle}" Padding="30,26" VerticalAlignment="Top">
                                <ContentControl Content="{Binding DomaineSelectionne}" Focusable="False" effets:TransitionDeContenu.Actif="True">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type vm:DomaineMachine}">
                                            <StackPanel effets:Revelation.Active="True">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Nom}" Style="{StaticResource TitreMarque}" FontSize="26" LineHeight="32"/>
                                                        <TextBlock Text="{Binding Composant}" Style="{StaticResource Discret}" Margin="0,6,0,0"
                                                                   Visibility="{Binding AUnComposant, Converter={StaticResource BoolVis}}"/>
                                                        <!-- La phrase qui dit quoi faire, avant les listes. -->
                                                        <TextBlock Text="{Binding Verdict}" Style="{StaticResource Corps}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                                   Visibility="{Binding Verdict, Converter={StaticResource StrVis}}"/>
                                                    </StackPanel>
                                                    <Border Style="{StaticResource PastilleEtat}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContenuEtat}"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding DataContext.LabelCarteVide, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Style="{StaticResource Discret}" Margin="0,22,0,0"
                                                           Visibility="{Binding EstVide, Converter={StaticResource BoolVis}}"/>

                                                <!-- Ce qui bride le processeur en jeu, en clair, hors de « Pourquoi ? ».
                                                     Ni bouton ni conseil : le réglage est dans le BIOS. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="processeur"/>
                                                                        <Condition Binding="{Binding DataContext.ALimiteDePuissance, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelLimiteTitre, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <!-- La première phrase à l'écran, le réglage, le risque et le retour arrière sous « Pourquoi ? ». -->
                                                    <!-- Le « ? » au bout de la ligne qu'il explique, partout. -->
                                                    <DockPanel LastChildFill="True">
                                                        <ToggleButton x:Name="PourquoiBride" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}" DockPanel.Dock="Right" Margin="10,11,0,0" VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding DataContext.LimitePremiereLigne, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource Corps}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding DataContext.LignesLimiteSuite, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,8,0,0"
                                                                  Visibility="{Binding IsChecked, ElementName=PourquoiBride, Converter={StaticResource BoolVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Style="{StaticResource Corps}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Mesuré -->
                                                <StackPanel Margin="0,24,0,0" Visibility="{Binding ADesMesures, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding DataContext.LabelCarteMesures, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <ItemsControl x:Name="ListeMesures" ItemsSource="{Binding MesuresVisibles}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Margin" Value="0,0,0,10"/>
                                                                            <Style.Triggers>
                                                                                <!-- Sous-titre de famille : de l'air avant, peu après. -->
                                                                                <DataTrigger Binding="{Binding EstTitre}" Value="True">
                                                                                    <Setter Property="Margin" Value="0,10,0,6"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="18"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <!-- Sous une ligne lue « pour information », « Pourquoi ? » prenait une ligne entière
                                                                         à chaque fois (six liens cyan identiques sur Processeur) et se lisait avant les valeurs. Un « ? » discret en fin
                                                                         de ligne ouvre la même suite ; son nom complet reste pour le lecteur d'écran et l'infobulle. -->
                                                                    <ToggleButton x:Name="PourquoiMesure" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.Row="0" Grid.Column="2" Margin="10,1,0,0" VerticalAlignment="Top" Visibility="{Binding ASuite, Converter={StaticResource BoolVis}}"/>
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Suite}" Style="{StaticResource Discret}" Margin="0,4,0,0"
                                                                               Visibility="{Binding IsChecked, ElementName=PourquoiMesure, Converter={StaticResource BoolVis}}"/>
                                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource IrisCyanBrush}" VerticalAlignment="Top" Margin="0,8,0,0"
                                                                             HorizontalAlignment="Left">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding EstTitre}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding EstEntete}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <TextBlock Text="{Binding TexteCourt}" ToolTip="{Binding Explication}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Corps}">
                                                                                <Setter Property="Grid.Column" Value="1"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding EstTitre}" Value="True">
                                                                                        <Setter Property="FontFamily" Value="{StaticResource MarqueDemiFont}"/>
                                                                                        <Setter Property="FontSize" Value="13"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource TexteSecondaireBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <!-- En-tête « N états lus » : il annonce toute la liste, donc pleine largeur, sans
                                                                                         puce, en texte courant atténué ; les familles gardent leur titre en retrait. -->
                                                                                    <DataTrigger Binding="{Binding EstEntete}" Value="True">
                                                                                        <Setter Property="Grid.Column" Value="0"/>
                                                                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource TexteSecondaireBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Au-delà de huit lignes, la suite se déplie (le BIOS en faisait dix-neuf). -->
                                                    <StackPanel Visibility="{Binding ADesMesuresRepliees, Converter={StaticResource BoolVis}}">
                                                        <ToggleButton x:Name="VoirMesures" HorizontalAlignment="Left" Cursor="Hand"
                                                                      Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                                                      FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold">
                                                            <ToggleButton.Content>
                                                                <TextBlock>
                                                                    <Run Text="{Binding DataContext.LabelVoirLesAutres, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text="{Binding NombreDeLignesRepliees, Mode=OneWay}"/><Run Text=")"/>
                                                                </TextBlock>
                                                            </ToggleButton.Content>
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ItemsControl ItemsSource="{Binding MesuresRepliees}" ItemTemplate="{Binding ItemTemplate, ElementName=ListeMesures}"
                                                                      Margin="0,10,0,0" Visibility="{Binding IsChecked, ElementName=VoirMesures, Converter={StaticResource BoolVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- Détails techniques : l'information d'expert sans problème ni geste, repliée par défaut, comptée
                                                     dans son titre ; dépliée ou non, gardé d'un lancement à l'autre. -->
                                                <Expander Margin="0,20,0,0" Visibility="{Binding ADesDetails, Converter={StaticResource BoolVis}}"
                                                          IsExpanded="{Binding DataContext.DetailsTechniquesDeplies, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding TitreDesDetails}">
                                                    <Expander.Header>
                                                        <TextBlock Text="{Binding TitreDesDetails}" Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{Binding ItemTemplate, ElementName=ListeMesures}" Margin="0,10,0,0"/>
                                                </Expander>

                                                <!-- Constaté -->
                                                <StackPanel Margin="0,20,0,0" Visibility="{Binding ADesLignes, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding DataContext.LabelCarteConstats, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <ItemsControl ItemsSource="{Binding LignesVisibles}" Margin="0,10,0,0"
                                                                  ItemTemplate="{StaticResource LigneDeCarte}"/>
                                                    <!-- Au-delà de quatre constats, les trois plus graves d'abord, la suite se déplie. -->
                                                    <StackPanel Visibility="{Binding ADesLignesRepliees, Converter={StaticResource BoolVis}}" Margin="0,6,0,0">
                                                        <ToggleButton x:Name="VoirConstats" HorizontalAlignment="Left" Cursor="Hand"
                                                                      Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                                                      FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold">
                                                            <ToggleButton.Content>
                                                                <TextBlock>
                                                                    <Run Text="{Binding DataContext.LabelVoirLesAutres, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text="{Binding LignesRepliees.Count, Mode=OneWay}"/><Run Text=")"/>
                                                                </TextBlock>
                                                            </ToggleButton.Content>
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ItemsControl ItemsSource="{Binding LignesRepliees}" ItemTemplate="{StaticResource LigneDeCarte}"
                                                                      Margin="0,10,0,0" Visibility="{Binding IsChecked, ElementName=VoirConstats, Converter={StaticResource BoolVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Agir, carte graphique : rendre le repos à la carte, prouvé au repos puis en jeu. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="graphique"/>
                                                                        <Condition Binding="{Binding DataContext.ReposCarteVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeCorrection}" VerticalAlignment="Top"
                                                                                Command="{Binding RendreLeReposALaCarteCommand}" Content="{Binding LabelCapsuleReposCarte}" Occupe="{Binding ReposCarteEnCours}"
                                                                                IsEnabled="{Binding ReposCarteAOuvrir}" AutomationProperties.Name="{Binding LabelReposCarteTitre}"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelReposCarteTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelReposCarteDescriptionCourte}" ToolTip="{Binding LabelReposCarteDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding LabelReposCarteMaintenir}" effets:ConsigneAuSurvol.Actif="True" Style="{StaticResource Discret}" Margin="0,10,0,0"
                                                                       Visibility="{Binding ReposCarteAOuvrir, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding LabelReposCarteEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"
                                                                       Margin="0,10,0,0" Visibility="{Binding ReposCarteEnCours, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding LabelReposCarteEnAttente}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}" TextWrapping="Wrap"
                                                                       Margin="0,10,0,0" Visibility="{Binding ReposCarteEnAttente, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding VerdictReposCarte}" Style="{StaticResource Corps}" TextWrapping="Wrap"
                                                                       Margin="0,10,0,0" Visibility="{Binding VerdictReposCarte, Converter={StaticResource StrVis}}"/>
                                                            <TextBlock Text="{Binding ErreurReposCarte}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                                                                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurReposCarte, Converter={StaticResource StrVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Le mode Expert de la carte. Replié, l'accord du joueur d'abord, rien pendant une partie. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="graphique"/>
                                                                        <Condition Binding="{Binding DataContext.ExpertVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Expander DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" IsExpanded="False"
                                                              AutomationProperties.Name="{Binding LabelExpertTitre}">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding LabelExpertTitre}" Style="{StaticResource TitreSection}" FontSize="13"/>
                                                        </Expander.Header>
                                                        <StackPanel Margin="0,12,0,0">
                                                            <CheckBox IsChecked="{Binding ExpertAccord}" IsEnabled="{Binding ExpertPeutPoser}">
                                                                <TextBlock Text="{Binding LabelExpertAccord}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                                                            </CheckBox>
                                                            <DockPanel Margin="0,8,0,0" LastChildFill="True">
                                                                <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=ShieldCheck, Converter={StaticResource Icon}}"
                                                                      Stroke="{StaticResource IrisCyanBrush}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" DockPanel.Dock="Left"/>
                                                                <TextBlock Text="{Binding LabelCadreReversible}" Style="{StaticResource Legende}" Margin="7,0,0,0" TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding LabelExpertDecalage}" Style="{StaticResource Corps}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                                            <Slider Minimum="{Binding ExpertMinMhz}" Maximum="{Binding ExpertMaxMhz}" Value="{Binding ExpertDecalageMhz}"
                                                                    TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25" Margin="0,6,0,0"
                                                                    IsEnabled="{Binding ExpertPeutPoser}" AutomationProperties.Name="{Binding LabelExpertDecalage}"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                                <Button Content="{Binding LabelExpertAppliquer}" Command="{Binding PoserCarteExpertCommand}" Style="{StaticResource BoutonReflet}"
                                                                        IsEnabled="{Binding ExpertPeutPoser}"/>
                                                            </StackPanel>
                                                            <!-- Le ventilateur NVIDIA, vers le haut seulement ; même accord, même « Rendre ». -->
                                                            <StackPanel Visibility="{Binding ExpertVentilateurVisible, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="{Binding LabelExpertVentilateur}" Style="{StaticResource Corps}" FontWeight="SemiBold" Margin="0,18,0,0"/>
                                                                <Slider Minimum="{Binding ExpertVentilateurMin}" Maximum="{Binding ExpertVentilateurMax}" Value="{Binding ExpertVentilateurPct}"
                                                                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Margin="0,6,0,0"
                                                                        IsEnabled="{Binding ExpertPeutPoser}" AutomationProperties.Name="{Binding LabelExpertVentilateur}"/>
                                                                <Button Content="{Binding LabelExpertVentilateurAppliquer}" Command="{Binding PoserVentilateurExpertCommand}" Style="{StaticResource BoutonReflet}"
                                                                        IsEnabled="{Binding ExpertPeutPoser}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                                <Button Content="{Binding LabelExpertRendre}" Command="{Binding RendreCarteExpertCommand}" Style="{StaticResource BoutonReflet}"
                                                                        Margin="12,0,0,0" Visibility="{Binding ExpertGarde, Converter={StaticResource BoolVis}}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ExpertEtat}" Style="{StaticResource Corps}" TextWrapping="Wrap" Margin="0,10,0,0"
                                                                       Visibility="{Binding ExpertEtat, Converter={StaticResource StrVis}}"/>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>

                                                <!-- Agir : remesurer le processeur à la demande, dans son propre domaine. Même gabarit
                                                     que la carte mémoire. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="processeur"/>
                                                                        <Condition Binding="{Binding DataContext.RemesureCpuVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" VerticalAlignment="Top"
                                                                                Command="{Binding RemesurerProcesseurCommand}" Content="{Binding LabelCapsuleRemesureCpu}" Occupe="{Binding RemesureCpuEnCours}"
                                                                                AutomationProperties.Name="{Binding LabelRemesureCpuTitre}"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelRemesureCpuTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelRemesureCpuDescriptionCourte}" ToolTip="{Binding LabelRemesureCpuDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding LabelRemesureCpuMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RemesureCpuEnCours}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RemesureCpuFaite}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding LabelRemesureCpuEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"
                                                                       Margin="0,10,0,0" Visibility="{Binding RemesureCpuEnCours, Converter={StaticResource BoolVis}}"/>
                                                            <Border CornerRadius="10" Padding="10,3" BorderThickness="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                                    Background="{StaticResource EtatRienDouxBrush}" BorderBrush="{StaticResource EtatRienFiletBrush}"
                                                                    Visibility="{Binding RemesureCpuFaite, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="{Binding LabelRemesureCpuFaite}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatRienBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding LabelCpuSauteJeu}" Style="{StaticResource Legende}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding CpuSauteJeu, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding ErreurRemesureCpu}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                                                                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurRemesureCpu, Converter={StaticResource StrVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- Les programmes gourmands passent après le jeu. Coupé par défaut ; contour, pas
                                                         chrome plein : c'est un réglage qu'on allume, pas l'action de l'écran.
                                                         Même grille que « Remesurer » au-dessus, le bouton à gauche, le texte à droite. -->
                                                    <Grid x:Name="GrilleCalmer" Margin="0,20,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="BoutonCalmerVoisins" Content="{Binding LabelCalmerBascule}" Style="{StaticResource Bascule}"
                                                                      VerticalAlignment="Top" IsChecked="{Binding CalmerVoisinsActif, Mode=OneWay}" Command="{Binding BasculerCalmerVoisinsCommand}"
                                                                      AutomationProperties.Name="{Binding LabelCalmerTitre}"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelCalmerTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <DockPanel Margin="0,4,0,0">
                                                                <ToggleButton x:Name="PourquoiCalmer" Style="{StaticResource BoutonPourquoi}" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top"
                                                                              AutomationProperties.Name="{Binding LabelPourquoi}"/>
                                                                <TextBlock Text="{Binding LabelCalmerDescriptionCourte}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding LabelCalmerDescriptionSuite}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding IsChecked, ElementName=PourquoiCalmer, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding VoisinsCalmes}" Style="{StaticResource Discret}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding VoisinsCalmes, Converter={StaticResource StrVis}}"/>
                                                            <!-- Proposé d'office d'après les parties relevées ; la liste d'exclusion du joueur. -->
                                                            <TextBlock Text="{Binding PropositionCalmer}" Margin="0,8,0,0" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding CalmeurPropose}" Value="True">
                                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding LabelExclusTitre}" Style="{StaticResource Legende}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                            <TextBox Text="{Binding VoisinsExclus, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0"
                                                                     AutomationProperties.Name="{Binding LabelExclusTitre}"/>
                                                            <TextBlock Text="{Binding LabelExclusProteges}" Style="{StaticResource Discret}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Agir : le test de refroidissement, sur la page du processeur. Le même
                                                     gabarit que le test mémoire : maintenir pour lancer, la barre, l'arrêt, le verdict ; arrêt de
                                                     sécurité à 99 °C, jamais pendant un jeu. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cle}" Value="processeur">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- L'avancement du test (cinq minutes) passe de l'anneau à une barre sous la capsule. -->
                                                        <StackPanel MinWidth="190" VerticalAlignment="Top">
                                                            <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" Command="{Binding LancerTestRefroidissementCommand}" Content="{Binding LabelCapsuleTestRefroidissement}"
                                                                                    Occupe="{Binding TestRefroidissementEnCours}"
                                                                                    AutomationProperties.Name="{Binding LabelTestRefroidissementTitre}"/>
                                                            <ProgressBar Height="3" Margin="8,8,8,0" Minimum="0" Maximum="1" Value="{Binding ProgressionTestRefroidissement, Mode=OneWay}"
                                                                         Visibility="{Binding TestRefroidissementEnCours, Converter={StaticResource BoolVis}}">
                                                                <ProgressBar.Template>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Grid>
                                                                            <Border x:Name="PART_Track" CornerRadius="1.5" Background="{StaticResource FiletBrush}"/>
                                                                            <Border x:Name="PART_Indicator" CornerRadius="1.5" Background="{StaticResource IrisBrush}" HorizontalAlignment="Left"/>
                                                                        </Grid>
                                                                    </ControlTemplate>
                                                                </ProgressBar.Template>
                                                            </ProgressBar>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelTestRefroidissementTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelTestRefroidissementDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <!-- prêt -->
                                                            <TextBlock Text="{Binding LabelTestRefroidissementMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TestRefroidissementEnCours}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding TestRefroidissementATermine}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- en cours -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                                        Visibility="{Binding TestRefroidissementEnCours, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="{Binding LabelTestRefroidissementEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"/>
                                                                <TextBlock Text="{Binding TempsRestantTestRefroidissement}" Style="{StaticResource Mesure}" Margin="12,0,0,0"/>
                                                                <Button Content="{Binding LabelTestRefroidissementArreter}" Style="{StaticResource Lien}" Margin="18,0,0,0"
                                                                        Command="{Binding ArreterTestRefroidissementCommand}"/>
                                                            </StackPanel>
                                                            <!-- résultat : le mot d'état porte la couleur, jamais la couleur seule -->
                                                            <StackPanel Margin="0,12,0,0" Visibility="{Binding TestRefroidissementATermine, Converter={StaticResource BoolVis}}">
                                                                <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" BorderThickness="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource EtatNonLuDouxBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource EtatNonLuFiletBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding TestRefroidissementEnDefaut}" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource EtatCorrigerDouxBrush}"/>
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource EtatCorrigerFiletBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock>
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Legende}">
                                                                                <Setter Property="Text" Value="observé"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource EtatNonLuBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding TestRefroidissementEnDefaut}" Value="True">
                                                                                        <Setter Property="Text" Value="à corriger"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource EtatCorrigerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Text="{Binding ResultatTestRefroidissement}" Style="{StaticResource Corps}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                                <Button Content="{Binding LabelTestRefroidissementRelancer}" Style="{StaticResource Lien}" Margin="0,8,0,0"
                                                                        HorizontalAlignment="Left" Command="{Binding LancerTestRefroidissementCommand}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Agir : la recherche de sous-tension, sous le
                                                     test de refroidissement dont elle reprend le gabarit ; l'étape en cours au lieu d'une barre, le
                                                     verdict à reporter au BIOS. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <!-- Seulement là où le helper peut poser la tension : ailleurs, le bouton promettrait une recherche impossible. -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="processeur"/>
                                                                        <Condition Binding="{Binding DataContext.SousTensionPossible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- L'avancement du test (cinq minutes) passe de l'anneau à une barre sous la capsule. -->
                                                        <StackPanel MinWidth="190" VerticalAlignment="Top">
                                                            <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" Command="{Binding LancerRechercheSousTensionCommand}" Content="{Binding LabelCapsuleSousTension}"
                                                                                    Occupe="{Binding RechercheSousTensionEnCours}"
                                                                                    AutomationProperties.Name="{Binding LabelSousTensionTitre}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelSousTensionTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelSousTensionDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <!-- Le prérequis se lit avant le lancement : sur un Intel de 12e à 14e génération, le BIOS refuse tant que
                                                                 « UnderVolt Protection » est active. -->
                                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding SousTensionPrerequisVisible, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="{Binding LabelSousTensionPrerequis}" Style="{StaticResource Discret}" TextWrapping="Wrap"/>
                                                                <Button Style="{StaticResource Lien}" Content="{Binding LabelSousTensionGuide}" Command="{Binding OuvrirGuideSousTensionCommand}"
                                                                        HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                            <DockPanel Margin="0,8,0,0" LastChildFill="True">
                                                                <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=ShieldCheck, Converter={StaticResource Icon}}"
                                                                      Stroke="{StaticResource IrisCyanBrush}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" DockPanel.Dock="Left"/>
                                                                <TextBlock Text="{Binding LabelCadreReversible}" Style="{StaticResource Legende}" Margin="7,0,0,0" TextWrapping="Wrap"/>
                                                            </DockPanel>
                                                            <!-- prêt -->
                                                            <TextBlock Text="{Binding LabelSousTensionMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RechercheSousTensionEnCours}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RechercheSousTensionATermine}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- en cours -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                                        Visibility="{Binding RechercheSousTensionEnCours, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="{Binding LabelSousTensionEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"/>
                                                                <TextBlock Text="{Binding EtapeSousTension}" Style="{StaticResource Mesure}" Margin="12,0,0,0"/>
                                                                <Button Content="{Binding LabelSousTensionArreter}" Style="{StaticResource Lien}" Margin="18,0,0,0"
                                                                        Command="{Binding ArreterRechercheSousTensionCommand}"/>
                                                            </StackPanel>
                                                            <!-- résultat : le mot d'état porte la couleur, jamais la couleur seule -->
                                                            <StackPanel Margin="0,12,0,0" Visibility="{Binding RechercheSousTensionATermine, Converter={StaticResource BoolVis}}">
                                                                <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" BorderThickness="1"
                                                                        Background="{StaticResource EtatNonLuDouxBrush}" BorderBrush="{StaticResource EtatNonLuFiletBrush}">
                                                                    <TextBlock Text="{Binding LabelSousTensionEtat}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatNonLuBrush}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding ResultatSousTension}" Style="{StaticResource Corps}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                                <Button Content="{Binding LabelSousTensionRelancer}" Style="{StaticResource Lien}" Margin="0,8,0,0"
                                                                        HorizontalAlignment="Left" Command="{Binding LancerRechercheSousTensionCommand}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Agir : le test mémoire sans redémarrer, dans son propre domaine.
                                                     Le maintien du noyau est la confirmation ; l'anneau dit la durée ; zéro erreur
                                                     s'écrit « observé » en acier, jamais « sain ». -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cle}" Value="memoire">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- L'avancement du test (cinq minutes) passe de l'anneau à une barre sous la capsule. -->
                                                        <StackPanel MinWidth="190" VerticalAlignment="Top">
                                                            <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" Command="{Binding LancerTestMemoireCommand}" Content="{Binding LabelCapsuleTestMemoire}"
                                                                                    Occupe="{Binding TestMemoireEnCours}"
                                                                                    AutomationProperties.Name="{Binding LabelTestMemoireTitre}"/>
                                                            <ProgressBar Height="3" Margin="8,8,8,0" Minimum="0" Maximum="1" Value="{Binding ProgressionTestMemoire, Mode=OneWay}"
                                                                         Visibility="{Binding TestMemoireEnCours, Converter={StaticResource BoolVis}}">
                                                                <ProgressBar.Template>
                                                                    <ControlTemplate TargetType="ProgressBar">
                                                                        <Grid>
                                                                            <Border x:Name="PART_Track" CornerRadius="1.5" Background="{StaticResource FiletBrush}"/>
                                                                            <Border x:Name="PART_Indicator" CornerRadius="1.5" Background="{StaticResource IrisBrush}" HorizontalAlignment="Left"/>
                                                                        </Grid>
                                                                    </ControlTemplate>
                                                                </ProgressBar.Template>
                                                            </ProgressBar>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelTestMemoireTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelTestMemoireDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <!-- prêt -->
                                                            <TextBlock Text="{Binding LabelTestMemoireMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding TestMemoireEnCours}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding TestMemoireATermine}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- en cours -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                                        Visibility="{Binding TestMemoireEnCours, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="{Binding LabelTestMemoireEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"/>
                                                                <TextBlock Text="{Binding TempsRestantTestMemoire}" Style="{StaticResource Mesure}" Margin="12,0,0,0"/>
                                                                <Button Content="{Binding LabelTestMemoireArreter}" Style="{StaticResource Lien}" Margin="18,0,0,0"
                                                                        Command="{Binding ArreterTestMemoireCommand}"/>
                                                            </StackPanel>
                                                            <!-- résultat : le mot d'état porte la couleur, jamais la couleur seule -->
                                                            <StackPanel Margin="0,12,0,0" Visibility="{Binding TestMemoireATermine, Converter={StaticResource BoolVis}}">
                                                                <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" BorderThickness="1">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{StaticResource EtatNonLuDouxBrush}"/>
                                                                            <Setter Property="BorderBrush" Value="{StaticResource EtatNonLuFiletBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding TestMemoireEnDefaut}" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource EtatCorrigerDouxBrush}"/>
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource EtatCorrigerFiletBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock>
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Legende}">
                                                                                <Setter Property="Text" Value="observé"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource EtatNonLuBrush}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding TestMemoireEnDefaut}" Value="True">
                                                                                        <Setter Property="Text" Value="à corriger"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource EtatCorrigerBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Text="{Binding ResultatTestMemoire}" Style="{StaticResource Corps}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                                                <Button Content="{Binding LabelTestMemoireRelancer}" Style="{StaticResource Lien}" Margin="0,8,0,0"
                                                                        HorizontalAlignment="Left" Command="{Binding LancerTestMemoireCommand}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Agir : remesurer la mémoire à la demande. La référence du premier scan se relisait
                                                     indéfiniment ; même gabarit que la carte voisine.
                                                     08/10/2026 (audit) : la consigne au survol du test au-dessus réserve déjà sa place ; 20 px de plus creusaient un trou. -->
                                                <StackPanel>
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="memoire"/>
                                                                        <Condition Binding="{Binding DataContext.RemesureMemoireVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    
                                                    <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" VerticalAlignment="Top"
                                                                                Command="{Binding RemesurerMemoireCommand}" Content="{Binding LabelCapsuleRemesureMemoire}" Occupe="{Binding RemesureMemoireEnCours}"
                                                                                AutomationProperties.Name="{Binding LabelRemesureMemoireTitre}"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelRemesureMemoireTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelRemesureMemoireDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding LabelRemesureMemoireMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RemesureMemoireEnCours}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding RemesureMemoireFaite}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding LabelRemesureMemoireEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"
                                                                       Margin="0,10,0,0" Visibility="{Binding RemesureMemoireEnCours, Converter={StaticResource BoolVis}}"/>
                                                            <Border CornerRadius="10" Padding="10,3" BorderThickness="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                                    Background="{StaticResource EtatRienDouxBrush}" BorderBrush="{StaticResource EtatRienFiletBrush}"
                                                                    Visibility="{Binding RemesureMemoireFaite, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="{Binding LabelRemesureMemoireFaite}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatRienBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding LabelMemoireSauteeJeu}" Style="{StaticResource Legende}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding MemoireSauteeJeu, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding ErreurRemesureMemoire}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                                                                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurRemesureMemoire, Converter={StaticResource StrVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Agir, latence : mesurer ce que la souris et la manette envoient vraiment. Le maintien du
                                                     noyau lance cinq secondes d'écoute ; rien n'est intercepté ni écrit. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="latence"/>
                                                                        <Condition Binding="{Binding DataContext.MesureDesEntreesDisponible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" MinWidth="190" VerticalAlignment="Top" DureeMaintien="0:0:0.35"
                                                                                Command="{Binding MesurerCadenceCommand}" Content="{Binding LabelCapsuleCadence}"
                                                                                Occupe="{Binding CadenceEnCours}"
                                                                                AutomationProperties.Name="{Binding LabelCadenceTitre}"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelCadenceTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelCadenceDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding LabelCadenceMaintenir}" effets:ConsigneAuSurvol.Actif="True" Style="{StaticResource Discret}" Margin="0,10,0,0"
                                                                       Visibility="{Binding CadencePrete, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding LabelCadenceEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}" Margin="0,10,0,0"
                                                                       Visibility="{Binding CadenceEnCours, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding ResultatCadence}" Style="{StaticResource Corps}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                                       Visibility="{Binding ResultatCadence, Converter={StaticResource StrVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Agir, réseau : la protection du ping. Indisponible, la
                                                     carte dit pourquoi et comment la rendre disponible (règle empty-state), au lieu
                                                     de disparaître. Disponible : une bascule dont l'état est écrit en mots. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cle}" Value="reseau">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <StackPanel Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding LabelPingTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <Border CornerRadius="10" Padding="10,3" BorderThickness="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding PlafondEnvoiDisponible, Converter={StaticResource BoolVis}}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{StaticResource EtatNonLuDouxBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource EtatNonLuFiletBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding PlafondEnvoiActif}" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource EtatRienDouxBrush}"/>
                                                                                <Setter Property="BorderBrush" Value="{StaticResource EtatRienFiletBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding LabelPingEtat}" Style="{StaticResource Legende}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <!-- La première phrase, la suite derrière le « ? » au bout de la ligne.
                                                             Tant que la protection n'est pas disponible, sa description se tait ;
                                                             la phrase « Pas encore disponible » et la veille disent quoi faire, avec un seul « ? ». -->
                                                        <StackPanel Visibility="{Binding PlafondEnvoiDisponible, Converter={StaticResource BoolVis}}">
                                                        <DockPanel Margin="0,4,0,0">
                                                            <ToggleButton x:Name="PourquoiPing" Style="{StaticResource BoutonPourquoi}" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top"
                                                                          AutomationProperties.Name="{Binding LabelPourquoi}"/>
                                                            <TextBlock Text="{Binding LabelPingDescriptionCourte}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding LabelPingDescriptionSuite}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding IsChecked, ElementName=PourquoiPing, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding LabelPingIndisponible}" Style="{StaticResource Discret}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding PlafondEnvoiIndisponible, Converter={StaticResource BoolVis}}"/>
                                                        <TextBlock Text="{Binding TextePlafondEnvoi}" Style="{StaticResource Discret}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   Visibility="{Binding PlafondEnvoiDisponible, Converter={StaticResource BoolVis}}"/>
                                                        <Button Content="{Binding LabelPingBascule}" Style="{StaticResource BoutonReflet}" Margin="0,12,0,0"
                                                                HorizontalAlignment="Left" Command="{Binding BasculerPlafondEnvoiCommand}"
                                                                Visibility="{Binding PlafondEnvoiDisponible, Converter={StaticResource BoolVis}}"/>
                                                        <!-- La bascule flottait sous le texte, seule rangée d'Agir hors grille ; même
                                                             grille que les autres actions : le bouton à gauche, l'explication à droite. -->
                                                        <Grid x:Name="GrilleVeille" Margin="0,12,0,0" Visibility="{Binding VeillePingProposee, Converter={StaticResource BoolVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <ToggleButton Content="{Binding LabelVeilleBascule}" Style="{StaticResource Bascule}" VerticalAlignment="Top"
                                                                          IsChecked="{Binding VeillePingActive, Mode=OneWay}" Command="{Binding BasculerVeillePingCommand}"/>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <DockPanel>
                                                                    <ToggleButton x:Name="PourquoiVeille" Style="{StaticResource BoutonPourquoi}" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top"
                                                                                  AutomationProperties.Name="{Binding LabelPourquoi}"/>
                                                                    <TextBlock Text="{Binding LabelVeilleDescriptionCourte}" Style="{StaticResource Discret}" TextWrapping="Wrap"/>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding LabelVeilleDescriptionSuite}" Style="{StaticResource Discret}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                           Visibility="{Binding IsChecked, ElementName=PourquoiVeille, Converter={StaticResource BoolVis}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding ErreurPlafondEnvoi}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                                                                   Margin="0,8,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding ErreurPlafondEnvoi, Converter={StaticResource StrVis}}"/>
                                                        <!-- Le test de la ligne sous charge : seulement sur ce clic, le serveur et le volume dits avant. -->
                                                        <Grid Margin="0,12,0,0" Visibility="{Binding TestLigneDisponible, Converter={StaticResource BoolVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Top">
                                                                <Button Content="{Binding LabelTestLigne}" Style="{StaticResource BoutonReflet}"
                                                                        Command="{Binding TesterLigneCommand}"/>
                                                                <Button Content="{Binding LabelTestLigneArreter}" Style="{StaticResource Lien}" Margin="0,8,0,0"
                                                                        Command="{Binding ArreterTestLigneCommand}"
                                                                        Visibility="{Binding TestLigneEnCours, Converter={StaticResource BoolVis}}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding LabelTestLigneDescription}" Style="{StaticResource Discret}" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding TexteTestLigne}" Style="{StaticResource Discret}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                                           Typography.NumeralAlignment="Tabular"
                                                                           Visibility="{Binding TexteTestLigne, Converter={StaticResource StrVis}}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Agir, windows : rendre l'écran de récupération. Seulement si l'audit a lu
                                                     l'élément ; le maintien est la confirmation ; l'annulation reste à côté du fait. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="windows"/>
                                                                        <Condition Binding="{Binding DataContext.CarteWindowsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Visibility="{Binding BcdVisible, Converter={StaticResource BoolVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeCorrection}" VerticalAlignment="Top"
                                                                                Command="{Binding RendreBcdCommand}" Content="{Binding LabelCapsuleBcd}" Occupe="{Binding BcdEnCours}"
                                                                                IsEnabled="{Binding BcdARendre}"
                                                                                AutomationProperties.Name="{Binding LabelBcdTitre}"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelBcdTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelBcdDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding LabelBcdMaintenir}" effets:ConsigneAuSurvol.Actif="True" Style="{StaticResource Discret}" Margin="0,10,0,0"
                                                                       Visibility="{Binding BcdARendre, Converter={StaticResource BoolVis}}"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                                        Visibility="{Binding BcdRendu, Converter={StaticResource BoolVis}}">
                                                                <Border CornerRadius="10" Padding="10,3" BorderThickness="1" VerticalAlignment="Center"
                                                                        Background="{StaticResource EtatRienDouxBrush}" BorderBrush="{StaticResource EtatRienFiletBrush}">
                                                                    <TextBlock Text="{Binding LabelBcdFait}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatRienBrush}"/>
                                                                </Border>
                                                                <Button Content="{Binding LabelBcdAnnuler}" Style="{StaticResource Lien}" Margin="14,0,0,0"
                                                                        Command="{Binding AnnulerBcdCommand}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ErreurBcd}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                                                                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurBcd, Converter={StaticResource StrVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- Réparer Windows avec DISM puis sfc, dans une console visible (UAC de Windows).
                                                         Même gabarit que la carte BCD : rien de nouveau visuellement. -->
                                                    <Grid Margin="0,18,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Visibility="{Binding ReparationVisible, Converter={StaticResource BoolVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeCorrection}" VerticalAlignment="Top"
                                                                                Command="{Binding LancerReparationCommand}" Content="{Binding LabelCapsuleReparation}"
                                                                                IsEnabled="{Binding ReparationAOuvrir}"
                                                                                AutomationProperties.Name="{Binding LabelReparationTitre}"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelReparationTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelReparationDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding LabelReparationMaintenir}" effets:ConsigneAuSurvol.Actif="True" Style="{StaticResource Discret}" Margin="0,10,0,0"
                                                                       Visibility="{Binding ReparationAOuvrir, Converter={StaticResource BoolVis}}"/>
                                                            <Border CornerRadius="10" Padding="10,3" BorderThickness="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                                                                    Background="{StaticResource EtatRienDouxBrush}" BorderBrush="{StaticResource EtatRienFiletBrush}"
                                                                    Visibility="{Binding ReparationLancee, Converter={StaticResource BoolVis}}">
                                                                <TextBlock Text="{Binding EtatReparation}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatRienBrush}" TextWrapping="Wrap"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding ErreurReparation}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                                                                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurReparation, Converter={StaticResource StrVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- La pause du maintien du service de démarrage : seulement s'il est installé. Un geste qui se
                                                         reprend par le même bouton, d'où un bouton simple ; l'état affiché est relu après le geste. -->
                                                    <StackPanel Margin="0,18,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Visibility="{Binding PauseMaintienVisible, Converter={StaticResource BoolVis}}">
                                                        <TextBlock Text="{Binding LabelPauseMaintienTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding LabelPauseMaintienDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding LabelPauseMaintienEtat}" Style="{StaticResource Discret}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                                   Visibility="{Binding PauseMaintienEtatVisible, Converter={StaticResource BoolVis}}"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                            <Button Content="{Binding LabelPauseMaintienBascule}" Style="{StaticResource BoutonReflet}"
                                                                    Command="{Binding BasculerPauseMaintienCommand}"/>
                                                            <Button Content="{Binding LabelPauseMaintienRetirer}" Style="{StaticResource Lien}" Margin="14,0,0,0" VerticalAlignment="Center"
                                                                    Command="{Binding RetirerPauseMaintienCommand}"
                                                                    Visibility="{Binding PauseIncertaine, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ErreurPauseMaintien}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                                                                   Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurPauseMaintien, Converter={StaticResource StrVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Proposé : ce que DrDXT réglerait. Rangé à part : sous « Constaté »,
                                                     « VRR + modèle flip activés » se lisait comme un état de la machine. -->
                                                <StackPanel Margin="0,20,0,0" Visibility="{Binding ADesProposes, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding DataContext.LabelCarteProposes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <ItemsControl ItemsSource="{Binding Proposes}" Margin="0,10,0,0"
                                                                  ItemTemplate="{StaticResource LigneDeCarte}"/>
                                                </StackPanel>

                                                <!-- Ce que DrDXT fait sur cette page, levier par levier. Replié ; le statut et, s'il n'est
                                                     pas pour ce matériel, la raison. Fin de la navigation à l'aveugle. -->
                                                <Expander Margin="0,20,0,0" IsExpanded="False" Visibility="{Binding ADesLeviers, Converter={StaticResource BoolVis}}"
                                                          AutomationProperties.Name="{Binding DataContext.LabelCarteLeviers, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Expander.Header>
                                                        <TextBlock Text="{Binding DataContext.LabelCarteLeviers, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding Leviers}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,10">
                                                                    <TextBlock Style="{StaticResource Corps}" TextWrapping="Wrap">
                                                                        <Run Text="{Binding Nom, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Statut, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Raison}" Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                                               Visibility="{Binding ARaison, Converter={StaticResource BoolVis}}"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                                <!-- Ce qui se fait à la main (BIOS, câbles, jeu), étape par étape, sur le dépôt. -->
                                                <Button Content="{Binding DataContext.LabelGuide, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Command="{Binding DataContext.OuvrirGuideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,12,0,0"/>

                                                <!-- Pas pu lire : un angle mort se dit, il ne passe jamais pour sain. -->
                                                <StackPanel Margin="0,20,0,0" Visibility="{Binding ADesNonLus, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding DataContext.LabelCarteNonLus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13" Foreground="{StaticResource EtatNonLuBrush}"/>
                                                    <ItemsControl ItemsSource="{Binding NonLus}" Margin="0,10,0,0" ItemTemplate="{StaticResource LigneNonLue}"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding LabelBiosOptional}" Style="{StaticResource Legende}" Margin="320,12,0,0"
                                   Visibility="{Binding HasBiosFindings, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>

                    <!-- ───── LA MESURE EN JEU ───── -->
                    <Border Style="{StaticResource Dalle}" Padding="28,20" Margin="0,0,0,14" effets:Revelation.Active="True" effets:Revelation.Retard="140"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Done,AlreadyOptimal'}">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding LabelAvgFps}" Style="{StaticResource Legende}"/>
                                <!-- Le FPS moyen ne s'affiche jamais seul : sa marge d'erreur est collée au chiffre. -->
                                <TextBlock Text="{Binding AvgFpsAvecMarge}" Style="{StaticResource Mesure}" FontSize="34" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Fill="{StaticResource FiletBrush}"/>
                            <StackPanel Grid.Column="2" Margin="28,0,0,0">
                                <TextBlock Text="{Binding LabelP1Low}" Style="{StaticResource Legende}"/>
                                <TextBlock Text="{Binding P1LowAvecMarge}" Style="{StaticResource Mesure}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Fill="{StaticResource FiletBrush}"/>
                            <StackPanel Grid.Column="4" Margin="28,0,0,0">
                                <TextBlock Text="{Binding LabelMargin}" Style="{StaticResource Legende}"/>
                                <TextBlock Text="{Binding MarginDisplay}" Style="{StaticResource Mesure}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <!-- La courbe de CETTE mesure, jamais un avant/après : chaque point est la trame la plus lente de son
                             instant, la ligne la médiane. Points calculés par le ViewModel. -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding ACourbe, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding LabelCourbe}" Style="{StaticResource Legende}"/>
                            <Viewbox Stretch="Fill" Height="120" Margin="0,8,0,0">
                                <Canvas Width="600" Height="120" ClipToBounds="True"
                                        AutomationProperties.Name="{Binding LabelCourbe}">
                                    <Line X1="0" X2="600" Y1="{Binding CourbeDeLaMesure.MedianeY}" Y2="{Binding CourbeDeLaMesure.MedianeY}"
                                          Stroke="{StaticResource TexteDiscretBrush}" StrokeThickness="1" StrokeDashArray="4 3"/>
                                    <Polyline Points="{Binding PointsDeLaCourbe}" Stroke="{StaticResource IrisCyanBrush}" StrokeThickness="1.5"
                                              StrokeLineJoin="Round"/>
                                    <!-- Les pics au-dessus de l'échelle : écrêtés en haut, marqués ici, comptés dans la légende. -->
                                    <ItemsControl ItemsSource="{Binding PicsDeLaCourbe}" Width="600" Height="120">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="7" Height="7" Margin="-3.5,0,0,0" Fill="{StaticResource EtatRegarderBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding LabelCourbeLegende}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding LabelPicsEcretes}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding LabelPicsEcretes, Converter={StaticResource StrVis}}"/>
                        </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Ce qui tournait à côté du jeu : le chiffre ne se lit pas sans. -->
                    <Border Style="{StaticResource Dalle}" Padding="22,16" Margin="0,0,0,14"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Done,AlreadyOptimal,Degraded'}">
                        <StackPanel>
                            <!-- La carte n'avait pas de titre ; une phrase seule flottait. -->
                            <!-- Même niveau de titre que la carte voisine « Tes dernières parties ». -->
                            <TextBlock Text="{Binding LabelVoisinsTitre}" Style="{StaticResource TitreSection}" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding VoisinsResume}" Style="{StaticResource Discret}" TextWrapping="Wrap"/>
                            <!-- La liste brute des programmes se replie derrière un lien (critique de l'app :
                                 elle occupait la page juste sous Optimiser). La phrase au-dessus reste. -->
                            <StackPanel Visibility="{Binding VoisinsConnus, Converter={StaticResource BoolVis}}">
                                <ToggleButton x:Name="VoirVoisins" Content="{Binding LabelVoirVoisins}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                              Cursor="Hand" Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                              FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ItemsControl ItemsSource="{Binding VoisinsDuJeu}" Margin="0,8,0,0"
                                              Visibility="{Binding IsChecked, ElementName=VoirVoisins, Converter={StaticResource BoolVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Donnee}" Margin="0,3,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ───── TES DERNIÈRES PARTIES ───── -->
                    <Border Style="{StaticResource Dalle}" Padding="22,16" Margin="0,0,0,14">
                        <!-- Visible sans scan ; « Prêt à jouer ? » sert avant la partie. -->
                        <StackPanel>
                            <TextBlock Text="{Binding LabelPartiesTitre}" Style="{StaticResource TitreSection}" FontSize="13"/>
                            <!-- L'explication du relevé se replie ; elle reste à un clic. -->
                            <ToggleButton x:Name="CommentParties" Style="{StaticResource Depliant}" Content="{Binding LabelCommentCaMarche}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding LabelPartiesDescription}" Style="{StaticResource Legende}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding IsChecked, ElementName=CommentParties, Converter={StaticResource BoolVis}}"/>
                            <ToggleButton Style="{StaticResource Bascule}" Content="{Binding LabelBasculerReleve}"
                                          IsChecked="{Binding ReleveDesPartiesActif, Mode=OneWay}" Command="{Binding BasculerReleveDesPartiesCommand}" Margin="0,12,0,0"/>
                            <!-- L'essai en alternance se juge sur ces parties ; sa ligne et son arrêt vivent ici, visibles sans scan
                                 (avant, dans la zone de résultats : sans scan, aucun moyen de l'arrêter). Le lancer reste avec Optimiser. -->
                            <TextBlock Text="{Binding LigneEssai}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Visibility="{Binding LigneEssai, Converter={StaticResource StrVis}}"/>
                            <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelEssaiArreter}" HorizontalAlignment="Left"
                                    Command="{Binding ArreterEssaiCommand}" Margin="0,8,0,0"
                                    Visibility="{Binding EssaiEnCours, Converter={StaticResource BoolVis}}"/>
                            <!-- Prêt à jouer, en quelques secondes. Après le scan, il est sous Optimiser : ici seulement avant. -->
                            <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Idle,Scanning'}">
                            <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelPretAJouer}" HorizontalAlignment="Left"
                                    Command="{Binding VerifierPretAJouerCommand}" Margin="0,10,0,0"/>
                            <ItemsControl ItemsSource="{Binding LignesPretAJouer}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Corps}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="{Binding LabelPartiesAucune}" Style="{StaticResource Discret}" Margin="0,12,0,0"
                                       Visibility="{Binding AucunePartie, Converter={StaticResource BoolVis}}"/>
                            <!-- En tête ce qui compte ; le détail partie par partie sous son lien. -->
                            <ItemsControl ItemsSource="{Binding LignesPartiesResume}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Corps}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Les changements pas encore jugés en jeu, en tableau (changement · date · en jeu),
                                 au lieu d'un paragraphe de quatre lignes. -->
                            <Grid Margin="0,12,0,0" Grid.IsSharedSizeScope="True" Visibility="{Binding ADesChangementsEnAttente, Converter={StaticResource BoolVis}}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DateEnAttente"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="VerdictEnAttente"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding LabelEnAttenteChangement}" Style="{StaticResource Legende}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LabelEnAttenteDate}" Style="{StaticResource Legende}" Margin="18,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LabelEnAttenteEnJeu}" Style="{StaticResource Legende}" Margin="18,0,0,0"/>
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ChangementsEnAttente}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="DateEnAttente"/>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="VerdictEnAttente"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Changement}" Style="{StaticResource Corps}" TextWrapping="Wrap" LineStackingStrategy="BlockLineHeight"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Date}" Style="{StaticResource Corps}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="18,0,0,0" LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding EnJeu}" Style="{StaticResource Discret}" Margin="18,1,0,0" MaxWidth="340" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <ToggleButton x:Name="DetailParties" Style="{StaticResource Depliant}" Content="{Binding LabelDetailParties}" Margin="0,10,0,0"
                                          Visibility="{Binding ADuDetailDeParties, Converter={StaticResource BoolVis}}"/>
                            <ItemsControl ItemsSource="{Binding LignesPartiesDetail}" Margin="0,6,0,0"
                                          Visibility="{Binding IsChecked, ElementName=DetailParties, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Legende}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ───── HISTORIQUE DE TA MACHINE ───── -->
                    <!-- Ce que DrDXT a posé, chacun annulable ici. -->
                    <Border x:Name="CarteLeviersPoses" Style="{StaticResource Dalle}" Padding="22,16" Margin="0,0,0,14"
                            Visibility="{Binding ALeviersPoses, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding LabelLeviersTitre}" Style="{StaticResource TitreSection}" FontSize="13"/>
                            <TextBlock Text="{Binding LabelLeviersDescription}" Style="{StaticResource Legende}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding LeviersPoses}" Margin="0,10,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Titre}" Style="{StaticResource Corps}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <Button Grid.Column="1" Style="{StaticResource Lien}" Margin="14,0,0,0"
                                                    Content="{Binding DataContext.LabelLeviersAnnuler, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.AnnulerLevierCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding NomAccessible}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Hors de la carte : il reste lisible après l'annulation du dernier réglage (la carte disparaît). -->
                    <TextBlock Text="{Binding MessageLeviers}" Style="{StaticResource Discret}" Margin="0,0,0,14" TextWrapping="Wrap"
                               Visibility="{Binding MessageLeviers, Converter={StaticResource StrVis}}"/>

                    <Border Style="{StaticResource Dalle}" Padding="22,16" Margin="0,0,0,14"
                            Visibility="{Binding AHistorique, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding LabelHistoriqueTitre}" Style="{StaticResource TitreSection}" FontSize="13"/>
                            <TextBlock Text="{Binding LabelHistoriqueDescription}" Style="{StaticResource Legende}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding LignesHistorique}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Corps}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- La frise en liste à points : vert partie, rouge arrêt ou erreur, violet
                                 changement ; l'heure, ce qui s'est passé, et sous lui les FPS d'une partie.
                                 Bornée en largeur pour se lire d'un coup d'œil. Les FPS, en police fixe, n'ont pas de colonne à
                                 eux : à droite, ils prenaient toute la largeur et le nom du jeu se repliait lettre par lettre. -->
                            <ItemsControl ItemsSource="{Binding FriseHistorique}" Margin="0,8,0,0" Grid.IsSharedSizeScope="True" MaxWidth="720" HorizontalAlignment="Left">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="HeureFrise"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Point" Width="8" Height="8" VerticalAlignment="Top" Margin="0,6,0,0" Fill="{StaticResource EtatNonLuBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Quand.LocalDateTime, StringFormat='dd/MM HH:mm'}" Style="{StaticResource Discret}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="12,0,14,0" VerticalAlignment="Top" LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Texte}" Style="{StaticResource Corps}" TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                           Visibility="{Binding Texte, Converter={StaticResource StrVis}}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Corps}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap"
                                                           LineHeight="20" LineStackingStrategy="BlockLineHeight" Visibility="{Binding Detail, Converter={StaticResource StrVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Genre}" Value="Partie"><Setter TargetName="Point" Property="Fill" Value="{StaticResource EtatRienBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Genre}" Value="ArretBrutal"><Setter TargetName="Point" Property="Fill" Value="{StaticResource EtatCorrigerBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Genre}" Value="ErreurMaterielle"><Setter TargetName="Point" Property="Fill" Value="{StaticResource EtatCorrigerBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Genre}" Value="Changement"><Setter TargetName="Point" Property="Fill" Value="#FFA98BFF"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ───── TON PASSAGE DANS LE BIOS ───── -->
                    <StackPanel Margin="0,30,0,0" Visibility="{Binding HasBiosLoopResult, Converter={StaticResource BoolVis}}" effets:Revelation.Active="True" effets:Revelation.Retard="220">
                        <TextBlock Text="{Binding LabelBiosReturnHeader}" Style="{StaticResource TitreSection}"/>
                        <Border Style="{StaticResource Dalle}" Padding="24,20" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding BiosLoop.Headline}" Style="{StaticResource Corps}" Margin="0,0,0,10"
                                           Visibility="{Binding BiosLoop.Headline, Converter={StaticResource StrVis}}"/>
                                <ItemsControl ItemsSource="{Binding BiosLoop.Outcomes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="{Binding SettingName}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding VerdictLabel}" Style="{StaticResource Discret}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding BiosLoop.RecoveryCard}" Margin="0,6,0,0"
                                              Visibility="{Binding BiosLoop.ShowRecoveryCard, Converter={StaticResource BoolVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Discret}" Margin="0,0,0,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Renoncer au changement, sans quoi le marqueur restait et chaque scan le redisait. -->
                                <Button Content="{Binding LabelOublierChangementBios}" Command="{Binding OublierChangementBiosCommand}"
                                        Style="{StaticResource Lien}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Visibility="{Binding BiosLoop.ShowRecoveryCard, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding ErreurOubliBios}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding ErreurOubliBios, Converter={StaticResource StrVis}}"/>

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasMemoryAb, Converter={StaticResource BoolVis}}">
                                    <Border Style="{StaticResource Filet}" Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding MemoryAb.Header}" Style="{StaticResource TitreSection}" FontSize="13"/>
                                    <ItemsControl ItemsSource="{Binding MemoryAb.Lines}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Legende}"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Before}" Style="{StaticResource Donnee}"/>
                                                        <Path Data="M0 4 H10 M7 1 L10 4 L7 7" Stroke="{StaticResource TexteDiscretBrush}" StrokeThickness="1.2"
                                                              Width="11" Height="8" Margin="10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding After}" Style="{StaticResource Donnee}" Foreground="{StaticResource TexteBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Delta}" Style="{StaticResource Donnee}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding MemoryAb.Conclusion}" Style="{StaticResource Discret}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───── LE GUIDE BIOS ───── -->
                    <StackPanel Margin="0,30,0,0" Visibility="{Binding HasBiosGuide, Converter={StaticResource BoolVis}}" effets:Revelation.Active="True" effets:Revelation.Retard="260">
                        <TextBlock Text="{Binding LabelBiosGuideHeader}" Style="{StaticResource TitreSection}"/>
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Warning, Converter={StaticResource Icon}}"
                                  Stroke="{StaticResource EtatRegarderBrush}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding LabelCadreALaMain}" Style="{StaticResource Legende}" Margin="7,0,0,0" TextWrapping="Wrap"/>
                        </DockPanel>
                        <Border Style="{StaticResource Dalle}" Margin="0,12,0,0" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="{Binding BiosGuide.BoardLabel}" Style="{StaticResource Corps}" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Visibility="{Binding BiosGuide.BoardLabel, Converter={StaticResource StrVis}}"/>
                                <!-- Une phrase, pas une étiquette : elle passe à la ligne sous le nom de la carte.
                                     23/09/2026 : posée dans une pastille à côté du nom, dans une pile horizontale,
                                     elle recevait une largeur infinie et sortait de la dalle, coupée net. -->
                                <TextBlock Text="{Binding BiosGuide.ConfidenceLabel}" Style="{StaticResource Legende}" TextWrapping="Wrap"
                                           Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding BiosGuide.EnterInstruction}" Style="{StaticResource Discret}" Margin="0,14,0,0"
                                           Visibility="{Binding BiosGuide.EnterInstruction, Converter={StaticResource StrVis}}"/>
                                <!-- Carte jamais vue, le manuel du constructeur fait foi. -->
                                <TextBlock Text="{Binding BiosGuide.ManuelDeLaCarte}" Style="{StaticResource Corps}" TextWrapping="Wrap" MaxWidth="760"
                                           HorizontalAlignment="Left" Margin="0,14,0,0"
                                           Visibility="{Binding BiosGuide.ManuelDeLaCarte, Converter={StaticResource StrVis}}"/>
                                <Button Content="{Binding BiosGuide.LabelOuvrirManuel}" Command="{Binding BiosGuide.OuvrirManuelCommand}"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Visibility="{Binding BiosGuide.LienManuelVisible, Converter={StaticResource BoolVis}}"/>
                                <!-- Le guide entier dans un QR, pour le lire au téléphone pendant le BIOS. -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding BiosGuide.QrVisible, Converter={StaticResource BoolVis}}">
                                    <Image Source="{Binding BiosGuide.QrTelephone}" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           AutomationProperties.Name="{Binding BiosGuide.LabelQr}"/>
                                    <TextBlock Text="{Binding BiosGuide.LabelQr}" Style="{StaticResource Discret}" TextWrapping="Wrap" MaxWidth="360"
                                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                                <!-- Le depart vers le BIOS depuis DrDXT. Deux clics : le premier dit ce qui
                                     va se passer (mesure memoire, puis redemarrage), le second le fait. La touche a
                                     presser, juste au-dessus, reste affichee quoi qu'il arrive. -->
                                <Button Content="{Binding BiosGuide.LabelDepart}" Command="{Binding BiosGuide.DemanderDepartCommand}"
                                        Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Visibility="{Binding BiosGuide.BoutonDepartVisible, Converter={StaticResource BoolVis}}"/>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding BiosGuide.ConfirmationVisible, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding BiosGuide.LabelDepartConfirmation}" Style="{StaticResource Corps}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{Binding BiosGuide.LabelDepartConfirmer}" Command="{Binding BiosGuide.ConfirmerDepartCommand}"
                                                Style="{StaticResource BoutonReflet}"/>
                                        <Button Content="{Binding BiosGuide.LabelDepartAnnuler}" Command="{Binding BiosGuide.AnnulerDepartCommand}"
                                                Style="{StaticResource Lien}" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding BiosGuide.LabelDepartEnCours}" Style="{StaticResource Discret}" Margin="0,12,0,0"
                                           Visibility="{Binding BiosGuide.DepartEnCoursVisible, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding BiosGuide.LabelDepartLance}" Style="{StaticResource Corps}" Margin="0,12,0,0"
                                           Visibility="{Binding BiosGuide.DepartLanceVisible, Converter={StaticResource BoolVis}}"/>
                                <Button Content="{Binding BiosGuide.LabelAnnulerRedemarrage}" Command="{Binding BiosGuide.AnnulerRedemarrageCommand}"
                                        Style="{StaticResource Lien}" HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Visibility="{Binding BiosGuide.AnnulationVisible, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="{Binding BiosGuide.ErreurDepart}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Visibility="{Binding BiosGuide.ErreurDepart, Converter={StaticResource StrVis}}"/>
                                <!-- Le secours avant les étapes (lu avant de toucher à quoi que ce soit), et encore après elles. -->
                                <Border CornerRadius="12" Padding="16,14" Margin="0,16,0,0" Background="{StaticResource IrisCyanDouxBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LabelBiosRecoveryHeader}" Style="{StaticResource TitreSection}" FontSize="13"/>
                                        <ItemsControl ItemsSource="{Binding BiosGuide.RecoveryTop}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Discret}" Margin="0,0,0,5"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding BiosGuide.Steps}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="16,12" Margin="0,0,0,8" Background="{StaticResource ObsidienneBrush}"
                                                    BorderThickness="1" BorderBrush="{StaticResource FiletBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Instruction}" Style="{StaticResource Corps}"/>
                                                    <TextBlock Text="{Binding ExactValue}" Style="{StaticResource Donnee}" Foreground="{StaticResource IrisCyanBrush}" Margin="0,5,0,0"
                                                               Visibility="{Binding ExactValue, Converter={StaticResource StrVis}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding BiosGuide.SaveInstruction}" Style="{StaticResource Discret}" Margin="0,6,0,0"
                                           Visibility="{Binding BiosGuide.SaveInstruction, Converter={StaticResource StrVis}}"/>
                                <TextBlock Text="{Binding BiosGuide.CsmSuppressedNote}" Style="{StaticResource Legende}" Margin="0,10,0,0"
                                           Visibility="{Binding BiosGuide.CsmSuppressedNote, Converter={StaticResource StrVis}}"/>
                                <Border CornerRadius="12" Padding="16,14" Margin="0,16,0,0" Background="{StaticResource IrisCyanDouxBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LabelBiosRecoveryHeader}" Style="{StaticResource TitreSection}" FontSize="13"/>
                                        <ItemsControl ItemsSource="{Binding BiosGuide.RecoveryBottom}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Discret}" Margin="0,0,0,5"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ───── LE BILAN DE SANTÉ ───── -->
                    <StackPanel Margin="0,30,0,0" Visibility="{Binding RepairSummary, Converter={StaticResource StrVis}}" effets:Revelation.Active="True" effets:Revelation.Retard="300">
                        <TextBlock Text="{Binding LabelRepairHeader}" Style="{StaticResource TitreSection}"/>
                        <Border Style="{StaticResource Dalle}" Padding="24,20" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Le docteur violet sort de l'interface (« faut changer ») ; le bilan porte la
                                     sphère de marque, la même que le logo et le bouton central. -->
                                <!-- À 148 px le médaillon pesait plus que le verdict à côté. -->
                                <Control Grid.Column="0" Template="{StaticResource SphereDeMarque}" Width="64" Height="64"
                                         VerticalAlignment="Top" Margin="2,2,20,2" Focusable="False" IsTabStop="False"/>
                            <StackPanel Grid.Column="1">
                                <!-- La phrase s'affiche même sans constat : ce qui n'a pas pu être lu se dit. -->
                                <TextBlock Text="{Binding RepairSummary}" Style="{StaticResource Corps}"/>

                                <StackPanel Margin="0,14,0,0" Visibility="{Binding PeutRelancerEnAdministrateur, Converter={StaticResource BoolVis}}">
                                    <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelRelancerEnAdministrateur}"
                                            Command="{Binding RelancerEnAdministrateurCommand}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding LabelRelancerEnAdministrateurAide}" Style="{StaticResource Legende}" Margin="0,6,0,0"/>
                                    <TextBlock Text="{Binding MessageRelanceAdministrateur}" Style="{StaticResource Legende}" Margin="0,4,0,0"
                                               Visibility="{Binding MessageRelanceAdministrateur, Converter={StaticResource StrVis}}"/>
                                </StackPanel>

                                <StackPanel Margin="0,18,0,0" Visibility="{Binding HasRepairChanges, Converter={StaticResource BoolVis}}">
                                    <Border Style="{StaticResource Filet}" Margin="0,0,0,14"/>
                                    <!-- L'avertissement de conditions reste visible ; la liste se déplie à la demande. -->
                                    <ToggleButton x:Name="DeplierChangements" Style="{StaticResource EnTeteRepliable}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LabelRepairChanges}" Style="{StaticResource TitreSection}" FontSize="13" VerticalAlignment="Center"/>
                                            <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Background="{StaticResource ObsidienneReleveeBrush}">
                                                <TextBlock Text="{Binding RepairChanges.Count}" Style="{StaticResource Legende}" Typography.NumeralAlignment="Tabular"/>
                                            </Border>
                                        </StackPanel>
                                    </ToggleButton>
                                    <TextBlock Text="{Binding RepairChangesWarning}" Style="{StaticResource Discret}" Foreground="{StaticResource EtatRegarderBrush}"
                                               Margin="0,8,0,0" Visibility="{Binding RepairChangesWarning, Converter={StaticResource StrVis}}"/>
                                    <ItemsControl ItemsSource="{Binding RepairChanges}" Margin="0,10,0,0"
                                                  Visibility="{Binding IsChecked, ElementName=DeplierChangements, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Legende}" Margin="0,0,0,7"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ───── LE RAPPORT ───── -->
                    <Border Style="{StaticResource Dalle}" Padding="24,20" Margin="0,30,0,0" effets:Revelation.Active="True" effets:Revelation.Retard="380"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Done,AlreadyOptimal,Degraded,Failed'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="300"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <!-- « 13 points à corriger » s'affichait ici pour la troisième fois ;
                                     le bloc dit ce que fait son bouton. -->
                                <TextBlock Text="{Binding LabelRapportDescription}" Style="{StaticResource Discret}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <!-- Le rapport que le client colle dans son ticket. -->
                                <!-- Étiré sur 300 px, il faisait un troisième gabarit de bouton. -->
                                <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left"
                                        Command="{Binding ExportReportCommand}" AutomationProperties.Name="{Binding LabelViewReport}"
                                        Visibility="{Binding CanExportReport, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Report, Converter={StaticResource Icon}}"
                                              Stroke="{StaticResource TexteBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LabelViewReport}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasExportedReport, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding LabelReportWritten}" Style="{StaticResource Legende}"/>
                                    <!-- Le chemin écrit, sélectionnable : un client au téléphone doit pouvoir le lire. -->
                                    <TextBox Text="{Binding LastReportPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AutomationProperties.Name="{Binding LabelReportWritten}"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                                             Foreground="{StaticResource TexteDiscretBrush}"/>
                                </StackPanel>
                                <!-- La machine du joueur testeur, au format des fixtures, anonymisée. -->
                                <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Command="{Binding ExporterMaMachineCommand}" AutomationProperties.Name="{Binding LabelExportMachine}"
                                        Visibility="{Binding CanExportMachine, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Report, Converter={StaticResource Icon}}"
                                              Stroke="{StaticResource TexteBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LabelExportMachine}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasExportedMachine, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding LabelMachineExportWritten}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding LastMachineExportPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AutomationProperties.Name="{Binding LabelMachineExportWritten}"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                                             Foreground="{StaticResource TexteDiscretBrush}"/>
                                </StackPanel>
                                <!-- L'échec du dernier export, sous les boutons d'export ; un export réussi l'efface. -->
                                <TextBlock Text="{Binding MessageDExport}" Style="{StaticResource Discret}" TextWrapping="Wrap"
                                           Foreground="{StaticResource EtatCorrigerBrush}" Margin="0,8,0,0"
                                           Visibility="{Binding MessageDExport, Converter={StaticResource StrVis}}"/>
                                <!-- Le paquet d'aide : préparé et montré fichier par fichier, puis enregistré où le joueur veut. -->
                                <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Content="{Binding LabelPreparerPaquet}" Command="{Binding PreparerPaquetCommand}"/>
                                <StackPanel Visibility="{Binding PaquetPret, Converter={StaticResource BoolVis}}" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding LabelPaquetContient}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                                    <ListBox ItemsSource="{Binding LignesPaquet}" SelectedIndex="{Binding PaquetChoisi}" Margin="0,4,0,0"
                                             AutomationProperties.Name="{Binding LabelPaquetContient}" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TexteDiscretBrush}"/>
                                    <TextBlock Text="{Binding LabelApercuPaquet}" Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBox Text="{Binding ApercuPaquet, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240"
                                             VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" AutomationProperties.Name="{Binding LabelApercuPaquet}"
                                             Visibility="{Binding ApercuPaquet, Converter={StaticResource StrVis}}"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                                             Foreground="{StaticResource TexteDiscretBrush}"/>
                                </StackPanel>
                                <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Content="{Binding LabelEnregistrerPaquet}" Command="{Binding EnregistrerPaquetCommand}"
                                        Visibility="{Binding PaquetPret, Converter={StaticResource BoolVis}}"/>
                                <TextBox Text="{Binding LastPaquetPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0"
                                         Visibility="{Binding LastPaquetPath, Converter={StaticResource StrVis}}"
                                         AutomationProperties.Name="{Binding LabelEnregistrerPaquet}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                                         Foreground="{StaticResource TexteDiscretBrush}"/>
                                <!-- Vérifier DrDXT sur ce PC, chaque réglage posé, relu, remis d'origine, relu. -->
                                <StackPanel Visibility="{Binding CanVerifierMachine, Converter={StaticResource BoolVis}}">
                                    <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            Command="{Binding DemanderVerificationCommand}" AutomationProperties.Name="{Binding LabelVerifierMachine}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Report, Converter={StaticResource Icon}}"
                                                  Stroke="{StaticResource TexteBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LabelVerifierMachine}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding VerificationAConfirmer, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding LabelVerifierConsentement}" Style="{StaticResource Corps}" FontSize="13" LineHeight="19" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource BoutonReflet}" Command="{Binding ConfirmerVerificationCommand}">
                                                <TextBlock Text="{Binding LabelVerifierConfirmer}"/>
                                            </Button>
                                            <Button Style="{StaticResource BoutonReflet}" Margin="10,0,0,0" Command="{Binding AnnulerVerificationCommand}">
                                                <TextBlock Text="{Binding LabelVerifierAnnuler}"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding VerificationProgres}" Style="{StaticResource Legende}" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding VerificationEnCours, Converter={StaticResource BoolVis}}"/>
                                    <!-- En direct : les réglages déjà essayés, et l'arrêt, confirmé, entre deux réglages. -->
                                    <StackPanel Visibility="{Binding VerificationEnCours, Converter={StaticResource BoolVis}}">
                                        <ItemsControl ItemsSource="{Binding EtapesVerification}" Margin="0,6,0,0"
                                                      Visibility="{Binding ADesEtapesVerification, Converter={StaticResource BoolVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Command="{Binding DemanderArretVerificationCommand}" AutomationProperties.Name="{Binding LabelVerifierArreter}">
                                            <TextBlock Text="{Binding LabelVerifierArreter}"/>
                                        </Button>
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding ArretVerificationAConfirmer, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding LabelVerifierArretConsigne}" Style="{StaticResource Corps}" FontSize="13" LineHeight="19" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Style="{StaticResource BoutonReflet}" Command="{Binding ConfirmerArretVerificationCommand}">
                                                    <TextBlock Text="{Binding LabelVerifierArretConfirmer}"/>
                                                </Button>
                                                <Button Style="{StaticResource BoutonReflet}" Margin="10,0,0,0" Command="{Binding AnnulerArretVerificationCommand}">
                                                    <TextBlock Text="{Binding LabelVerifierAnnuler}"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding VerificationBilan}" Style="{StaticResource Corps}" FontSize="13" LineHeight="19" Margin="0,12,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding HasVerificationBilan, Converter={StaticResource BoolVis}}"/>
                                    <!-- Ce que la vérification a fait, réglage par réglage. -->
                                    <ItemsControl ItemsSource="{Binding LignesVerification}" Margin="0,8,0,0"
                                                  Visibility="{Binding ADesLignesVerification, Converter={StaticResource BoolVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Corps}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding HasVerificationChemin, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="{Binding LabelVerifierRapport}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                                        <TextBox Text="{Binding VerificationChemin, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 AutomationProperties.Name="{Binding LabelVerifierRapport}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                                                 Foreground="{StaticResource TexteDiscretBrush}"/>
                                        <!-- Le rapport part par le modèle vide d'un ticket GitHub : le joueur y joint le fichier et relit. -->
                                        <Button Content="{Binding LabelEnvoyerRapport}" Command="{Binding EnvoyerRapportCommand}" Style="{StaticResource BoutonReflet}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════ PIED ════════════ -->
        <Border Grid.Row="1" Background="{StaticResource ObsidienneBrush}" BorderBrush="{StaticResource FiletBrush}"
                BorderThickness="0,1,0,0" Padding="52,10">
            <Grid>
                <TextBlock Text="{Binding LabelFooterVersion}" Style="{StaticResource Legende}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LabelFooterUpdates}" Style="{StaticResource Legende}" VerticalAlignment="Center"/>
                    <!-- Seulement pour une version vérifiée (empreinte revérifiée au clic). -->
                    <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelInstallUpdate}" Padding="14,5" FontSize="12"
                            Command="{Binding InstallUpdateCommand}" Margin="14,0,0,0"
                            Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
