<UserControl x:Class="DrDxt.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrDxt.App.ViewModels"
             xmlns:conv="clr-namespace:DrDxt.App.Converters"
             xmlns:effets="clr-namespace:DrDxt.App.Effets"
             Background="{StaticResource ObsidienneBrush}"
             d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1320">

    <UserControl.Resources>
        <conv:SeverityColorConverter x:Key="SeverityColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis"/>
        <conv:ScanStateToVisibilityConverter x:Key="StateVis"/>
        <conv:IconKeyToGeometryConverter x:Key="Icon"/>

        <!-- La pastille d'état d'un domaine : une couleur, toujours doublée de son mot. -->
        <!-- Le chip d'état : fond neutre, liseré teinté, point teinté, libellé sur le texte courant.
             `TextElement.Foreground` ne porte plus le libellé mais LE POINT — le libellé, lui, fixe
             sa couleur, donc le contraste du mot ne dépend plus de la teinte de l'état. -->
        <!-- 23/09/2026 : plus de liseré teinté (le feu tricolore de tout gabarit, plainte A4). L'étiquette
             est la même pour tous les états ; seul le point porte la couleur, toujours à côté du mot. -->
        <!-- 29/09/2026 : la capsule sombre à point coloré se lisait comme un gabarit tout fait (« grave vibe
             codage », retour sur l'app). L'état devient un nœud du réseau : un point lumineux dans son halo, et le
             mot à côté ; plus de capsule ni de contour. Aucune animation : il reste affiché pendant le jeu. -->
        <Style x:Key="PastilleEtat" TargetType="Border">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource EtatNonLuBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatDomaine.ACorriger}">
                    <Setter Property="TextElement.Foreground" Value="{StaticResource EtatCorrigerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatDomaine.ARegarder}">
                    <Setter Property="TextElement.Foreground" Value="{StaticResource EtatRegarderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Etat}" Value="{x:Static vm:EtatDomaine.RienDeSignale}">
                    <Setter Property="TextElement.Foreground" Value="{StaticResource EtatRienBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Le contenu du chip : le point prend la teinte héritée, le mot garde le contraste du texte. -->
        <!-- 03/10/2026 (D5.5, revue) : un seul signe pour « pourquoi ? » partout (mesures, constats, lectures
             impossibles, processeur bridé) : un « ? » rond, gris au repos, cyan au survol et ouvert. Son nom complet reste
             pour le lecteur d'écran et l'infobulle. -->
        <Style x:Key="BoutonPourquoi" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusIris}"/>
            <Setter Property="ToolTip" Value="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Rond" Width="20" Height="20" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{StaticResource TexteSecondaireBrush}" Background="Transparent">
                            <TextBlock x:Name="Signe" Text="?" FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TexteSecondaireBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rond" Property="BorderBrush" Value="{StaticResource IrisCyanBrush}"/>
                                <Setter TargetName="Signe" Property="Foreground" Value="{StaticResource IrisCyanBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Rond" Property="BorderBrush" Value="{StaticResource IrisCyanBrush}"/>
                                <Setter TargetName="Signe" Property="Foreground" Value="{StaticResource IrisCyanBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ContenuEtat">
            <StackPanel Orientation="Horizontal">
                <!-- 03/10/2026 (D5.3, revue) : la perle brillante (reflet blanc, halo flou) faisait daté. Un point plat de la
                     couleur de l'état, cerclé d'un liseré chrome fin : net, et toujours dans la matière. -->
                <Grid Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse x:Name="Perle" Width="8" Height="8"
                             Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                    <Ellipse Width="10" Height="10" Stroke="{StaticResource LisereChromeBrush}" StrokeThickness="0.9"/>
                </Grid>
                <TextBlock Text="{Binding EtatLibelle}" FontFamily="{StaticResource UiFont}" FontSize="12"
                           FontWeight="Medium" Foreground="{StaticResource TexteBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- 29/09/2026 : une ligne « Pas pu lire ». La température du processeur tenait quatre lignes de prose d'un
             bloc ; comme un constat, la première phrase reste et la suite s'ouvre sous « Pourquoi ? ». -->
        <DataTemplate x:Key="LigneNonLue" DataType="{x:Type vm:EntreeCarte}">
            <StackPanel Margin="0,0,0,12">
                <!-- 03/10/2026 (D8.7, revue n° 3) : le « ? » au bout de la ligne qu'il explique, partout. -->
                <DockPanel LastChildFill="True">
                    <ToggleButton x:Name="PourquoiNonLu" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}" DockPanel.Dock="Right" Margin="10,1,0,0" VerticalAlignment="Top" Visibility="{Binding ADetailSuite, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="{Binding Titre}" Style="{StaticResource Corps}" Foreground="{StaticResource TexteSecondaireBrush}"/>
                </DockPanel>
                <TextBlock Text="{Binding DetailCourt}" Style="{StaticResource Legende}" Margin="0,3,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource StrVis}}"/>
                <TextBlock Text="{Binding DetailSuite}" Style="{StaticResource Legende}" Margin="0,3,0,0"
                           Visibility="{Binding IsChecked, ElementName=PourquoiNonLu, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- Une ligne de la carte : partagée par « Constaté » et « Réglages proposés ». -->
        <DataTemplate x:Key="LigneDeCarte" DataType="{x:Type vm:EntreeCarte}">
            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource FiletBrush}" Padding="0,14,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,6,0,0"
                             Fill="{Binding Converter={StaticResource SeverityColor}}"/>

                    <StackPanel Grid.Column="1">
                        <!-- 03/10/2026 (D8.7, revue n° 3) : le « ? » au bout de la ligne qu'il explique, partout. -->
                        <DockPanel LastChildFill="True">
                            <ToggleButton x:Name="Pourquoi" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}" DockPanel.Dock="Right" Margin="10,1,0,0" VerticalAlignment="Top" Visibility="{Binding ADetailSuite, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding Titre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <!-- 29/09/2026 : la première phrase, puis la suite derrière « Pourquoi ? » ; un constat mémoire
                             faisait dix lignes d'un bloc. -->
                        <TextBlock Text="{Binding DetailCourt}" Style="{StaticResource Discret}" Margin="0,5,0,0"
                                   Visibility="{Binding Detail, Converter={StaticResource StrVis}}"/>
                        <!-- 29/09/2026 (B18) : le remède se lit sans clic, liseré cyan, avant « Pourquoi ? ». -->
                        <Border BorderThickness="2,0,0,0" BorderBrush="{StaticResource IrisCyanBrush}" Padding="10,2,0,2" Margin="0,8,0,0"
                                Visibility="{Binding ARemede, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding RemedeLisible}" Style="{StaticResource Corps}" TextWrapping="Wrap"/>
                                <!-- 03/10/2026 (D10.5) : les commandes en police de code, une par ligne, sélectionnables. -->
                                <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,4" Margin="0,8,0,0"
                                        Background="{StaticResource ObsidienneBrush}" BorderThickness="1" BorderBrush="{StaticResource FiletClairBrush}"
                                        Visibility="{Binding ACommande, Converter={StaticResource BoolVis}}">
                                    <!-- D11.1 (revue n° 5) : une commande coupée au milieu ressemblait à deux commandes cassées ;
                                         chacune tient sur sa ligne et défile si elle déborde. -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding CommandeACopier}" Style="{StaticResource Donnee}" TextWrapping="NoWrap"/>
                                    </ScrollViewer>
                                </Border>
                                <!-- 29/09/2026 (B21) : la commande se copie, DrDXT ne l'exécute pas. -->
                                <Button Content="{Binding DataContext.LabelCopierCommande, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Command="{Binding DataContext.CopierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding CommandeACopier}" HorizontalAlignment="Left" Margin="0,8,0,0" Cursor="Hand"
                                        Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                        FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                                        Visibility="{Binding ACommande, Converter={StaticResource BoolVis}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding DetailSuite}" Style="{StaticResource Discret}" Margin="0,4,0,0"
                                   Visibility="{Binding IsChecked, ElementName=Pourquoi, Converter={StaticResource BoolVis}}"/>
                        <Border HorizontalAlignment="Left" CornerRadius="9" Padding="8,2" Margin="0,8,0,0"
                                Background="{StaticResource IrisCyanDouxBrush}"
                                Visibility="{Binding ActionAAfficher, Converter={StaticResource StrVis}}">
                            <TextBlock Text="{Binding ActionAAfficher}" Style="{StaticResource Legende}" Foreground="{StaticResource IrisCyanBrush}"/>
                        </Border>
                        <!-- La valeur lue, telle quelle : « non lisible » compris. 08/10/2026 : sauf si la phrase au-dessus la dit déjà. -->
                        <Border HorizontalAlignment="Left" CornerRadius="8" Padding="9,4" Margin="0,8,0,0"
                                Background="{StaticResource ObsidienneBrush}" BorderThickness="1" BorderBrush="{StaticResource FiletClairBrush}"
                                Visibility="{Binding ValeurAAfficher, Converter={StaticResource StrVis}}">
                            <TextBlock Text="{Binding ValeurAAfficher}" Style="{StaticResource Donnee}"/>
                        </Border>
                        <!-- La réserve d'un réglage proposé se lit comme une phrase, pas comme une valeur lue. -->
                        <TextBlock Text="{Binding ReserveDeValidation}" Style="{StaticResource Discret}" FontStyle="Italic" Margin="0,8,0,0"
                                   Visibility="{Binding ReserveDeValidation, Converter={StaticResource StrVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Le rail des domaines : chaque domaine est un pôle du réseau qu'on sélectionne. -->
        <Style x:Key="RailDomaines" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Grid>
                            <!-- Le fil qui relie les pôles. -->
                            <Border Width="1" HorizontalAlignment="Left" Margin="27,24,0,24" Background="{StaticResource FiletClairBrush}"/>
                            <!-- 29/09/2026 (B4) : une seule capsule, qui glisse jusqu'à la ligne choisie (effets:CapsuleGlissante). -->
                            <Border x:Name="Glisseur" CornerRadius="14" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left"
                                    Background="{StaticResource ObsidienneReleveeBrush}" BorderBrush="{StaticResource LisereChromeBrush}"
                                    Opacity="0" IsHitTestVisible="False"/>
                            <ItemsPresenter/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusIris}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Case" CornerRadius="14" Padding="12,10" BorderThickness="1"
                                            Background="Transparent" BorderBrush="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Case" Property="Background" Value="{StaticResource ObsidienneHauteBrush}"/>
                                        </Trigger>
                                        <!-- La ligne choisie ne s'allume plus elle-même : la capsule du rail glisse sous elle. -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Case" Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Le réseau change de régime avec le scan. -->
        <Style x:Key="ReseauSelonEtat" TargetType="effets:ReseauNeuronal">
            <Setter Property="Mode" Value="Repos"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Scanning">
                    <Setter Property="Mode" Value="Scan"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter Property="Mode" Value="Resultat"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="AlreadyOptimal">
                    <Setter Property="Mode" Value="Resultat"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Degraded">
                    <Setter Property="Mode" Value="Resultat"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter Property="Mode" Value="Resultat"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Un choix de scène passe à la ligne plutôt que d'être coupé. -->
        <DataTemplate x:Key="LibelleDeScene">
            <TextBlock Text="{Binding Libelle}" TextWrapping="Wrap" TextAlignment="Center"/>
        </DataTemplate>

        <!-- Le métal s'agite pendant le scan. -->
        <!-- 08/10/2026 (le mainteneur : « trop de texte, on perd les infos ; il faut toutes les infos, mais moins de texte ») : ce qui est
             facultatif ou de l'ordre du détail se replie derrière un lien, sur place ; rien n'est retiré. -->
        <Style x:Key="Depliant" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource IrisCyanBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusIris}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="0,2">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                                <Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                      Margin="8,1,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform><RotateTransform x:Name="Rotation" Angle="0"/></Path.RenderTransform>
                                </Path>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 08/10/2026 (critique UI, défaut 10) : « Éteint · surveiller mon ping » était un bouton pilule qui écrivait son état
             dans son texte. Un vrai interrupteur : la piste et son curseur à gauche, le mot d'état, puis ce que ça fait. -->
        <Style x:Key="Bascule" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TexteBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusIris}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="40" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Piste" CornerRadius="11" Background="#1FFFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1"/>
                                <Ellipse x:Name="Curseur" Width="16" Height="16" Margin="3,0" HorizontalAlignment="Left" Fill="#FF9A9A9A"/>
                            </Grid>
                            <TextBlock x:Name="Etat" MinWidth="50" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="#FF9A9A9A"
                                       Text="{Binding DataContext.LabelBasculeEteint, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Curseur" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Curseur" Property="Fill" Value="#FF0B0C10"/>
                                <Setter TargetName="Piste" Property="Background" Value="#FFE8E8E8"/>
                                <Setter TargetName="Piste" Property="BorderBrush" Value="#FFFFFFFF"/>
                                <Setter TargetName="Etat" Property="Foreground" Value="#FFE8E8E8"/>
                                <Setter TargetName="Etat" Property="Text" Value="{Binding DataContext.LabelBasculeAllume, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Piste" Property="BorderBrush" Value="#B3FFFFFF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChampSelonEtat" TargetType="effets:ChampDeChrome">
            <Setter Property="Vitesse" Value="0.16"/>
            <Setter Property="Luminosite" Value="0.9"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="Vitesse" Value="0.55"/>
                    <Setter Property="Luminosite" Value="0.92"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Height="12" VerticalAlignment="Top" Margin="0,0,14,0" Panel.ZIndex="1"
                   Fill="{StaticResource FonduHautBrush}" IsHitTestVisible="False"/>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ════════════ LE CHAMP : chrome liquide, texte à gauche, réseau à droite ════════════ -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <!-- Au repos le champ occupe tout l'écran ; après le scan il laisse monter le résultat. -->
                            <Setter Property="MinHeight" Value="560"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Idle">
                                    <Setter Property="MinHeight" Value="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Scanning">
                                    <Setter Property="MinHeight" Value="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <!-- 03/10/2026 (le mainteneur) : le fond reste le chrome liquide de DrDXT. La parallaxe (B6) est retirée : le décor
                         glissait à l'inverse de la souris, par à-coups. Le bouton s'en distingue par sa forme : un cerveau de neurones. -->
                    <!-- 06/10/2026 (le mainteneur) : le mouvement fluide d'origine, en noir et argent : plus aucune irisation. -->
                    <!-- 06/10/2026 (le mainteneur : « ça fait un peu flou ») : calculé à pleine résolution, plus à 60 % agrandi. -->
                    <effets:ChampDeChrome x:Name="FondChrome" Style="{StaticResource ChampSelonEtat}" Amplitude="0.3" Frequence="3"
                                          Irisation="0" EchelleDeRendu="1" Teinte="#FF40444B"/>
                    <Border Background="{StaticResource VoileLectureBrush}"/>
                    <Border Height="220" VerticalAlignment="Bottom" Background="{StaticResource FonduVersObsidienneBrush}"/>

                    <Grid Margin="52,48,32,36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.92*"/>
                            <ColumnDefinition Width="1.08*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ───── TEXTE ───── -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="560" HorizontalAlignment="Left">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <!-- Pendant le scan, on ne change plus la scène : elle est lue. -->
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Avant le scan -->
                            <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Idle,Scanning'}">
                                <TextBlock Style="{StaticResource TitreMarque}" FontSize="38" LineHeight="46">
                                    <Run Text="{Binding LabelIdleHeadlineLead, Mode=OneWay}" Foreground="{StaticResource TexteBrush}"/>
                                    <Run Text="{Binding LabelIdleHeadlineAccent, Mode=OneWay}" Foreground="{StaticResource ChromeTexteBrush}"/>
                                </TextBlock>
                                <!-- La promesse du produit, lue avant le premier scan. 23/09/2026 : elle n'était
                                     affichée nulle part ; l'ancien sous-titre en disait la moitié. -->
                                <TextBlock Text="{Binding LabelProductPromise}" Style="{StaticResource Discret}" FontSize="15" LineHeight="23"
                                           TextWrapping="Wrap" Margin="0,14,0,0"/>

                                <!-- 24/09/2026 : « Lance un scan » restait écrit pendant le scan (vu sur une photo
                                     de scan réel). L'appel à l'action disparaît dès que le scan tourne. -->
                                <TextBlock Text="{Binding LabelIdleHeroBody}" Margin="0,26,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Corps}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- La consigne de scène se lit AVANT de lancer : la mesure porte sur ce que tu joues. -->
                                <TextBlock Text="{Binding LabelConsigneScene}" Style="{StaticResource Discret}" TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding LabelSceneQuestion}" Style="{StaticResource Legende}" Margin="0,18,0,8"/>
                                <ListBox Style="{StaticResource SelecteurSegmente}" ItemsSource="{Binding ChoixDeScene}"
                                         SelectedItem="{Binding SceneDeclaree}" ItemTemplate="{StaticResource LibelleDeScene}"/>
                                <!-- La précision est facultative : repliée, elle n'occupe plus l'écran. -->
                                <ToggleButton x:Name="Preciser" Style="{StaticResource Depliant}" Content="{Binding LabelAjouterPrecision}" Margin="0,14,0,0"/>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=Preciser, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding LabelSceneDescription}" Style="{StaticResource Legende}" Margin="0,8,0,6"/>
                                    <TextBox Text="{Binding DescriptionScene, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                             AutomationProperties.Name="{Binding LabelSceneDescription}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=ShieldCheck, Converter={StaticResource Icon}}"
                                          Stroke="{StaticResource IrisCyanBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LabelTrustLocal}" Style="{StaticResource Legende}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Après le scan -->
                            <StackPanel Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Done,AlreadyOptimal,Degraded,Failed'}"
                                        effets:Revelation.Active="True">

                                <!-- 08/10/2026 (critique) : trois titres se battaient (verdict 26, nombre 32, « À faire d'abord » en gras).
                                     Un seul gros titre, en tête : le nombre, qui répond à « ma machine va bien ? ». Le verdict suit en sous-titre. -->
                                <TextBlock effets:Compteur.Texte="{Binding ProblemSummary}" FontFamily="{StaticResource UiDisplayFont}" FontSize="38" LineHeight="44" FontWeight="SemiBold"
                                           Foreground="{StaticResource TexteBrush}" TextWrapping="Wrap"
                                           Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Style="{StaticResource TitreSection}" FontSize="17" LineHeight="23" TextWrapping="Wrap" Margin="0,10,0,0">
                                    <Run Text="{Binding LabelResultHeadlineLead, Mode=OneWay}" Foreground="{StaticResource TexteBrush}"/>
                                    <Run Text="{Binding VerdictText, Mode=OneWay}" Foreground="{StaticResource IrisCyanBrush}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource Discret}" FontSize="15" LineHeight="23" Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding DateDuScan}" Style="{StaticResource Legende}" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular"/>
                                <!-- La légende du registre passe en info-bulle de sa ligne : une ligne de moins, rien de perdu. -->
                                <TextBlock Text="{Binding RegisterText}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,14,0,0"
                                           Typography.NumeralAlignment="Tabular" ToolTip="{Binding LabelRegisterCaption}"/>

                                <!-- 29/09/2026 : « 12 points à corriger » sans liste obligeait à ouvrir les huit domaines. Ce qui
                                     est à corriger, le plus grave d'abord, cinq au plus ; un clic ouvre le domaine plus bas. -->
                                <StackPanel Margin="0,22,0,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PointsAFaire.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- 03/10/2026 (D12.5, revue n° 6) : la ligne la plus utile sous le titre était la plus petite. -->
                                    <!-- 08/10/2026 : une étiquette de section, plus un troisième titre. -->
                                    <TextBlock Text="{Binding LabelAFaire}" Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <!-- 29/09/2026 (B2) : les résultats entrent dans l'ordre de lecture, verdict d'abord. -->
                                    <ItemsControl x:Name="ListeAFaire" ItemsSource="{Binding PointsAFaire}" Focusable="False"
                                                  effets:Revelation.Active="True" effets:Revelation.Retard="160">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PointAFaire}">
                                                <Button Style="{StaticResource Lien}" Margin="0,3"
                                                        Command="{Binding DataContext.ChoisirDomaineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Domaine}"
                                                        AutomationProperties.Name="{Binding Entree.Titre}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 03/10/2026 (D8.2, revue n° 3) : la puce d'un constat a la couleur de sa gravité, comme dans son domaine. -->
                                                        <Ellipse Width="6" Height="6" Fill="{Binding Entree.Gravite, Converter={StaticResource SeverityColor}}" VerticalAlignment="Top" Margin="0,7,0,0"/>
                                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" MaxWidth="520">
                                                            <Run Text="{Binding Entree.Titre, Mode=OneWay}" Foreground="{StaticResource TexteBrush}"/>
                                                            <Run Text="{Binding Domaine.Nom, Mode=OneWay, StringFormat='· {0}'}" Foreground="{StaticResource TexteSecondaireBrush}" FontWeight="Normal"/>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- 29/09/2026, seconde critique : Optimiser n'était qu'au milieu de la page, sous huit
                                         domaines. La même commande, là où la liste vient de dire quoi faire. -->
                                    <!-- 29/09/2026 : ce qu'Optimiser essaiera, dit avant le clic. Quatrième critique : posé sous la
                                         liste, le bouton laissait croire qu'il la corrigeait ; l'aperçu vient d'abord, séparé
                                         de la liste, et dit que ce sont ses propres réglages. -->
                                    <TextBlock x:Name="ApercuOptimiser" Text="{Binding ApercuOptimisation}" Style="{StaticResource Discret}" TextWrapping="Wrap"
                                               effets:Revelation.Active="True" effets:Revelation.Retard="280"
                                               MaxWidth="540" HorizontalAlignment="Left" Margin="0,26,0,0"
                                               Visibility="{Binding ApercuOptimisation, Converter={StaticResource StrVis}}"/>
                                    <!-- 03/10/2026 (D5.1) : rien que DrDXT puisse poser seul : une phrase vraie à la place du bouton. -->
                                    <TextBlock Text="{Binding LabelRienAPoserSeul}" Style="{StaticResource Discret}" TextWrapping="Wrap" MaxWidth="540"
                                               HorizontalAlignment="Left" Margin="0,12,0,0"
                                               Visibility="{Binding RienAPoserSeul, Converter={StaticResource BoolVis}}"/>
                                    <!-- 06/10/2026 (L-GPU) : pourquoi le réglage de la carte est ouvert ou fermé chez ce joueur. -->
                                    <!-- 08/10/2026 : le détail du réglage de la carte se replie derrière son lien. -->
                                    <StackPanel Visibility="{Binding PhraseReglageCarte, Converter={StaticResource StrVis}}" Margin="0,12,0,0">
                                        <ToggleButton x:Name="PourquoiCarte" Style="{StaticResource Depliant}" Content="{Binding LabelReglageCartePourquoi}"/>
                                        <TextBlock Text="{Binding PhraseReglageCarte}" Style="{StaticResource Discret}" TextWrapping="Wrap" MaxWidth="540"
                                                   HorizontalAlignment="Left" Margin="0,6,0,0"
                                                   Visibility="{Binding IsChecked, ElementName=PourquoiCarte, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                    <!-- UI1 (08/10/2026) : un souci en cours (arrêt brutal...) se lit AVANT le clic, en « à regarder ». -->
                                    <TextBlock Text="{Binding AvertissementPoint}" Style="{StaticResource Discret}" TextWrapping="Wrap" Foreground="{StaticResource EtatRegarderBrush}"
                                               MaxWidth="540" HorizontalAlignment="Left" Margin="0,12,0,0"
                                               Visibility="{Binding AvertissementPoint, Converter={StaticResource StrVis}}"/>
                                    <Button x:Name="BoutonOptimiser" Style="{StaticResource CapsuleChrome}" Content="{Binding LabelOptimize}"
                                            effets:Revelation.Active="True" effets:Revelation.Retard="360"
                                            Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ApplyHint}"/>
                                    <!-- 06/10/2026 (revue) : point de restauration puis réglages, jusqu'à ~40 s : le dire. -->
                                    <TextBlock Visibility="{Binding ApplyCommand.IsRunning, Converter={StaticResource BoolVis}}"
                                               Text="{Binding LabelOptimisationEnCours}" Style="{StaticResource Discret}" Margin="0,8,0,0"/>
                                    <!-- 06/10/2026 (« je clique et rien ») : le résultat d'Optimiser et ses refus, sous le bouton ;
                                         ils s'écrivaient ~900 lignes plus bas, sous le pli. -->
                                    <StackPanel Margin="0,10,0,0" MaxWidth="540" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding LabelAttenteDuJeuSession}" Style="{StaticResource Discret}" Foreground="{StaticResource IrisCyanBrush}"
                                                   Margin="0,0,0,8" TextWrapping="Wrap" Visibility="{Binding AttenteDuJeuSession, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Text="{Binding ApplyBlockedMessage}" Style="{StaticResource Discret}" TextWrapping="Wrap" Foreground="{StaticResource EtatCorrigerBrush}"
                                                   Margin="0,0,0,8" Visibility="{Binding ApplyBlockedMessage, Converter={StaticResource StrVis}}"/>
                                        <TextBlock Text="{Binding MoatUnarmedMessage}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Visibility="{Binding MoatUnarmedMessage, Converter={StaticResource StrVis}}"/>
                                        <TextBlock Text="{Binding ManifesteIllisibleMessage}" Style="{StaticResource Discret}" TextWrapping="Wrap" Foreground="{StaticResource EtatCorrigerBrush}"
                                                   Margin="0,0,0,8" Visibility="{Binding ManifesteIllisibleMessage, Converter={StaticResource StrVis}}"/>
                                        <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelManifestReset}" HorizontalAlignment="Left"
                                                Command="{Binding RepartirDuManifesteCommand}" Margin="0,0,0,8"
                                                Visibility="{Binding PeutRepartirDuManifeste, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Text="{Binding ResultatOptimisation}" Style="{StaticResource Discret}" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   Visibility="{Binding ResultatOptimisation, Converter={StaticResource StrVis}}"/>
                                        <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelEssaiBouton}" HorizontalAlignment="Left"
                                                Command="{Binding EssayerEnAlternanceCommand}" Margin="0,0,0,8"
                                                Visibility="{Binding EssaiProposable, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                    <!-- 29/09/2026, troisième critique : le choix de scène suit Optimiser ; le bloc du bas et son
                                         second Optimiser sont retirés (un seul appel à l'action). -->
                                    <!-- Ce que tu joues pendant la mesure d'Optimiser. -->
                                    <!-- 29/09/2026 : déjà répondu avant le scan, le choix se dit en une ligne ; le sélecteur
                                         ne revient que sur « Changer » (critique de l'app : sélecteur en double). -->
                                    <StackPanel Margin="0,14,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LabelSceneRetenue}" Style="{StaticResource Discret}" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="ChangerScene" Content="{Binding LabelSceneChanger}" Margin="12,0,0,0" Cursor="Hand"
                                                          Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                                          FontFamily="{StaticResource UiFont}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </StackPanel>
                                        <StackPanel Visibility="{Binding IsChecked, ElementName=ChangerScene, Converter={StaticResource BoolVis}}">
                                            <ListBox Style="{StaticResource SelecteurSegmente}" ItemsSource="{Binding ChoixDeScene}"
                                                     SelectedItem="{Binding SceneDeclaree}" ItemTemplate="{StaticResource LibelleDeScene}" Margin="0,10,0,0"
                                                     AutomationProperties.Name="{Binding LabelSceneQuestion}"/>
                                            <TextBlock Text="{Binding LabelSceneDescription}" Style="{StaticResource Legende}" Margin="0,12,0,6"/>
                                            <TextBox Text="{Binding DescriptionScene, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"
                                                     AutomationProperties.Name="{Binding LabelSceneDescription}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- ───── LE RÉSEAU ───── -->
                        <!-- 06/10/2026 (le mainteneur : « pas du vrai chrome, pas de la vraie 3D ») : le réseau est dessiné sur 660 x 720 et mis à
                             l'échelle d'un bloc ; la boucle de chrome et les billes des composants sont un vrai rendu Cycles
                             (tools/rendus-3d/boucle.py) calé sur ces mêmes pôles. -->
                        <Viewbox Grid.Column="1" MinHeight="480" Stretch="Uniform">
                        <Grid Width="660" Height="720">
                            <effets:BranchesDeChrome Panel.ZIndex="0" Rapide="{Binding IsScanning}"/>
                            <effets:ReseauNeuronal Panel.ZIndex="1" Style="{StaticResource ReseauSelonEtat}" NombreDePoles="5" PolesAllumes="{Binding PolesLus}" RayonX="0.37" RayonY="0.37" AngleDepart="-90"/>
                            

                            <!-- Tes composants, chacun sur son pôle. Les valeurs passent à la ligne, jamais coupées. -->
                            <!-- 08/10/2026 (le mainteneur : « tentacules pas cohérentes ») : chaque tentacule se branche sur l'icône de son composant,
                                 et l'icône fait toujours face à la bille. Celui du haut a donc son icône en bas, posée sur son pôle. -->
                            <!-- 08/10/2026 (critique UI, défaut 6) : chaque satellite dit l'état de son domaine (point + mot) et l'ouvre au clic.
                                 Avant le scan, ni état ni clic. -->
                            <ItemsControl Panel.ZIndex="4" ItemsSource="{Binding Satellites}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <effets:PanneauOrbital RayonX="0.37" RayonY="0.37" AngleDepart="-90" DecalageY="44" PortVersCentre="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="Carte" Width="194" MinHeight="88" Cursor="Hand" FocusVisualStyle="{StaticResource FocusIris}"
                                                IsEnabled="{Binding ADomaine}" Command="{Binding DataContext.ChoisirDomaineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Domaine}" AutomationProperties.Name="{Binding Composant.Label}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Padding="14,12" Background="{StaticResource HaloDeLectureBrush}"><ContentPresenter/></Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Path x:Name="Icone" Grid.Row="0" Data="{Binding Composant.IconKey, Converter={StaticResource Icon}}" Width="25" Height="25" Stretch="Uniform"
                                                      Stroke="#FFECECEC" StrokeThickness="1.4" HorizontalAlignment="Center" Margin="0,0,0,7"/>
                                                <TextBlock x:Name="Nom" Grid.Row="1" Text="{Binding Composant.Label}" Style="{StaticResource Legende}" Foreground="#FFB4B4B4" TextAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                                <Border x:Name="Etat" Grid.Row="2" Style="{StaticResource PastilleEtat}" DataContext="{Binding Domaine}" HorizontalAlignment="Center" Margin="0,3,0,0"
                                                        Visibility="{Binding DataContext.ADomaine, ElementName=Carte, Converter={StaticResource BoolVis}}">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContenuEtat}"/>
                                                </Border>
                                                <TextBlock x:Name="Valeur" Grid.Row="3" Text="{Binding Composant.Value}" Style="{StaticResource Corps}" FontSize="12.5" LineHeight="17"
                                                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                <effets:AncrageArgente x:Name="Ancrage" Grid.Row="4" Width="124" Height="8" Margin="0,8,0,0"/>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <!-- Le composant du haut : le trait, le nom, l'état, la valeur, puis l'icône, tournée vers la bille. -->
                                            <DataTrigger Binding="{Binding (effets:PanneauOrbital.EnHaut), ElementName=Carte}" Value="True">
                                                <Setter TargetName="Ancrage" Property="Grid.Row" Value="0"/>
                                                <Setter TargetName="Ancrage" Property="Margin" Value="0,0,0,8"/>
                                                <Setter TargetName="Nom" Property="Grid.Row" Value="1"/>
                                                <Setter TargetName="Etat" Property="Grid.Row" Value="2"/>
                                                <Setter TargetName="Valeur" Property="Grid.Row" Value="3"/>
                                                <Setter TargetName="Icone" Property="Grid.Row" Value="4"/>
                                                <Setter TargetName="Icone" Property="Margin" Value="0,7,0,0"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Les domaines sans composant (latence, réseau, BIOS) : même point, même mot, même clic, sous l'orbite. -->
                            <!-- Posée entre la bille (réduite après le scan) et les deux satellites du bas : en bas de la scène, elle
                                 chevauchait Stockage et Mémoire (vu sur capture le 08/10). -->
                            <ItemsControl Panel.ZIndex="4" ItemsSource="{Binding DomainesSansComposant}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,304,0,0"
                                          Visibility="{Binding ADesDomainesSansComposant, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 08/10/2026 (vu sur la vraie fenêtre à 1318 px) : le halo s'estompe vers ses bords et les trois se
                                             mangeaient (« atence et fluidité »). Une capsule nette, sombre, à sa taille, espacée. -->
                                        <Button Cursor="Hand" Margin="5,0" FocusVisualStyle="{StaticResource FocusIris}" AutomationProperties.Name="{Binding Nom}"
                                                Command="{Binding DataContext.ChoisirDomaineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Capsule" Padding="14,6" CornerRadius="12" Background="#E60A0B0F" BorderBrush="#2EFFFFFF" BorderThickness="1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Capsule" Property="BorderBrush" Value="#73FFFFFF"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Nom}" Style="{StaticResource Legende}" Foreground="#FFB4B4B4" HorizontalAlignment="Center"/>
                                                <Border Style="{StaticResource PastilleEtat}" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContenuEtat}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Le noyau -->
                            <!-- 06/10/2026 : le bouton est au centre exact du réseau et de son anneau de chrome ; le libellé est posé dessous
                                 sans le pousser (il ne compte pas dans la mise en page). -->
                            <Grid Panel.ZIndex="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- 29/09/2026, troisième critique : après le scan, « Relancer » avait le poids d'Optimiser.
                                     Le noyau reste le cœur du réseau, réduit : l'action principale est à gauche. -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.72" ScaleY="0.72"/></Setter.Value></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="AlreadyOptimal">
                                                    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.72" ScaleY="0.72"/></Setter.Value></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Degraded">
                                                    <Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.72" ScaleY="0.72"/></Setter.Value></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <effets:NoyauDeMaintien Width="244" Height="244" Command="{Binding ScanCommand}" IsEnabled="{Binding CanScan}"
                                                            Occupe="{Binding IsScanning}"
                                                            AutomationProperties.Name="{Binding LabelScanButton}">
<effets:NoyauDeMaintien.Template>
<ControlTemplate TargetType="effets:NoyauDeMaintien">
<Grid>
<effets:BilleDeChrome x:Name="Bille" Margin="0" Rapide="{TemplateBinding Occupe}"/>
<Ellipse Fill="#01000000"/>
<effets:ArcDeProgression Margin="-4" Epaisseur="3" Valeur="{TemplateBinding Progression}" Trait="#FFF0F0F0" Fond="#00FFFFFF" IsHitTestVisible="False"/>
<Ellipse x:Name="AnneauFocus" Margin="0" StrokeThickness="1.5" Stroke="#FFF0F0F0" StrokeDashArray="2 3" Visibility="Collapsed"/>
<Ellipse x:Name="Eclair" Margin="-8" Fill="#30FFFFFF" Opacity="0" IsHitTestVisible="False"/>
</Grid>
<ControlTemplate.Triggers>
<!-- 08/10/2026 : l'anneau en pointillés dit le focus clavier, pas le clic ; la bille s'éclaire au survol, plus au maintien. -->
<MultiTrigger><MultiTrigger.Conditions><Condition Property="IsKeyboardFocused" Value="True"/><Condition Property="IsMouseOver" Value="False"/></MultiTrigger.Conditions><Setter TargetName="AnneauFocus" Property="Visibility" Value="Visible"/></MultiTrigger>
<Trigger Property="IsMouseOver" Value="True">
<Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite" To="1.18" Duration="0:0:0.25"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
<Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite" To="1" Duration="0:0:0.35"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
</Trigger>
<Trigger Property="IsMouseCaptured" Value="True">
<Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite" To="1.45" Duration="0:0:0.7"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
<Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite" To="1" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
</Trigger>
<!-- 08/10/2026 (fin du parcours) : le scan fini, la bille jette un éclat franc puis se pose ; c'est le moment dont on se souvient. -->
<DataTrigger Binding="{Binding State}" Value="Done"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite"><EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="2.1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame><EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1"><EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
<DataTrigger Binding="{Binding State}" Value="AlreadyOptimal"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite"><EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="2.1"/><EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
<DataTrigger Binding="{Binding State}" Value="Degraded"><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimationUsingKeyFrames Storyboard.TargetName="Bille" Storyboard.TargetProperty="Luminosite"><EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="2.1"/><EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="1"/></DoubleAnimationUsingKeyFrames></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger>
<MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False"/><Condition Property="Occupe" Value="False"/></MultiTrigger.Conditions><Setter Property="Opacity" Value="0.5"/></MultiTrigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</effets:NoyauDeMaintien.Template>
</effets:NoyauDeMaintien>
                                    <!-- 03/10/2026 (D2.4, revue) : ce qui tourne est une courte comète blanche, à l'intérieur ; elle dit
                                         « vivant ». La progression, elle, n'est dite que par l'anneau cyan extérieur : collés et de couleurs
                                         voisines, les deux se lisaient comme un seul anneau presque plein dès l'étape 2. -->
                                    <effets:ArcDeProgression Width="232" Height="232" Epaisseur="3" Tourne="True"
                                                             Trait="#CCFFFFFF" IsHitTestVisible="False"
                                                             Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}"/>
                                    <!-- 03/10/2026 (D1.1) : l'analyse dure plus de 10 s ; l'anneau extérieur avance par étape. -->
                                    <effets:ArcDeProgression Width="264" Height="264" Epaisseur="3" Valeur="{Binding ProgressionDuScan}" Plafond="{Binding PlafondDuScan}" Vitesse="{Binding VitesseDuScan}"
                                                             Trait="#FFF0F0F0" Fond="#33FFFFFF" IsHitTestVisible="False"
                                                             Visibility="{Binding JaugeVisible, Converter={StaticResource BoolVis}}"/>
                                </Grid>
                                <Grid VerticalAlignment="Top">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="250"/></Setter.Value></Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="160"/></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="AlreadyOptimal"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="160"/></Setter.Value></Setter></DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Degraded"><Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="160"/></Setter.Value></Setter></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel HorizontalAlignment="Center"
                                                Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Idle'}">
                                        <!-- 07/10/2026 : les voiles passent sous le titre ; une ombre ronde le garde lisible. -->
                                        <Border Background="{StaticResource HaloDeLectureBrush}" Padding="16,8" HorizontalAlignment="Center">
                                            <StackPanel>
                                                <TextBlock Text="{Binding LabelScanButton}" Style="{StaticResource TitreSection}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding LabelMaintenirPourLancer}" Style="{StaticResource Legende}" Foreground="#FFBEBEBE" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                <effets:AncrageArgente Width="100" Height="8" Margin="0,8,0,0"/>

                                            </StackPanel>
                                        </Border>
                                        <!-- 29/09/2026 : Windows a coupé ses animations, DrDXT est figé ; un clic l'anime quand même. -->
                                        <!-- 03/10/2026 (D8.5, revue n° 3) : un lien cyan sous l'action principale lui faisait concurrence ;
                                             une pilule discrète, écartée. -->
                                        <Button Style="{StaticResource BoutonDiscret}" Content="{Binding LabelAnimerMalgreWindows}" Command="{Binding AnimerMalgreWindowsCommand}"
                                                HorizontalAlignment="Center" Margin="0,16,0,0"
                                                Visibility="{Binding AnimationsFigeesParWindows, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                    <!-- 08/10/2026 (critique) : la boîte opaque coupait les tuyaux du bas ; l'étape est posée sur la même ombre
                                         ronde que « Lancer le scan », les tuyaux passent derrière. -->
                                    <Border HorizontalAlignment="Center" Padding="30,14" Background="{StaticResource HaloDeLectureBrush}"
                                            Visibility="{Binding IsScanning, Converter={StaticResource BoolVis}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding LabelScanning}" Style="{StaticResource TitreSection}" Foreground="#FFF0F0F0"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding LabelEtapeDuScan}" Style="{StaticResource Corps}" FontSize="15" Foreground="{StaticResource TexteBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" MaxWidth="240" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <!-- Une consigne à suivre, pas une légende : le voile des étiquettes du graphe la
                                             détache du réseau animé. -->
                                        <Border CornerRadius="10" Padding="10,5" Background="{StaticResource VoileBrush}" MaxWidth="340"
                                                Margin="0,6,0,0" HorizontalAlignment="Center"
                                                Visibility="{Binding AttenteDuJeu, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding LabelAttenteDuJeu}" Style="{StaticResource Corps}" FontSize="12.5"
                                                       TextAlignment="Center" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                    </Border>
                                    <StackPanel HorizontalAlignment="Center"
                                                Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Done,AlreadyOptimal,Degraded,Failed'}">
                                        <TextBlock Text="{Binding LabelRescan}" Style="{StaticResource TitreSection}" HorizontalAlignment="Center"/>
                                        <!-- 04/10/2026 : posée à nu sur le chrome clair du fond, la consigne ne se lisait pas ; une capsule
                                             sombre, comme les libellés des pôles. -->
                                        <Border Background="#B306070A" CornerRadius="9" Padding="10,2" Margin="0,4,0,0" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding LabelMaintenirPourLancer}" Style="{StaticResource Legende}" Foreground="#FFBEBEBE" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                        </Viewbox>
                    </Grid>
                </Grid>

                <!-- ════════════ LE CORPS ════════════ -->
                <StackPanel Margin="52,0,52,48">

                    <!-- Ce qui a bougé depuis le lancement, avant tout scan. -->
                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding ReglagesModifies, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding ReglagesModifies}" Style="{StaticResource Discret}"/>
                    </Border>

                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding MessageDemarrage, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding MessageDemarrage}" Style="{StaticResource Corps}" Foreground="{StaticResource EtatRegarderBrush}"/>
                    </Border>

                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Failed'}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Warning, Converter={StaticResource Icon}}"
                                  Stroke="{StaticResource EtatRegarderBrush}" Width="18" Height="18" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Corps}" Foreground="{StaticResource EtatRegarderBrush}"
                                       Margin="12,0,0,0" MaxWidth="900"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding GatingNote, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding GatingNote}" Style="{StaticResource Discret}"/>
                    </Border>

                    <!-- ════════════ LA CARTE DE LA MACHINE ════════════ -->
                    <StackPanel x:Name="CarteMachine" Margin="0,0,0,30" Visibility="{Binding ADesDomaines, Converter={StaticResource BoolVis}}"
                                effets:Revelation.Active="True" effets:Revelation.Retard="480">
                        <TextBlock Text="{Binding LabelCarteTitre}" Style="{StaticResource TitreMarque}" FontSize="24" LineHeight="30"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 29/09/2026 : le rail suit la lecture d'un long domaine (effets:RailCollant). -->
                            <ListBox Grid.Column="0" Style="{StaticResource RailDomaines}" VerticalAlignment="Top" effets:RailCollant.Actif="True" effets:CapsuleGlissante.Actif="True"
                                     ItemsSource="{Binding Domaines}" SelectedItem="{Binding DomaineSelectionne}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DomaineMachine}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{StaticResource ObsidienneBrush}"
                                                    BorderThickness="1" BorderBrush="{StaticResource FiletClairBrush}">
                                                <!-- 03/10/2026 (D5.2) : acier au repos, cyan pour le domaine choisi. -->
                                                <Path Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="15" Height="15"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource GlyphIcon}">
                                                            <Setter Property="Stroke" Value="{StaticResource TexteSecondaireBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Stroke" Value="{StaticResource IrisCyanBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Nom}" Style="{StaticResource Corps}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="12,0,8,0"/>
                                            <Border Grid.Column="2" Style="{StaticResource PastilleEtat}" VerticalAlignment="Center">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContenuEtat}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Column="2" Style="{StaticResource Dalle}" Padding="30,26" VerticalAlignment="Top">
                                <ContentControl Content="{Binding DomaineSelectionne}" Focusable="False" effets:TransitionDeContenu.Actif="True">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type vm:DomaineMachine}">
                                            <StackPanel effets:Revelation.Active="True">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Nom}" Style="{StaticResource TitreMarque}" FontSize="26" LineHeight="32"/>
                                                        <TextBlock Text="{Binding Composant}" Style="{StaticResource Discret}" Margin="0,6,0,0"
                                                                   Visibility="{Binding AUnComposant, Converter={StaticResource BoolVis}}"/>
                                                        <!-- 29/09/2026 (B9) : la phrase qui dit quoi faire, avant les listes. -->
                                                        <TextBlock Text="{Binding Verdict}" Style="{StaticResource Corps}" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,12,0,0"
                                                                   Visibility="{Binding Verdict, Converter={StaticResource StrVis}}"/>
                                                    </StackPanel>
                                                    <Border Style="{StaticResource PastilleEtat}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContenuEtat}"/>
                                                    </Border>
                                                    <!-- 03/10/2026 (D4.6) : l'en-tête vivant, le langage de l'écran d'analyse sur chaque domaine. Revue :
                                                         posée sous la perle, elle couvrait la phrase « Le plus urgent ici » (Carte graphique) et
                                                         réservait 100 px de vide ; elle vit dans la ligne du titre, à gauche de la perle. -->
                                                    <effets:ConstellationDuDomaine Width="190" Height="44" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                                   Margin="0,0,132,0" Lectures="{Binding NombreDeLectures}" Signales="{Binding NombreDeConstats}"/>
                                                </Grid>

                                                <TextBlock Text="{Binding DataContext.LabelCarteVide, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Style="{StaticResource Discret}" Margin="0,22,0,0"
                                                           Visibility="{Binding EstVide, Converter={StaticResource BoolVis}}"/>

                                                <!-- 29/09/2026 (A1) : ce qui bride le processeur en jeu, en clair ; la phrase qui le disait
                                                     était sous « Pourquoi ? ». Ni bouton ni conseil : le réglage est dans le BIOS. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="processeur"/>
                                                                        <Condition Binding="{Binding DataContext.ALimiteDePuissance, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelLimiteTitre, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <!-- 29/09/2026 (B22) : la première phrase à l'écran, le réglage, le risque et le retour arrière sous « Pourquoi ? ». -->
                                                    <!-- 03/10/2026 (D8.7, revue n° 3) : le « ? » au bout de la ligne qu'il explique, partout. -->
                                                    <DockPanel LastChildFill="True">
                                                        <ToggleButton x:Name="PourquoiBride" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}" DockPanel.Dock="Right" Margin="10,11,0,0" VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding DataContext.LimitePremiereLigne, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource Corps}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding DataContext.LignesLimiteSuite, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,8,0,0"
                                                                  Visibility="{Binding IsChecked, ElementName=PourquoiBride, Converter={StaticResource BoolVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" Style="{StaticResource Corps}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Mesuré -->
                                                <StackPanel Margin="0,24,0,0" Visibility="{Binding ADesMesures, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding DataContext.LabelCarteMesures, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <ItemsControl x:Name="ListeMesures" ItemsSource="{Binding MesuresVisibles}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Margin" Value="0,0,0,10"/>
                                                                            <Style.Triggers>
                                                                                <!-- Sous-titre de famille : de l'air avant, peu après. -->
                                                                                <DataTrigger Binding="{Binding EstTitre}" Value="True">
                                                                                    <Setter Property="Margin" Value="0,10,0,6"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="18"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <!-- 03/10/2026 (D2.6, revue) : sous une ligne lue « pour information », « Pourquoi ? » prenait une ligne entière
                                                                         à chaque fois (six liens cyan identiques sur Processeur) et se lisait avant les valeurs. Un « ? » discret en fin
                                                                         de ligne ouvre la même suite ; son nom complet reste pour le lecteur d'écran et l'infobulle. -->
                                                                    <ToggleButton x:Name="PourquoiMesure" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=UserControl}}" Grid.Row="0" Grid.Column="2" Margin="10,1,0,0" VerticalAlignment="Top" Visibility="{Binding ASuite, Converter={StaticResource BoolVis}}"/>
                                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Suite}" Style="{StaticResource Discret}" Margin="0,4,0,0"
                                                                               Visibility="{Binding IsChecked, ElementName=PourquoiMesure, Converter={StaticResource BoolVis}}"/>
                                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource IrisCyanBrush}" VerticalAlignment="Top" Margin="0,8,0,0"
                                                                             HorizontalAlignment="Left">
                                                                        <Ellipse.Style>
                                                                            <Style TargetType="Ellipse">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding EstTitre}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding EstEntete}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Ellipse.Style>
                                                                    </Ellipse>
                                                                    <TextBlock Text="{Binding TexteCourt}" ToolTip="{Binding Explication}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Corps}">
                                                                                <Setter Property="Grid.Column" Value="1"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding EstTitre}" Value="True">
                                                                                        <Setter Property="FontFamily" Value="{StaticResource MarqueDemiFont}"/>
                                                                                        <Setter Property="FontSize" Value="13"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource TexteSecondaireBrush}"/>
                                                                                    </DataTrigger>
                                                                                    <!-- En-tête « N états lus » : il annonce toute la liste, donc pleine largeur, sans
                                                                                         puce, en texte courant atténué ; les familles gardent leur titre en retrait. -->
                                                                                    <DataTrigger Binding="{Binding EstEntete}" Value="True">
                                                                                        <Setter Property="Grid.Column" Value="0"/>
                                                                                        <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                                                        <Setter Property="Foreground" Value="{StaticResource TexteSecondaireBrush}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- 29/09/2026 : au-delà de huit lignes, la suite se déplie (le BIOS en faisait dix-neuf). -->
                                                    <StackPanel Visibility="{Binding ADesMesuresRepliees, Converter={StaticResource BoolVis}}">
                                                        <ToggleButton x:Name="VoirMesures" HorizontalAlignment="Left" Cursor="Hand"
                                                                      Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                                                      FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold">
                                                            <ToggleButton.Content>
                                                                <TextBlock>
                                                                    <Run Text="{Binding DataContext.LabelVoirLesAutres, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text="{Binding NombreDeLignesRepliees, Mode=OneWay}"/><Run Text=")"/>
                                                                </TextBlock>
                                                            </ToggleButton.Content>
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ItemsControl ItemsSource="{Binding MesuresRepliees}" ItemTemplate="{Binding ItemTemplate, ElementName=ListeMesures}"
                                                                      Margin="0,10,0,0" Visibility="{Binding IsChecked, ElementName=VoirMesures, Converter={StaticResource BoolVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Constaté -->
                                                <StackPanel Margin="0,20,0,0" Visibility="{Binding ADesLignes, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding DataContext.LabelCarteConstats, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <ItemsControl ItemsSource="{Binding LignesVisibles}" Margin="0,10,0,0"
                                                                  ItemTemplate="{StaticResource LigneDeCarte}"/>
                                                    <!-- 29/09/2026 (B13) : au-delà de quatre constats, les trois plus graves d'abord, la suite se déplie. -->
                                                    <StackPanel Visibility="{Binding ADesLignesRepliees, Converter={StaticResource BoolVis}}" Margin="0,6,0,0">
                                                        <ToggleButton x:Name="VoirConstats" HorizontalAlignment="Left" Cursor="Hand"
                                                                      Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                                                                      FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold">
                                                            <ToggleButton.Content>
                                                                <TextBlock>
                                                                    <Run Text="{Binding DataContext.LabelVoirLesAutres, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/><Run Text="{Binding LignesRepliees.Count, Mode=OneWay}"/><Run Text=")"/>
                                                                </TextBlock>
                                                            </ToggleButton.Content>
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ItemsControl ItemsSource="{Binding LignesRepliees}" ItemTemplate="{StaticResource LigneDeCarte}"
                                                                      Margin="0,10,0,0" Visibility="{Binding IsChecked, ElementName=VoirConstats, Converter={StaticResource BoolVis}}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Agir, carte graphique (30/09/2026, G5) : rendre le repos à la carte, prouvé au repos puis en jeu. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="graphique"/>
                                                                        <Condition Binding="{Binding DataContext.ReposCarteVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="24"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMaintien}" VerticalAlignment="Top"
                                                                                Command="{Binding RendreLeReposALaCarteCommand}" Content="{Binding LabelCapsuleReposCarte}" Occupe="{Binding ReposCarteEnCours}"
                                                                                IsEnabled="{Binding ReposCarteAOuvrir}" AutomationProperties.Name="{Binding LabelReposCarteTitre}"/>
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LabelReposCarteTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding LabelReposCarteDescriptionCourte}" ToolTip="{Binding LabelReposCarteDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding LabelReposCarteMaintenir}" effets:ConsigneAuSurvol.Actif="True" Style="{StaticResource Discret}" Margin="0,10,0,0"
                                                                       Visibility="{Binding ReposCarteAOuvrir, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding LabelReposCarteEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"
                                                                       Margin="0,10,0,0" Visibility="{Binding ReposCarteEnCours, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding LabelReposCarteEnAttente}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}" TextWrapping="Wrap"
                                                                       Margin="0,10,0,0" Visibility="{Binding ReposCarteEnAttente, Converter={StaticResource BoolVis}}"/>
                                                            <TextBlock Text="{Binding VerdictReposCarte}" Style="{StaticResource Corps}" TextWrapping="Wrap"
                                                                       Margin="0,10,0,0" Visibility="{Binding VerdictReposCarte, Converter={StaticResource StrVis}}"/>
                                                            <TextBlock Text="{Binding ErreurReposCarte}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                                                                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurReposCarte, Converter={StaticResource StrVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- GPU-OC (08/10/2026) : le mode Expert de la carte. Replié, l'accord du joueur d'abord, rien pendant une partie. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Cle}" Value="graphique"/>
                                                                        <Condition Binding="{Binding DataContext.ExpertVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Expander DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" IsExpanded="False"
                                                              AutomationProperties.Name="{Binding LabelExpertTitre}">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding LabelExpertTitre}" Style="{StaticResource TitreSection}" FontSize="13"/>
                                                        </Expander.Header>
                                                        <StackPanel Margin="0,12,0,0">
                                                            <CheckBox IsChecked="{Binding ExpertAccord}" IsEnabled="{Binding ExpertPeutPoser}">
                                                                <TextBlock Text="{Binding LabelExpertAccord}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                                                            </CheckBox>
                                                            <TextBlock Text="{Binding LabelExpertDecalage}" Style="{StaticResource Corps}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                                            <Slider Minimum="{Binding ExpertMinMhz}" Maximum="{Binding ExpertMaxMhz}" Value="{Binding ExpertDecalageMhz}"
                                                                    TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25" Margin="0,6,0,0"
                                                                    IsEnabled="{Binding ExpertPeutPoser}" AutomationProperties.Name="{Binding LabelExpertDecalage}"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
