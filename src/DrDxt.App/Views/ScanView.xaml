                                                <!-- Agir, réseau (24/09/2026, spec §3c corrigée) : la protection du ping. Indisponible, la
                                                     carte DIT pourquoi et comment la rendre disponible (règle empty-state), au lieu
                                                     de disparaître. Disponible : une bascule dont l'état est écrit en mots. -->
                                                <StackPanel Margin="0,20,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Cle}" Value="reseau">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Style="{StaticResource TitreSection}" FontSize="13"/>
                                                    <StackPanel Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding LabelPingTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                                                            <Border CornerRadius="10" Padding="10,3" BorderThickness="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding PlafondEnvoiDisponible, Converter={StaticResource BoolVis}}">
