<UserControl x:Class="DrDxt.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrDxt.App.ViewModels"
             xmlns:conv="clr-namespace:DrDxt.App.Converters"
             xmlns:effets="clr-namespace:DrDxt.App.Effets"
             xmlns:views="clr-namespace:DrDxt.App.Views"
             xmlns:scan="clr-namespace:DrDxt.App.Views.Scan"
             Background="{StaticResource ObsidienneBrush}"
             d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1320">

    <UserControl.Resources>
        <ResourceDictionary Source="Scan/Ressources.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Rectangle Grid.Row="0" Height="12" VerticalAlignment="Top" Margin="0,0,14,0" Panel.ZIndex="1"
                   Fill="{StaticResource FonduHautBrush}" IsHitTestVisible="False"/>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <scan:Champ/>

                <!-- ════════════ LE CORPS ════════════ -->
                <StackPanel Margin="52,0,52,48">

                    <!-- Ce qui a bougé depuis le lancement, avant tout scan. -->
                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding ReglagesModifies, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding ReglagesModifies}" Style="{StaticResource Discret}"/>
                    </Border>

                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding MessageDemarrage, Converter={StaticResource StrVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding MessageDemarrage}" Style="{StaticResource Corps}" Foreground="{StaticResource EtatRegarderBrush}" TextWrapping="Wrap"/>
                            <Button Content="{Binding LabelRemiseUsine}" Command="{Binding RemettreLaCarteALUsineCommand}" Style="{StaticResource BoutonReflet}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Visibility="{Binding RemiseUsineProposee, Converter={StaticResource BoolVis}}"/>
                            <Button Content="{Binding LabelRendreEssai}" Command="{Binding RendreEssaiInterrompuCommand}" Style="{StaticResource BoutonReflet}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Visibility="{Binding RenduEssaiPropose, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Failed'}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Warning, Converter={StaticResource Icon}}"
                                  Stroke="{StaticResource EtatRegarderBrush}" Width="18" Height="18" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Corps}" Foreground="{StaticResource EtatRegarderBrush}"
                                       Margin="12,0,0,0" MaxWidth="900"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Dalle}" Padding="18,14" Margin="0,0,0,12"
                            Visibility="{Binding GatingNote, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding GatingNote}" Style="{StaticResource Discret}"/>
                    </Border>

                    <!-- ════════════ LA CARTE DE LA MACHINE ════════════ -->
                    <StackPanel x:Name="CarteMachine" Margin="0,0,0,30" Visibility="{Binding ADesDomaines, Converter={StaticResource BoolVis}}"
                                effets:Revelation.Active="True" effets:Revelation.Retard="480">
                        <TextBlock Text="{Binding LabelCarteTitre}" Style="{StaticResource TitreMarque}" FontSize="24" LineHeight="30"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Le rail suit la lecture d'un long domaine (effets:RailCollant). -->
                            <ListBox Grid.Column="0" Style="{StaticResource RailDomaines}" VerticalAlignment="Top" effets:RailCollant.Actif="True" effets:CapsuleGlissante.Actif="True"
                                     ItemsSource="{Binding Domaines}" SelectedItem="{Binding DomaineSelectionne}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DomaineMachine}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{StaticResource ObsidienneBrush}"
                                                    BorderThickness="1" BorderBrush="{StaticResource FiletClairBrush}">
                                                <!-- Acier au repos, cyan pour le domaine choisi. -->
                                                <Path Data="{Binding IconKey, Converter={StaticResource Icon}}" Width="15" Height="15"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path" BasedOn="{StaticResource GlyphIcon}">
                                                            <Setter Property="Stroke" Value="{StaticResource TexteSecondaireBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Stroke" Value="{StaticResource IrisCyanBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Nom}" Style="{StaticResource Corps}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Margin="12,0,8,0"/>
                                            <Border Grid.Column="2" Style="{StaticResource PastilleEtat}" VerticalAlignment="Center">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ContenuEtat}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Column="2" Style="{StaticResource Dalle}" Padding="30,26" VerticalAlignment="Top">
                                <ContentControl Content="{Binding DomaineSelectionne}" Focusable="False" effets:TransitionDeContenu.Actif="True">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="{x:Type vm:DomaineMachine}">
                                            <scan:DetailDuDomaine/>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding LabelBiosOptional}" Style="{StaticResource Legende}" Margin="320,12,0,0"
                                   Visibility="{Binding HasBiosFindings, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>

                    <scan:MesureEtParties/>

                    <scan:Historique/>

                    <scan:BiosEtSante/>

                    <scan:Rapport/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════ PIED ════════════ -->
        <Border Grid.Row="1" Background="{StaticResource ObsidienneBrush}" BorderBrush="{StaticResource FiletBrush}"
                BorderThickness="0,1,0,0" Padding="52,10">
            <Grid>
                <TextBlock Text="{Binding LabelFooterVersion}" Style="{StaticResource Legende}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LabelFooterUpdates}" Style="{StaticResource Legende}" VerticalAlignment="Center"/>
                    <!-- Seulement pour une version vérifiée (empreinte revérifiée au clic). -->
                    <Button Style="{StaticResource BoutonReflet}" Content="{Binding LabelInstallUpdate}" Padding="14,5" FontSize="12"
                            Command="{Binding InstallUpdateCommand}" Margin="14,0,0,0"
                            Visibility="{Binding CanInstallUpdate, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
