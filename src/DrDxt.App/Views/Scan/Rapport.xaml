<!-- Le rapport du scan. -->
<UserControl x:Class="DrDxt.App.Views.Scan.Rapport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrDxt.App.ViewModels"
             xmlns:conv="clr-namespace:DrDxt.App.Converters"
             xmlns:effets="clr-namespace:DrDxt.App.Effets"
             xmlns:views="clr-namespace:DrDxt.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScanViewModel}">

    <UserControl.Resources>
        <ResourceDictionary Source="Ressources.xaml"/>
    </UserControl.Resources>

    <!-- ───── LE RAPPORT ───── -->
    <Border Style="{StaticResource Dalle}" Padding="24,20" Margin="0,30,0,0" effets:Revelation.Active="True" effets:Revelation.Retard="380"
            Visibility="{Binding State, Converter={StaticResource StateVis}, ConverterParameter='Done,AlreadyOptimal,Degraded,Failed'}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <!-- « 13 points à corriger » s'affichait ici pour la troisième fois ;
                     le bloc dit ce que fait son bouton. -->
                <TextBlock Text="{Binding LabelRapportDescription}" Style="{StaticResource Discret}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <!-- Le rapport que le client colle dans son ticket. -->
                <!-- Étiré sur 300 px, il faisait un troisième gabarit de bouton. -->
                <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left"
                        Command="{Binding ExportReportCommand}" AutomationProperties.Name="{Binding LabelViewReport}"
                        Visibility="{Binding CanExportReport, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Report, Converter={StaticResource Icon}}"
                              Stroke="{StaticResource TexteBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LabelViewReport}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasExportedReport, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LabelReportWritten}" Style="{StaticResource Legende}"/>
                    <!-- Le chemin écrit, sélectionnable : un client au téléphone doit pouvoir le lire. -->
                    <TextBox Text="{Binding LastReportPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding LabelReportWritten}"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                             Foreground="{StaticResource TexteDiscretBrush}"/>
                </StackPanel>
                <!-- La machine du joueur testeur, au format des fixtures, anonymisée. -->
                <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,12,0,0"
                        Command="{Binding ExporterMaMachineCommand}" AutomationProperties.Name="{Binding LabelExportMachine}"
                        Visibility="{Binding CanExportMachine, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Report, Converter={StaticResource Icon}}"
                              Stroke="{StaticResource TexteBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LabelExportMachine}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasExportedMachine, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LabelMachineExportWritten}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding LastMachineExportPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AutomationProperties.Name="{Binding LabelMachineExportWritten}"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                             Foreground="{StaticResource TexteDiscretBrush}"/>
                </StackPanel>
                <!-- L'échec du dernier export, sous les boutons d'export ; un export réussi l'efface. -->
                <TextBlock Text="{Binding MessageDExport}" Style="{StaticResource Discret}" TextWrapping="Wrap"
                           Foreground="{StaticResource EtatCorrigerBrush}" Margin="0,8,0,0"
                           Visibility="{Binding MessageDExport, Converter={StaticResource StrVis}}"/>
                <!-- Le paquet d'aide : préparé et montré fichier par fichier, puis enregistré où le joueur veut. -->
                <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,12,0,0"
                        Content="{Binding LabelPreparerPaquet}" Command="{Binding PreparerPaquetCommand}"/>
                <StackPanel Visibility="{Binding PaquetPret, Converter={StaticResource BoolVis}}" Margin="0,8,0,0">
                    <TextBlock Text="{Binding LabelPaquetContient}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                    <ListBox ItemsSource="{Binding LignesPaquet}" SelectedIndex="{Binding PaquetChoisi}" Margin="0,4,0,0"
                             AutomationProperties.Name="{Binding LabelPaquetContient}" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TexteDiscretBrush}"/>
                    <TextBlock Text="{Binding LabelApercuPaquet}" Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBox Text="{Binding ApercuPaquet, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240"
                             VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" AutomationProperties.Name="{Binding LabelApercuPaquet}"
                             Visibility="{Binding ApercuPaquet, Converter={StaticResource StrVis}}"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                             Foreground="{StaticResource TexteDiscretBrush}"/>
                </StackPanel>
                <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Content="{Binding LabelEnregistrerPaquet}" Command="{Binding EnregistrerPaquetCommand}"
                        Visibility="{Binding PaquetPret, Converter={StaticResource BoolVis}}"/>
                <TextBox Text="{Binding LastPaquetPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0"
                         Visibility="{Binding LastPaquetPath, Converter={StaticResource StrVis}}"
                         AutomationProperties.Name="{Binding LabelEnregistrerPaquet}"
                         FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                         Foreground="{StaticResource TexteDiscretBrush}"/>
                <!-- Vérifier DrDXT sur ce PC, chaque réglage posé, relu, remis d'origine, relu. -->
                <StackPanel Visibility="{Binding CanVerifierMachine, Converter={StaticResource BoolVis}}">
                    <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Command="{Binding DemanderVerificationCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding LabelVerifierMachine}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=Report, Converter={StaticResource Icon}}"
                                  Stroke="{StaticResource TexteBrush}" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LabelVerifierMachine}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding VerificationAConfirmer, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding LabelVerifierConsentement}" Style="{StaticResource Corps}" FontSize="13" LineHeight="19" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource BoutonReflet}" Command="{Binding ConfirmerVerificationCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True">
                                <TextBlock Text="{Binding LabelVerifierConfirmer}"/>
                            </Button>
                            <Button Style="{StaticResource BoutonReflet}" Margin="10,0,0,0" Command="{Binding AnnulerVerificationCommand}">
                                <TextBlock Text="{Binding LabelVerifierAnnuler}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding VerificationProgres}" Style="{StaticResource Legende}" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding VerificationEnCours, Converter={StaticResource BoolVis}}"/>
                    <!-- En direct : les réglages déjà essayés, et l'arrêt, confirmé, entre deux réglages. -->
                    <StackPanel Visibility="{Binding VerificationEnCours, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding EtapesVerification}" Margin="0,6,0,0"
                                      Visibility="{Binding ADesEtapesVerification, Converter={StaticResource BoolVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding DemanderArretVerificationCommand}" AutomationProperties.Name="{Binding LabelVerifierArreter}">
                            <TextBlock Text="{Binding LabelVerifierArreter}"/>
                        </Button>
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding ArretVerificationAConfirmer, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="{Binding LabelVerifierArretConsigne}" Style="{StaticResource Corps}" FontSize="13" LineHeight="19" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource BoutonReflet}" Command="{Binding ConfirmerArretVerificationCommand}">
                                    <TextBlock Text="{Binding LabelVerifierArretConfirmer}"/>
                                </Button>
                                <Button Style="{StaticResource BoutonReflet}" Margin="10,0,0,0" Command="{Binding AnnulerArretVerificationCommand}">
                                    <TextBlock Text="{Binding LabelVerifierAnnuler}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding VerificationBilan}" Style="{StaticResource Corps}" FontSize="13" LineHeight="19" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasVerificationBilan, Converter={StaticResource BoolVis}}"/>
                    <!-- Ce que la vérification a fait, réglage par réglage. -->
                    <ItemsControl ItemsSource="{Binding LignesVerification}" Margin="0,8,0,0"
                                  Visibility="{Binding ADesLignesVerification, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Corps}" FontSize="13" LineHeight="19" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,8,0,0" Visibility="{Binding HasVerificationChemin, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding LabelVerifierRapport}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding VerificationChemin, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AutomationProperties.Name="{Binding LabelVerifierRapport}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,4" Background="Transparent"
                                 Foreground="{StaticResource TexteDiscretBrush}"/>
                        <!-- Le rapport part par le modèle vide d'un ticket GitHub : le joueur y joint le fichier et relit. -->
                        <Button Content="{Binding LabelEnvoyerRapport}" Command="{Binding EnvoyerRapportCommand}" Style="{StaticResource BoutonReflet}"
                                HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>

</UserControl>
