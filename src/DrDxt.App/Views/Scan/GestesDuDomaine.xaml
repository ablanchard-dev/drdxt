<!-- Les gestes de DrDXT dans le domaine choisi : rendre le repos à la carte, mode Expert, remesures et tests, protection du ping, écran de récupération. -->
<UserControl x:Class="DrDxt.App.Views.Scan.GestesDuDomaine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrDxt.App.ViewModels"
             xmlns:conv="clr-namespace:DrDxt.App.Converters"
             xmlns:effets="clr-namespace:DrDxt.App.Effets"
             xmlns:views="clr-namespace:DrDxt.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DomaineMachine}">

    <UserControl.Resources>
        <ResourceDictionary Source="Ressources.xaml"/>
    </UserControl.Resources>

    <StackPanel>
    <!-- Agir, carte graphique : rendre le repos à la carte, prouvé au repos puis en jeu. -->
    <StackPanel Margin="0,20,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Cle}" Value="graphique"/>
                            <Condition Binding="{Binding DataContext.ReposCarteVisible, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                   Style="{StaticResource TitreSection}" FontSize="13"/>
        <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeCorrection}" VerticalAlignment="Top"
                                    Command="{Binding RendreLeReposALaCarteCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" Content="{Binding LabelCapsuleReposCarte}" Occupe="{Binding ReposCarteEnCours}"
                                    IsEnabled="{Binding ReposCarteAOuvrir}" AutomationProperties.Name="{Binding LabelReposCarteTitre}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelReposCarteTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LabelReposCarteDescriptionCourte}" ToolTip="{Binding LabelReposCarteDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LabelReposCarteMaintenir}" effets:ConsigneAuSurvol.Actif="True" Style="{StaticResource Discret}" Margin="0,10,0,0"
                           Visibility="{Binding ReposCarteAOuvrir, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding LabelReposCarteEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"
                           Margin="0,10,0,0" Visibility="{Binding ReposCarteEnCours, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding LabelReposCarteEnAttente}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="{Binding ReposCarteEnAttente, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding VerdictReposCarte}" Style="{StaticResource Corps}" TextWrapping="Wrap"
                           Margin="0,10,0,0" Visibility="{Binding VerdictReposCarte, Converter={StaticResource StrVis}}"/>
                <TextBlock Text="{Binding ErreurReposCarte}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurReposCarte, Converter={StaticResource StrVis}}"/>
            </StackPanel>
        </Grid>
    </StackPanel>

    <!-- Le mode Expert de la carte. Replié, l'accord du joueur d'abord, rien pendant une partie. -->
    <StackPanel Margin="0,20,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Cle}" Value="graphique"/>
                            <Condition Binding="{Binding DataContext.ExpertVisible, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <Expander DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}" IsExpanded="False"
                  AutomationProperties.Name="{Binding LabelExpertTitre}">
            <Expander.Header>
                <TextBlock Text="{Binding LabelExpertTitre}" Style="{StaticResource TitreSection}" FontSize="13"/>
            </Expander.Header>
            <StackPanel Margin="0,12,0,0">
                <CheckBox IsChecked="{Binding ExpertAccord}" IsEnabled="{Binding ExpertPeutPoser}">
                    <TextBlock Text="{Binding LabelExpertAccord}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                </CheckBox>
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=ShieldCheck, Converter={StaticResource Icon}}"
                          Stroke="{StaticResource IrisCyanBrush}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding LabelCadreReversible}" Style="{StaticResource Legende}" Margin="7,0,0,0" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="{Binding LabelExpertDecalage}" Style="{StaticResource Corps}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                <Slider Minimum="{Binding ExpertMinMhz}" Maximum="{Binding ExpertMaxMhz}" Value="{Binding ExpertDecalageMhz}"
                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25" Margin="0,6,0,0"
                        IsEnabled="{Binding ExpertPeutPoser}" AutomationProperties.Name="{Binding LabelExpertDecalage}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{Binding LabelExpertAppliquer}" Command="{Binding PoserCarteExpertCommand}" Style="{StaticResource BoutonReflet}"
                            IsEnabled="{Binding ExpertPeutPoser}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
                <!-- Le ventilateur NVIDIA, vers le haut seulement ; même accord, même « Rendre ». -->
                <StackPanel Visibility="{Binding ExpertVentilateurVisible, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LabelExpertVentilateur}" Style="{StaticResource Corps}" FontWeight="SemiBold" Margin="0,18,0,0"/>
                    <Slider Minimum="{Binding ExpertVentilateurMin}" Maximum="{Binding ExpertVentilateurMax}" Value="{Binding ExpertVentilateurPct}"
                            TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Margin="0,6,0,0"
                            IsEnabled="{Binding ExpertPeutPoser}" AutomationProperties.Name="{Binding LabelExpertVentilateur}"/>
                    <Button Content="{Binding LabelExpertVentilateurAppliquer}" Command="{Binding PoserVentilateurExpertCommand}" Style="{StaticResource BoutonReflet}"
                            IsEnabled="{Binding ExpertPeutPoser}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{Binding LabelExpertRendre}" Command="{Binding RendreCarteExpertCommand}" Style="{StaticResource BoutonReflet}"
                            Margin="12,0,0,0" Visibility="{Binding ExpertGarde, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding ExpertEtat}" Style="{StaticResource Corps}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding ExpertEtat, Converter={StaticResource StrVis}}"/>
            </StackPanel>
        </Expander>
    </StackPanel>

    <!-- Agir : remesurer le processeur à la demande, dans son propre domaine. Même gabarit
         que la carte mémoire. -->
    <StackPanel Margin="0,20,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Cle}" Value="processeur"/>
                            <Condition Binding="{Binding DataContext.RemesureCpuVisible, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                   Style="{StaticResource TitreSection}" FontSize="13"/>
        <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" VerticalAlignment="Top"
                                    Command="{Binding RemesurerProcesseurCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" Content="{Binding LabelCapsuleRemesureCpu}" Occupe="{Binding RemesureCpuEnCours}"
                                    AutomationProperties.Name="{Binding LabelRemesureCpuTitre}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelRemesureCpuTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LabelRemesureCpuDescriptionCourte}" ToolTip="{Binding LabelRemesureCpuDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LabelRemesureCpuMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RemesureCpuEnCours}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RemesureCpuFaite}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding LabelRemesureCpuEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"
                           Margin="0,10,0,0" Visibility="{Binding RemesureCpuEnCours, Converter={StaticResource BoolVis}}"/>
                <Border CornerRadius="10" Padding="10,3" BorderThickness="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Background="{StaticResource EtatRienDouxBrush}" BorderBrush="{StaticResource EtatRienFiletBrush}"
                        Visibility="{Binding RemesureCpuFaite, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LabelRemesureCpuFaite}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatRienBrush}"/>
                </Border>
                <TextBlock Text="{Binding LabelCpuSauteJeu}" Style="{StaticResource Legende}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding CpuSauteJeu, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding ErreurRemesureCpu}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurRemesureCpu, Converter={StaticResource StrVis}}"/>
            </StackPanel>
        </Grid>
        <!-- Les programmes gourmands passent après le jeu. Coupé par défaut ; contour, pas
             chrome plein : c'est un réglage qu'on allume, pas l'action de l'écran.
             Même grille que « Remesurer » au-dessus, le bouton à gauche, le texte à droite. -->
        <Grid x:Name="GrilleCalmer" Margin="0,20,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="BoutonCalmerVoisins" Content="{Binding LabelCalmerBascule}" Style="{StaticResource Bascule}"
                          VerticalAlignment="Top" IsChecked="{Binding CalmerVoisinsActif, Mode=OneWay}" Command="{Binding BasculerCalmerVoisinsCommand}"
                          AutomationProperties.Name="{Binding LabelCalmerTitre}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelCalmerTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <DockPanel Margin="0,4,0,0">
                    <ToggleButton x:Name="PourquoiCalmer" Style="{StaticResource BoutonPourquoi}" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top"
                                  AutomationProperties.Name="{Binding LabelPourquoi}"/>
                    <TextBlock Text="{Binding LabelCalmerDescriptionCourte}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
                </DockPanel>
                <TextBlock Text="{Binding LabelCalmerDescriptionSuite}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding IsChecked, ElementName=PourquoiCalmer, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding VoisinsCalmes}" Style="{StaticResource Discret}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding VoisinsCalmes, Converter={StaticResource StrVis}}"/>
                <!-- Proposé d'office d'après les parties relevées ; la liste d'exclusion du joueur. -->
                <TextBlock Text="{Binding PropositionCalmer}" Margin="0,8,0,0" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CalmeurPropose}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding LabelExclusTitre}" Style="{StaticResource Legende}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                <TextBox Text="{Binding VoisinsExclus, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0"
                         AutomationProperties.Name="{Binding LabelExclusTitre}"/>
                <TextBlock Text="{Binding LabelExclusProteges}" Style="{StaticResource Discret}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </StackPanel>

    <!-- Agir : le test de refroidissement, sur la page du processeur. Le même
         gabarit que le test mémoire : maintenir pour lancer, la barre, l'arrêt, le verdict ; arrêt de
         sécurité à 99 °C, jamais pendant un jeu. -->
    <StackPanel Margin="0,20,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Cle}" Value="processeur">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                   Style="{StaticResource TitreSection}" FontSize="13"/>
        <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- L'avancement du test (cinq minutes) passe de l'anneau à une barre sous la capsule. -->
            <StackPanel MinWidth="190" VerticalAlignment="Top">
                <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" Command="{Binding LancerTestRefroidissementCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" Content="{Binding LabelCapsuleTestRefroidissement}"
                                        Occupe="{Binding TestRefroidissementEnCours}"
                                        AutomationProperties.Name="{Binding LabelTestRefroidissementTitre}"/>
                <ProgressBar Height="3" Margin="8,8,8,0" Minimum="0" Maximum="1" Value="{Binding ProgressionTestRefroidissement, Mode=OneWay}"
                             Visibility="{Binding TestRefroidissementEnCours, Converter={StaticResource BoolVis}}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="1.5" Background="{StaticResource FiletBrush}"/>
                                <Border x:Name="PART_Indicator" CornerRadius="1.5" Background="{StaticResource IrisBrush}" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelTestRefroidissementTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LabelTestRefroidissementDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <!-- prêt -->
                <TextBlock Text="{Binding LabelTestRefroidissementMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestRefroidissementEnCours}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestRefroidissementATermine}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- en cours -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding TestRefroidissementEnCours, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LabelTestRefroidissementEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"/>
                    <TextBlock Text="{Binding TempsRestantTestRefroidissement}" Style="{StaticResource Mesure}" Margin="12,0,0,0"/>
                    <Button Content="{Binding LabelTestRefroidissementArreter}" Style="{StaticResource Lien}" Margin="18,0,0,0"
                            Command="{Binding ArreterTestRefroidissementCommand}"/>
                </StackPanel>
                <!-- résultat : le mot d'état porte la couleur, jamais la couleur seule -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding TestRefroidissementATermine, Converter={StaticResource BoolVis}}">
                    <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource EtatNonLuDouxBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource EtatNonLuFiletBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestRefroidissementEnDefaut}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource EtatCorrigerDouxBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource EtatCorrigerFiletBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Legende}">
                                    <Setter Property="Text" Value="observé"/>
                                    <Setter Property="Foreground" Value="{StaticResource EtatNonLuBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestRefroidissementEnDefaut}" Value="True">
                                            <Setter Property="Text" Value="à corriger"/>
                                            <Setter Property="Foreground" Value="{StaticResource EtatCorrigerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding ResultatTestRefroidissement}" Style="{StaticResource Corps}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Button Content="{Binding LabelTestRefroidissementRelancer}" Style="{StaticResource Lien}" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Command="{Binding LancerTestRefroidissementCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>

    <!-- Agir : la recherche de sous-tension, sous le
         test de refroidissement dont elle reprend le gabarit ; l'étape en cours au lieu d'une barre, le
         verdict à reporter au BIOS. -->
    <StackPanel Margin="0,20,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <!-- Seulement là où le helper peut poser la tension : ailleurs, le bouton promettrait une recherche impossible. -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Cle}" Value="processeur"/>
                            <Condition Binding="{Binding DataContext.SousTensionPossible, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                   Style="{StaticResource TitreSection}" FontSize="13"/>
        <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- L'avancement du test (cinq minutes) passe de l'anneau à une barre sous la capsule. -->
            <StackPanel MinWidth="190" VerticalAlignment="Top">
                <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" Command="{Binding LancerRechercheSousTensionCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" Content="{Binding LabelCapsuleSousTension}"
                                        Occupe="{Binding RechercheSousTensionEnCours}"
                                        AutomationProperties.Name="{Binding LabelSousTensionTitre}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelSousTensionTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LabelSousTensionDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <!-- Le prérequis se lit avant le lancement : sur un Intel de 12e à 14e génération, le BIOS refuse tant que
                     « UnderVolt Protection » est active. -->
                <StackPanel Margin="0,8,0,0" Visibility="{Binding SousTensionPrerequisVisible, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LabelSousTensionPrerequis}" Style="{StaticResource Discret}" TextWrapping="Wrap"/>
                    <Button Style="{StaticResource Lien}" Content="{Binding LabelSousTensionGuide}" Command="{Binding OuvrirGuideSousTensionCommand}"
                            HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Path Style="{StaticResource GlyphIcon}" Data="{Binding Source=ShieldCheck, Converter={StaticResource Icon}}"
                          Stroke="{StaticResource IrisCyanBrush}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,2,0,0" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding LabelCadreReversible}" Style="{StaticResource Legende}" Margin="7,0,0,0" TextWrapping="Wrap"/>
                </DockPanel>
                <!-- prêt -->
                <TextBlock Text="{Binding LabelSousTensionMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RechercheSousTensionEnCours}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RechercheSousTensionATermine}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- en cours -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding RechercheSousTensionEnCours, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LabelSousTensionEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"/>
                    <TextBlock Text="{Binding EtapeSousTension}" Style="{StaticResource Mesure}" Margin="12,0,0,0"/>
                    <Button Content="{Binding LabelSousTensionArreter}" Style="{StaticResource Lien}" Margin="18,0,0,0"
                            Command="{Binding ArreterRechercheSousTensionCommand}"/>
                </StackPanel>
                <!-- résultat : le mot d'état porte la couleur, jamais la couleur seule -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding RechercheSousTensionATermine, Converter={StaticResource BoolVis}}">
                    <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" BorderThickness="1"
                            Background="{StaticResource EtatNonLuDouxBrush}" BorderBrush="{StaticResource EtatNonLuFiletBrush}">
                        <TextBlock Text="{Binding LabelSousTensionEtat}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatNonLuBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding ResultatSousTension}" Style="{StaticResource Corps}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Button Content="{Binding LabelSousTensionRelancer}" Style="{StaticResource Lien}" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Command="{Binding LancerRechercheSousTensionCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>

    <!-- Agir : le test mémoire sans redémarrer, dans son propre domaine.
         Le maintien du noyau est la confirmation ; l'anneau dit la durée ; zéro erreur
         s'écrit « observé » en acier, jamais « sain ». -->
    <StackPanel Margin="0,20,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Cle}" Value="memoire">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                   Style="{StaticResource TitreSection}" FontSize="13"/>
        <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- L'avancement du test (cinq minutes) passe de l'anneau à une barre sous la capsule. -->
            <StackPanel MinWidth="190" VerticalAlignment="Top">
                <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" Command="{Binding LancerTestMemoireCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" Content="{Binding LabelCapsuleTestMemoire}"
                                        Occupe="{Binding TestMemoireEnCours}"
                                        AutomationProperties.Name="{Binding LabelTestMemoireTitre}"/>
                <ProgressBar Height="3" Margin="8,8,8,0" Minimum="0" Maximum="1" Value="{Binding ProgressionTestMemoire, Mode=OneWay}"
                             Visibility="{Binding TestMemoireEnCours, Converter={StaticResource BoolVis}}">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" CornerRadius="1.5" Background="{StaticResource FiletBrush}"/>
                                <Border x:Name="PART_Indicator" CornerRadius="1.5" Background="{StaticResource IrisBrush}" HorizontalAlignment="Left"/>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelTestMemoireTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LabelTestMemoireDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <!-- prêt -->
                <TextBlock Text="{Binding LabelTestMemoireMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TestMemoireEnCours}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TestMemoireATermine}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- en cours -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding TestMemoireEnCours, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LabelTestMemoireEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"/>
                    <TextBlock Text="{Binding TempsRestantTestMemoire}" Style="{StaticResource Mesure}" Margin="12,0,0,0"/>
                    <Button Content="{Binding LabelTestMemoireArreter}" Style="{StaticResource Lien}" Margin="18,0,0,0"
                            Command="{Binding ArreterTestMemoireCommand}"/>
                </StackPanel>
                <!-- résultat : le mot d'état porte la couleur, jamais la couleur seule -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding TestMemoireATermine, Converter={StaticResource BoolVis}}">
                    <Border HorizontalAlignment="Left" CornerRadius="10" Padding="10,3" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource EtatNonLuDouxBrush}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource EtatNonLuFiletBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestMemoireEnDefaut}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource EtatCorrigerDouxBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource EtatCorrigerFiletBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Legende}">
                                    <Setter Property="Text" Value="observé"/>
                                    <Setter Property="Foreground" Value="{StaticResource EtatNonLuBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestMemoireEnDefaut}" Value="True">
                                            <Setter Property="Text" Value="à corriger"/>
                                            <Setter Property="Foreground" Value="{StaticResource EtatCorrigerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding ResultatTestMemoire}" Style="{StaticResource Corps}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <Button Content="{Binding LabelTestMemoireRelancer}" Style="{StaticResource Lien}" Margin="0,8,0,0"
                            HorizontalAlignment="Left" Command="{Binding LancerTestMemoireCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>

    <!-- Agir : remesurer la mémoire à la demande. La référence du premier scan se relisait
         indéfiniment ; même gabarit que la carte voisine.
         08/10/2026 (audit) : la consigne au survol du test au-dessus réserve déjà sa place ; 20 px de plus creusaient un trou. -->
    <StackPanel>
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Cle}" Value="memoire"/>
                            <Condition Binding="{Binding DataContext.RemesureMemoireVisible, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>

        <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" DureeMaintien="0:0:0.35" VerticalAlignment="Top"
                                    Command="{Binding RemesurerMemoireCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" Content="{Binding LabelCapsuleRemesureMemoire}" Occupe="{Binding RemesureMemoireEnCours}"
                                    AutomationProperties.Name="{Binding LabelRemesureMemoireTitre}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelRemesureMemoireTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LabelRemesureMemoireDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LabelRemesureMemoireMaintenir}" effets:ConsigneAuSurvol.Actif="True" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Discret}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RemesureMemoireEnCours}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RemesureMemoireFaite}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding LabelRemesureMemoireEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}"
                           Margin="0,10,0,0" Visibility="{Binding RemesureMemoireEnCours, Converter={StaticResource BoolVis}}"/>
                <Border CornerRadius="10" Padding="10,3" BorderThickness="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Background="{StaticResource EtatRienDouxBrush}" BorderBrush="{StaticResource EtatRienFiletBrush}"
                        Visibility="{Binding RemesureMemoireFaite, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding LabelRemesureMemoireFaite}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatRienBrush}"/>
                </Border>
                <TextBlock Text="{Binding LabelMemoireSauteeJeu}" Style="{StaticResource Legende}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding MemoireSauteeJeu, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding ErreurRemesureMemoire}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurRemesureMemoire, Converter={StaticResource StrVis}}"/>
            </StackPanel>
        </Grid>
    </StackPanel>

    <!-- Agir, latence : mesurer ce que la souris et la manette envoient vraiment. Le maintien du
         noyau lance cinq secondes d'écoute ; rien n'est intercepté ni écrit. -->
    <StackPanel Margin="0,20,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Cle}" Value="latence"/>
                            <Condition Binding="{Binding DataContext.MesureDesEntreesDisponible, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                   Style="{StaticResource TitreSection}" FontSize="13"/>
        <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeMesure}" MinWidth="190" VerticalAlignment="Top" DureeMaintien="0:0:0.35"
                                    Command="{Binding MesurerCadenceCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" Content="{Binding LabelCapsuleCadence}"
                                    Occupe="{Binding CadenceEnCours}"
                                    AutomationProperties.Name="{Binding LabelCadenceTitre}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelCadenceTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LabelCadenceDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LabelCadenceMaintenir}" effets:ConsigneAuSurvol.Actif="True" Style="{StaticResource Discret}" Margin="0,10,0,0"
                           Visibility="{Binding CadencePrete, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding LabelCadenceEnCours}" Style="{StaticResource Corps}" Foreground="{StaticResource IrisCyanBrush}" Margin="0,10,0,0"
                           Visibility="{Binding CadenceEnCours, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding ResultatCadence}" Style="{StaticResource Corps}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ResultatCadence, Converter={StaticResource StrVis}}"/>
            </StackPanel>
        </Grid>
    </StackPanel>

    <!-- Agir, réseau : la protection du ping. Indisponible, la
         carte dit pourquoi et comment la rendre disponible (règle empty-state), au lieu
         de disparaître. Disponible : une bascule dont l'état est écrit en mots. -->
    <StackPanel Margin="0,20,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Cle}" Value="reseau">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                   Style="{StaticResource TitreSection}" FontSize="13"/>
        <StackPanel Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding LabelPingTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <Border CornerRadius="10" Padding="10,3" BorderThickness="1" Margin="12,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding PlafondEnvoiDisponible, Converter={StaticResource BoolVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource EtatNonLuDouxBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource EtatNonLuFiletBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlafondEnvoiActif}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource EtatRienDouxBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource EtatRienFiletBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding LabelPingEtat}" Style="{StaticResource Legende}"/>
                </Border>
            </StackPanel>
            <!-- La première phrase, la suite derrière le « ? » au bout de la ligne.
                 Tant que la protection n'est pas disponible, sa description se tait ;
                 la phrase « Pas encore disponible » et la veille disent quoi faire, avec un seul « ? ». -->
            <StackPanel Visibility="{Binding PlafondEnvoiDisponible, Converter={StaticResource BoolVis}}">
            <DockPanel Margin="0,4,0,0">
                <ToggleButton x:Name="PourquoiPing" Style="{StaticResource BoutonPourquoi}" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top"
                              AutomationProperties.Name="{Binding LabelPourquoi}"/>
                <TextBlock Text="{Binding LabelPingDescriptionCourte}" Style="{StaticResource Legende}" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock Text="{Binding LabelPingDescriptionSuite}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Visibility="{Binding IsChecked, ElementName=PourquoiPing, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <TextBlock Text="{Binding LabelPingIndisponible}" Style="{StaticResource Discret}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding PlafondEnvoiIndisponible, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding TextePlafondEnvoi}" Style="{StaticResource Discret}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Typography.NumeralAlignment="Tabular"
                       Visibility="{Binding PlafondEnvoiDisponible, Converter={StaticResource BoolVis}}"/>
            <Button Content="{Binding LabelPingBascule}" Style="{StaticResource BoutonReflet}" Margin="0,12,0,0"
                    HorizontalAlignment="Left" Command="{Binding BasculerPlafondEnvoiCommand}"
                    Visibility="{Binding PlafondEnvoiDisponible, Converter={StaticResource BoolVis}}"/>
            <!-- La bascule flottait sous le texte, seule rangée d'Agir hors grille ; même
                 grille que les autres actions : le bouton à gauche, l'explication à droite. -->
            <Grid x:Name="GrilleVeille" Margin="0,12,0,0" Visibility="{Binding VeillePingProposee, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ToggleButton Content="{Binding LabelVeilleBascule}" Style="{StaticResource Bascule}" VerticalAlignment="Top"
                              IsChecked="{Binding VeillePingActive, Mode=OneWay}" Command="{Binding BasculerVeillePingCommand}"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <DockPanel>
                        <ToggleButton x:Name="PourquoiVeille" Style="{StaticResource BoutonPourquoi}" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Top"
                                      AutomationProperties.Name="{Binding LabelPourquoi}"/>
                        <TextBlock Text="{Binding LabelVeilleDescriptionCourte}" Style="{StaticResource Discret}" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding LabelVeilleDescriptionSuite}" Style="{StaticResource Discret}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsChecked, ElementName=PourquoiVeille, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding ErreurPlafondEnvoi}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding ErreurPlafondEnvoi, Converter={StaticResource StrVis}}"/>
            <!-- Le test de la ligne sous charge : seulement sur ce clic, le serveur et le volume dits avant. -->
            <Grid Margin="0,12,0,0" Visibility="{Binding TestLigneDisponible, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top">
                    <Button Content="{Binding LabelTestLigne}" Style="{StaticResource BoutonReflet}"
                            Command="{Binding TesterLigneCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True"/>
                    <Button Content="{Binding LabelTestLigneArreter}" Style="{StaticResource Lien}" Margin="0,8,0,0"
                            Command="{Binding ArreterTestLigneCommand}"
                            Visibility="{Binding TestLigneEnCours, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LabelTestLigneDescription}" Style="{StaticResource Discret}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding TexteTestLigne}" Style="{StaticResource Discret}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Typography.NumeralAlignment="Tabular"
                               Visibility="{Binding TexteTestLigne, Converter={StaticResource StrVis}}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </StackPanel>

    <!-- Agir, windows : rendre l'écran de récupération. Seulement si l'audit a lu
         l'élément ; le maintien est la confirmation ; l'annulation reste à côté du fait. -->
    <StackPanel Margin="0,20,0,0">
        <StackPanel.Style>
            <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Cle}" Value="windows"/>
                            <Condition Binding="{Binding DataContext.CarteWindowsVisible, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Visible"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </StackPanel.Style>
        <TextBlock Text="{Binding DataContext.LabelCarteAgir, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                   Style="{StaticResource TitreSection}" FontSize="13"/>
        <Grid Margin="0,14,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
              Visibility="{Binding BcdVisible, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeCorrection}" VerticalAlignment="Top"
                                    Command="{Binding RendreBcdCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" Content="{Binding LabelCapsuleBcd}" Occupe="{Binding BcdEnCours}"
                                    IsEnabled="{Binding BcdARendre}"
                                    AutomationProperties.Name="{Binding LabelBcdTitre}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelBcdTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LabelBcdDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LabelBcdMaintenir}" effets:ConsigneAuSurvol.Actif="True" Style="{StaticResource Discret}" Margin="0,10,0,0"
                           Visibility="{Binding BcdARendre, Converter={StaticResource BoolVis}}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding BcdRendu, Converter={StaticResource BoolVis}}">
                    <Border CornerRadius="10" Padding="10,3" BorderThickness="1" VerticalAlignment="Center"
                            Background="{StaticResource EtatRienDouxBrush}" BorderBrush="{StaticResource EtatRienFiletBrush}">
                        <TextBlock Text="{Binding LabelBcdFait}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatRienBrush}"/>
                    </Border>
                    <Button Content="{Binding LabelBcdAnnuler}" Style="{StaticResource Lien}" Margin="14,0,0,0"
                            Command="{Binding AnnulerBcdCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding ErreurBcd}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurBcd, Converter={StaticResource StrVis}}"/>
            </StackPanel>
        </Grid>
        <!-- Réparer Windows avec DISM puis sfc, dans une console visible (UAC de Windows).
             Même gabarit que la carte BCD : rien de nouveau visuellement. -->
        <Grid Margin="0,18,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
              Visibility="{Binding ReparationVisible, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <effets:NoyauDeMaintien Style="{StaticResource CapsuleDeCorrection}" VerticalAlignment="Top"
                                    Command="{Binding LancerReparationCommand}" ToolTip="{Binding InfoOperationEnCours}" ToolTipService.ShowOnDisabled="True" Content="{Binding LabelCapsuleReparation}"
                                    IsEnabled="{Binding ReparationAOuvrir}"
                                    AutomationProperties.Name="{Binding LabelReparationTitre}"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelReparationTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LabelReparationDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LabelReparationMaintenir}" effets:ConsigneAuSurvol.Actif="True" Style="{StaticResource Discret}" Margin="0,10,0,0"
                           Visibility="{Binding ReparationAOuvrir, Converter={StaticResource BoolVis}}"/>
                <Border CornerRadius="10" Padding="10,3" BorderThickness="1" Margin="0,10,0,0" HorizontalAlignment="Left"
                        Background="{StaticResource EtatRienDouxBrush}" BorderBrush="{StaticResource EtatRienFiletBrush}"
                        Visibility="{Binding ReparationLancee, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding EtatReparation}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatRienBrush}" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="{Binding ErreurReparation}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurReparation, Converter={StaticResource StrVis}}"/>
            </StackPanel>
        </Grid>
        <!-- La pause du maintien du service de démarrage : seulement s'il est installé. Un geste qui se
             reprend par le même bouton, d'où un bouton simple ; l'état affiché est relu après le geste. -->
        <StackPanel Margin="0,18,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                    Visibility="{Binding PauseMaintienVisible, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding LabelPauseMaintienTitre}" Style="{StaticResource Corps}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding LabelPauseMaintienDescription}" Style="{StaticResource Legende}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding LabelPauseMaintienEtat}" Style="{StaticResource Discret}" Margin="0,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding PauseMaintienEtatVisible, Converter={StaticResource BoolVis}}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{Binding LabelPauseMaintienBascule}" Style="{StaticResource BoutonReflet}"
                        Command="{Binding BasculerPauseMaintienCommand}"/>
                <Button Content="{Binding LabelPauseMaintienRetirer}" Style="{StaticResource Lien}" Margin="14,0,0,0" VerticalAlignment="Center"
                        Command="{Binding RetirerPauseMaintienCommand}"
                        Visibility="{Binding PauseIncertaine, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            <TextBlock Text="{Binding ErreurPauseMaintien}" Style="{StaticResource Legende}" Foreground="{StaticResource EtatCorrigerBrush}"
                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding ErreurPauseMaintien, Converter={StaticResource StrVis}}"/>
        </StackPanel>
    </StackPanel>
    </StackPanel>

</UserControl>
