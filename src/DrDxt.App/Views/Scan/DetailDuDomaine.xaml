<!-- Le détail du domaine choisi dans la carte de la machine. -->
<UserControl x:Class="DrDxt.App.Views.Scan.DetailDuDomaine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DrDxt.App.ViewModels"
             xmlns:conv="clr-namespace:DrDxt.App.Converters"
             xmlns:effets="clr-namespace:DrDxt.App.Effets"
             xmlns:views="clr-namespace:DrDxt.App.Views"
             xmlns:scan="clr-namespace:DrDxt.App.Views.Scan"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DomaineMachine}">

    <UserControl.Resources>
        <ResourceDictionary Source="Ressources.xaml"/>
    </UserControl.Resources>

    <StackPanel effets:Revelation.Active="True">
        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding Nom}" Style="{StaticResource TitreMarque}" FontSize="26" LineHeight="32"/>
                <TextBlock Text="{Binding Composant}" Style="{StaticResource Discret}" Margin="0,6,0,0"
                           Visibility="{Binding AUnComposant, Converter={StaticResource BoolVis}}"/>
                <!-- La phrase qui dit quoi faire, avant les listes. -->
                <TextBlock Text="{Binding VerdictAffiche}" Style="{StaticResource Corps}" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" Margin="0,12,0,0"
                           Visibility="{Binding VerdictAffiche, Converter={StaticResource StrVis}}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding DataContext.LabelCarteVide, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                   Style="{StaticResource Discret}" Margin="0,22,0,0"
                   Visibility="{Binding EstVide, Converter={StaticResource BoolVis}}"/>

        <!-- Ce qui bride le processeur en jeu, en clair, hors de « Pourquoi ? ».
             Ni bouton ni conseil : le réglage est dans le BIOS. -->
        <StackPanel Margin="0,20,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Cle}" Value="processeur"/>
                                <Condition Binding="{Binding DataContext.ALimiteDePuissance, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="{Binding DataContext.LabelLimiteTitre, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                       Style="{StaticResource TitreSection}" FontSize="13"/>
            <!-- La première phrase à l'écran, le réglage, le risque et le retour arrière sous « Pourquoi ? ». -->
            <!-- Le « ? » au bout de la ligne qu'il explique, partout. -->
            <DockPanel LastChildFill="True">
                <ToggleButton x:Name="PourquoiBride" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=views:ScanView}}" DockPanel.Dock="Right" Margin="10,11,0,0" VerticalAlignment="Top"/>
                <TextBlock Text="{Binding DataContext.LimitePremiereLigne, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                       Style="{StaticResource Corps}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding DataContext.LignesLimiteSuite, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Margin="0,8,0,0"
                          Visibility="{Binding IsChecked, ElementName=PourquoiBride, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Corps}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Mesuré -->
        <StackPanel Margin="0,24,0,0" Visibility="{Binding ADesMesures, Converter={StaticResource BoolVis}}">
            <!-- Les états lus pour information se replient : ouverts d'office, ils passaient avant les constats. -->
            <ToggleButton x:Name="DepliantMesures" Style="{StaticResource Depliant}"
                          Content="{Binding DataContext.LabelCarteMesures, RelativeSource={RelativeSource AncestorType=views:ScanView}}"/>
            <StackPanel Visibility="{Binding IsChecked, ElementName=DepliantMesures, Converter={StaticResource BoolVis}}">
            <ItemsControl x:Name="ListeMesures" ItemsSource="{Binding MesuresVisibles}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Style.Triggers>
                                        <!-- Sous-titre de famille : de l'air avant, peu après. -->
                                        <DataTrigger Binding="{Binding EstTitre}" Value="True">
                                            <Setter Property="Margin" Value="0,10,0,6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Sous une ligne lue « pour information », « Pourquoi ? » prenait une ligne entière
                                 à chaque fois (six liens cyan identiques sur Processeur) et se lisait avant les valeurs. Un « ? » discret en fin
                                 de ligne ouvre la même suite ; son nom complet reste pour le lecteur d'écran et l'infobulle. -->
                            <ToggleButton x:Name="PourquoiMesure" Style="{StaticResource BoutonPourquoi}" AutomationProperties.Name="{Binding DataContext.LabelPourquoi, RelativeSource={RelativeSource AncestorType=views:ScanView}}" Grid.Row="0" Grid.Column="2" Margin="10,1,0,0" VerticalAlignment="Top" Visibility="{Binding ASuite, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Suite}" Style="{StaticResource Discret}" Margin="0,4,0,0"
                                       Visibility="{Binding IsChecked, ElementName=PourquoiMesure, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="{Binding TexteCourt}" ToolTip="{Binding Explication}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Corps}">
                                        <Setter Property="Grid.Column" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EstTitre}" Value="True">
                                                <Setter Property="FontFamily" Value="{StaticResource MarqueDemiFont}"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaireBrush}"/>
                                            </DataTrigger>
                                            <!-- En-tête « N états lus » : il annonce toute la liste, donc pleine largeur, sans
                                                 puce, en texte courant atténué ; les familles gardent leur titre en retrait. -->
                                            <DataTrigger Binding="{Binding EstEntete}" Value="True">
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                <Setter Property="Foreground" Value="{StaticResource TexteSecondaireBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Au-delà de huit lignes, la suite se déplie (le BIOS en faisait dix-neuf). -->
            <StackPanel Visibility="{Binding ADesMesuresRepliees, Converter={StaticResource BoolVis}}">
                <ToggleButton x:Name="VoirMesures" HorizontalAlignment="Left" Cursor="Hand"
                              Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                              FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold">
                    <ToggleButton.Content>
                        <TextBlock>
                            <Run Text="{Binding DataContext.LabelVoirLesAutres, RelativeSource={RelativeSource AncestorType=views:ScanView}, Mode=OneWay}"/><Run Text="{Binding NombreDeLignesRepliees, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </ToggleButton.Content>
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding MesuresRepliees}" ItemTemplate="{Binding ItemTemplate, ElementName=ListeMesures}"
                              Margin="0,10,0,0" Visibility="{Binding IsChecked, ElementName=VoirMesures, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
            </StackPanel>
        </StackPanel>
        <!-- Détails techniques : l'information d'expert sans problème ni geste, repliée par défaut, comptée
             dans son titre ; dépliée ou non, gardé d'un lancement à l'autre. -->
        <Expander Margin="0,20,0,0" Visibility="{Binding ADesDetails, Converter={StaticResource BoolVis}}"
                  IsExpanded="{Binding DataContext.DetailsTechniquesDeplies, RelativeSource={RelativeSource AncestorType=views:ScanView}, Mode=TwoWay}"
                  AutomationProperties.Name="{Binding TitreDesDetails}">
            <Expander.Header>
                <TextBlock Text="{Binding TitreDesDetails}" Style="{StaticResource TitreSection}" FontSize="13"/>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{Binding ItemTemplate, ElementName=ListeMesures}" Margin="0,10,0,0"/>
        </Expander>

        <!-- Constaté -->
        <StackPanel Margin="0,20,0,0" Visibility="{Binding ADesLignes, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding DataContext.LabelCarteConstats, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                       Style="{StaticResource TitreSection}" FontSize="13"/>
            <ItemsControl ItemsSource="{Binding GroupesVisibles}" Margin="0,10,0,0"
                          ItemTemplate="{StaticResource GroupeDeConstats}"/>
            <!-- Au-delà de quatre constats, les trois plus graves d'abord, la suite se déplie. -->
            <StackPanel Visibility="{Binding ADesLignesRepliees, Converter={StaticResource BoolVis}}" Margin="0,6,0,0">
                <ToggleButton x:Name="VoirConstats" HorizontalAlignment="Left" Cursor="Hand"
                              Foreground="{StaticResource IrisCyanBrush}" FocusVisualStyle="{StaticResource FocusIris}"
                              FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold">
                    <ToggleButton.Content>
                        <TextBlock>
                            <Run Text="{Binding DataContext.LabelVoirLesAutres, RelativeSource={RelativeSource AncestorType=views:ScanView}, Mode=OneWay}"/><Run Text="{Binding LignesRepliees.Count, Mode=OneWay}"/><Run Text=")"/>
                        </TextBlock>
                    </ToggleButton.Content>
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Padding="0,2"><ContentPresenter/></Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding GroupesReplies}" ItemTemplate="{StaticResource GroupeDeConstats}"
                              Margin="0,10,0,0" Visibility="{Binding IsChecked, ElementName=VoirConstats, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
        </StackPanel>

        <scan:GestesDuDomaine/>

        <!-- Proposé : ce que DrDXT réglerait. Rangé à part : sous « Constaté »,
             « VRR + modèle flip activés » se lisait comme un état de la machine. -->
        <StackPanel Margin="0,20,0,0" Visibility="{Binding ADesProposes, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding DataContext.LabelCarteProposes, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                       Style="{StaticResource TitreSection}" FontSize="13"/>
            <ItemsControl ItemsSource="{Binding Proposes}" Margin="0,10,0,0"
                          ItemTemplate="{StaticResource LigneDeCarte}"/>
        </StackPanel>

        <!-- Ce que DrDXT fait sur cette page, levier par levier. Replié ; le statut et, s'il n'est
             pas pour ce matériel, la raison. Fin de la navigation à l'aveugle. -->
        <Expander Margin="0,20,0,0" IsExpanded="False" Visibility="{Binding ADesLeviers, Converter={StaticResource BoolVis}}"
                  AutomationProperties.Name="{Binding DataContext.LabelCarteLeviers, RelativeSource={RelativeSource AncestorType=views:ScanView}}">
            <Expander.Header>
                <TextBlock Text="{Binding DataContext.LabelCarteLeviers, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                           Style="{StaticResource TitreSection}" FontSize="13"/>
            </Expander.Header>
            <ItemsControl ItemsSource="{Binding Leviers}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Corps}" TextWrapping="Wrap">
                                <Run Text="{Binding Nom, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" — "/><Run Text="{Binding Statut, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Raison}" Style="{StaticResource Legende}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding ARaison, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>
        <!-- Ce qui se fait à la main (BIOS, câbles, jeu), étape par étape, sur le dépôt. -->
        <Button Content="{Binding DataContext.LabelGuide, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                Command="{Binding DataContext.OuvrirGuideCommand, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                Style="{StaticResource BoutonReflet}" HorizontalAlignment="Left" Margin="0,12,0,0"/>

        <!-- Pas pu lire : un angle mort se dit, il ne passe jamais pour sain. -->
        <StackPanel Margin="0,20,0,0" Visibility="{Binding ADesNonLus, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding DataContext.LabelCarteNonLus, RelativeSource={RelativeSource AncestorType=views:ScanView}}"
                       Style="{StaticResource TitreSection}" FontSize="13" Foreground="{StaticResource EtatNonLuBrush}"/>
            <ItemsControl ItemsSource="{Binding NonLus}" Margin="0,10,0,0" ItemTemplate="{StaticResource LigneNonLue}"/>
        </StackPanel>

    </StackPanel>

</UserControl>
