<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Frontières des sondes liées à l'OS (confinées à ce projet ; le Reconciler pur
         ne les référence jamais). Lectures du registre via Microsoft.Win32.Registry ; démarrage /
         état des services via System.ServiceProcess.ServiceController ; le plan d'alimentation actif
         via un P/Invoke de powrprof.dll. WMI est repris de l'IWmiQuery de DrDxt.Detection. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrDxt.Core\DrDxt.Core.csproj" />
    <ProjectReference Include="..\DrDxt.Reconciler\DrDxt.Reconciler.csproj" />
    <!-- Reprendre la couture de lecture WMI existante (IWmiQuery / ManagementWmiQuery). -->
    <ProjectReference Include="..\DrDxt.Detection\DrDxt.Detection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Accès réservé aux tests aux coutures internes de lecture brute (TDD : aiguillage + sérialisation
         entièrement testés avec des faux ; seuls les vrais lecteurs minces sont des bords non testés). -->
    <InternalsVisibleTo Include="DrDxt.Reconciler.Adapters.Tests" />
  </ItemGroup>

</Project>
