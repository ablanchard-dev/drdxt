<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrDxt.Core\DrDxt.Core.csproj" />
    <!-- DI extension (AddDrDxtBios) for the guide library + generator. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Curated, signed-in-spirit guide knowledge base (validated at load by
         GuideTemplateValidator). Resource id: DrDxt.Bios.data.guides.json -->
    <EmbeddedResource Include="data\guides.json" />
  </ItemGroup>

</Project>
