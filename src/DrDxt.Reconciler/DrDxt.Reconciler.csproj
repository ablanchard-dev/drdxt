<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrDxt.Core\DrDxt.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Accès réservé aux tests aux aides internes de canonicalisation (TDD). -->
    <InternalsVisibleTo Include="DrDxt.Reconciler.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ed25519 retenu par le projet. Utilisé seulement par le vrai
         Ed25519SignatureScheme ; toute la logique est derrière la couture ISignatureScheme, pour que
         les tests unitaires utilisent un faux en mémoire et ne touchent jamais la libsodium native. -->
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <!-- La cle de signature de la machine, protegee au repos par DPAPI portee machine. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

</Project>
