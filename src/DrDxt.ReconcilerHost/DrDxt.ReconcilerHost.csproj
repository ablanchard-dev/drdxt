<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Même règle que l'App et le helper, aucun code injecté au lancement. -->
    <StartupHookSupport>false</StartupHookSupport>
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hôte générique empaqueté en service Windows (UseWindowsService). Toute la vraie
         logique vit dans des classes testées ; Program/Worker sont une coquille mince. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DrDxt.Core\DrDxt.Core.csproj" />
    <ProjectReference Include="..\DrDxt.Reconciler\DrDxt.Reconciler.csproj" />
    <ProjectReference Include="..\DrDxt.Reconciler.Adapters\DrDxt.Reconciler.Adapters.csproj" />
    <!-- IWmiQuery / ManagementWmiQuery de Detection : la couture de lecture WMI nue dont a besoin
         le WmiGpuDriverProbe du réconciliateur (pas tout le graphe d'analyse de Detection). -->
    <ProjectReference Include="..\DrDxt.Detection\DrDxt.Detection.csproj" />
    <ProjectReference Include="..\DrDxt.Infrastructure\DrDxt.Infrastructure.csproj" />
    <!-- Les types du helper : le service exécute les ops dans son propre processus (SYSTEM), par l'exécuteur du
         helper derrière la même liste blanche, sans tube. -->
    <ProjectReference Include="..\DrDxt.ElevatedHelper\DrDxt.ElevatedHelper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Accès réservé aux tests aux classes internes testables de l'hôte (TDD : le worker est
         une coquille mince ; la logique est dans ces classes, exercées avec des faux). -->
    <InternalsVisibleTo Include="DrDxt.ReconcilerHost.Tests" />
  </ItemGroup>

</Project>
