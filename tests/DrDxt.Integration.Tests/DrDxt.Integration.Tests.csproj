<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gate runs the REAL engine + REAL safety manager + REAL catalog of REAL
         tweaks against an in-memory fake system state. Only Application + Core. -->
    <ProjectReference Include="..\..\src\DrDxt.Application\DrDxt.Application.csproj" />
    <!-- End-to-end reconcile: the REAL reconciler + REAL probe/mapper (Adapters)
         + the REAL R1 registry write leaf (Win32RegistryActions, ElevatedHelper),
         exercised against a real, isolated HKCU test key (no elevation, self-cleaning). -->
    <ProjectReference Include="..\..\src\DrDxt.Reconciler\DrDxt.Reconciler.csproj" />
    <ProjectReference Include="..\..\src\DrDxt.Reconciler.Adapters\DrDxt.Reconciler.Adapters.csproj" />
    <ProjectReference Include="..\..\src\DrDxt.ElevatedHelper\DrDxt.ElevatedHelper.csproj" />
    <!-- Le manifeste de la désinstallation (AppliedTweakManifestMapper) vit dans l'App : les invariants le relisent sur
         tous les leviers du banc. -->
    <ProjectReference Include="..\..\src\DrDxt.App\DrDxt.App.csproj" />
    <Compile Include="..\Shared\AdminRequis.cs" Link="Shared\AdminRequis.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
